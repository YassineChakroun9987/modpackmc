{
	chapter.0BE88C7C7C3B7C37.chapter_subtitle: [
		"Vein mining, crystal caves and every ore the pack adds."
	]
	chapter.0BE88C7C7C3B7C37.title: "&aStone and Ore"
	chapter.0C55F0E22C6E1DF6.chapter_subtitle: [
		"First dungeons, first spells, and the seven lights."
	]
	chapter.0C55F0E22C6E1DF6.title: "&6Act I: Proving Ground"
	chapter.1DC86E2DE0D0A961.chapter_subtitle: [
		"Frostbinder. Winter keeps what it loves."
	]
	chapter.1DC86E2DE0D0A961.title: "&bThe Blue Light: Path of Winter"
	chapter.215A4BF6B499A425.chapter_subtitle: [
		"Applied Energistics 2: from a fallen meteorite to your first ME network and autocrafting."
	]
	chapter.215A4BF6B499A425.title: "&aThe Storage Network"
	chapter.2385F05A67BDB086.chapter_subtitle: [
		"Iron's Spells 'n Spellbooks: books, ink, scrolls, orbs, schools and addons."
	]
	chapter.2385F05A67BDB086.title: "&aThe Arcane Path"
	chapter.2396F1933449B02E.chapter_subtitle: [
		"Mekanism: power, steel, ore that multiplies, and the MekaSuit."
	]
	chapter.2396F1933449B02E.title: "&aThe Machine Age"
	chapter.25C9E1DA124149D9.chapter_subtitle: [
		"Maps, waystones, villages, dungeons and castles in the sky."
	]
	chapter.25C9E1DA124149D9.title: "&aThe Wide World"
	chapter.285A2D542A50A78A.chapter_subtitle: [
		"Weapons, shields, trinkets, backpacks, and what happens when you fall."
	]
	chapter.285A2D542A50A78A.title: "&aArms and Armour"
	chapter.28A59981325A1CB2.chapter_subtitle: [
		"Voidblade. The void doesn't see you coming. Neither will they."
	]
	chapter.28A59981325A1CB2.title: "&5The Violet Light: Path of the Void"
	chapter.31A35132B0A83FDA.chapter_subtitle: [
		"Wildheart. No beast fights alone."
	]
	chapter.31A35132B0A83FDA.title: "&9The Indigo Light: Path of the Pack"
	chapter.333D40E0C1E96C4C.chapter_subtitle: [
		"Bloodfire Berserker. The closer to death, the harder you hit."
	]
	chapter.333D40E0C1E96C4C.title: "&cThe Red Light: Path of Rage"
	chapter.3596142607514ADB.chapter_subtitle: [
		"Every ring-bearer, every colour, against the god-eater."
	]
	chapter.3596142607514ADB.title: "&6The Last Light"
	chapter.3F4F394AF93D61A8.chapter_subtitle: [
		"Create from the first water wheel to trains, plus electric power from Crafts & Additions."
	]
	chapter.3F4F394AF93D61A8.title: "&aGears of Progress"
	chapter.4527C4BD528936CB.chapter_subtitle: [
		"Alex's Mobs, Mowzie's Mobs, mutants, odd allies, pets and guards."
	]
	chapter.4527C4BD528936CB.title: "&aBeasts and Companions"
	chapter.4BEDFE198D70D928.chapter_subtitle: [
		"Hoardwarden. Mine."
	]
	chapter.4BEDFE198D70D928.title: "&6The Orange Light: Path of the Mountain"
	chapter.5804C1EAB3718207.chapter_subtitle: [
		"Lightwarden. In brightest day, in blackest night."
	]
	chapter.5804C1EAB3718207.title: "&aThe Green Light: Path of the Shield"
	chapter.5D38886831F6A98D.chapter_subtitle: [
		"Stormwright. Faster than thunder, brighter than lightning."
	]
	chapter.5D38886831F6A98D.title: "&eThe Yellow Light: Path of the Storm"
	chapter.62D9FF6B4F2A3FC9.chapter_subtitle: [
		"Chests that grow, sort themselves and answer to one desk."
	]
	chapter.62D9FF6B4F2A3FC9.title: "&aThe Quartermaster's Ledger"
	chapter.64793592AA5F9802.chapter_subtitle: [
		"Apotheosis: rarity, gems, reforging, world tiers, enchanting and spawners."
	]
	chapter.64793592AA5F9802.title: "&aAffixes and Arcana"
	chapter.66EE8501CF4A1211.chapter_subtitle: [
		"Draconium to Wyvern to Draconic to Chaotic: the strongest tech in the pack."
	]
	chapter.66EE8501CF4A1211.title: "&aDraconic Evolution"
	chapter.70D6C90341B78CDE.chapter_subtitle: [
		"Ice and Fire's dragons and myths, and the dragons of Berk you can bond with."
	]
	chapter.70D6C90341B78CDE.title: "&aHere Be Dragons"
	chapter.733867A136D8EB69.chapter_subtitle: [
		"Create Aeronautics airships, and the rings, lanterns and worlds of the Lantern Corps."
	]
	chapter.733867A136D8EB69.title: "&aSky, Ships and Lanterns"
	chapter.74E5CFD46C340A23.chapter_subtitle: [
		"A realm of endless dusk, and the boss order that unlocks it."
	]
	chapter.74E5CFD46C340A23.title: "&aThe Twilight Forest"
	chapter.76E59FB57D0DEF7F.chapter_subtitle: [
		"Keys, tools and friends: what makes the long road easier."
	]
	chapter.76E59FB57D0DEF7F.title: "&aHow to Play This Pack"
	chapter.775D58DA24E4D109.chapter_subtitle: [
		"Every great monster in the pack, from first blood to the extreme."
	]
	chapter.775D58DA24E4D109.title: "&aThe Bestiary of Ruin"
	chapter.7A48A5C74985F285.chapter_subtitle: [
		"A horn on the ridge. Seven days until the Warband comes."
	]
	chapter.7A48A5C74985F285.title: "&6Prologue: The Seventh Dawn"
	chapter.7B21E6A07E57D285.chapter_subtitle: [
		"Farmer's Delight: crops, the cooking pot and feasts for the party."
	]
	chapter.7B21E6A07E57D285.title: "&aHearth and Harvest"
	chapter_group.11FA4EDFEFF5B78D.title: "&bThe Seven Lights"
	chapter_group.151E3065A6314194.title: "&6The Story"
	chapter_group.4FA3695F5F82A1E1.title: "&aGuides & Adventures"
	file.0000000000000001.title: "The Book of Oa"
	quest.004968C103D394F1.quest_desc: [
		"The &eSeashelf&r is built from ocean materials. Some shelves can be &einfused&r on the enchanting table itself into stronger versions."
		"Combine Hellshelves and Seashelves to balance your table."
	]
	quest.004968C103D394F1.title: "Shelves of the Sea"
	quest.0083F013DAAC06E2.quest_desc: [
		"The &eUncrafting Table&r takes crafted items apart into their ingredients, for a cost in XP."
		"Optional, and very handy for recovering diamonds from old tools."
	]
	quest.0083F013DAAC06E2.title: "The Uncrafting Table"
	quest.009495AA74519BFE.quest_desc: [
		"&eLevitite&r floats. Attach enough of it to a contraption and the whole thing levitates, no balloon needed."
		"Make &eLevitite Blend&r and let it crystallize into Levitite (Ponder the blend to see how). The rarer Pearlescent Levitite is waiting to be discovered."
	]
	quest.009495AA74519BFE.title: "Unidentified Floating Object"
	quest.0098A1286BF9C5FD.quest_desc: [
		"Beyond the highlands, a castle at the edge of the Twilight. Its master is not home. Something else is."
		""
		"Reach the &eFinal Castle&r on the Final Plateau. The Twilight's road ends here."
	]
	quest.0098A1286BF9C5FD.title: "The Final Plateau"
	quest.015C903C3CB678E2.quest_desc: [
		"Bells ring under the earth. A king who should be dead is holding court."
		""
		"Find and enter Iron's &eCatacombs&r, a vast underground crypt."
	]
	quest.015C903C3CB678E2.title: "The Catacombs"
	quest.015CCA309D0AEC3F.quest_desc: [
		"The Netherite Monstrosity hammers anything that enters its forge into scrap."
		""
		"Kill the &eNetherite Monstrosity&r in the Soul Black Smith. It is slow but its lava waves hurt; keep moving. A party helps a lot."
	]
	quest.015CCA309D0AEC3F.title: "The Blacksmith's Wrath"
	quest.017ADBB5FF842334.quest_desc: [
		"A false Sentinel, spun from the energy of a slain god. It sings like the Storm Weaver."
		""
		"Craft the &eCosmic Worm&r (soul fragment + chaos shard, see JEI). Use it under an &eopen sky&r; if it wiggles and refuses, you are in the wrong dimension."
	]
	quest.017ADBB5FF842334.title: "The Cosmic Worm"
	quest.01A9DCBB5C1F433A.quest_desc: [
		"A balloon drifts. A plane goes where you point it."
		""
		"Craft a &ePropeller Bearing&r, a &eWooden Propeller&r and a &eSteering Wheel&r, and build a craft that flies under its own power."
	]
	quest.01A9DCBB5C1F433A.title: "Propeller"
	quest.01AEA88B2B09DEC1.quest_desc: [
		"Not every monster has to stay one."
		""
		"Cure a zombie villager: hit it with a &eSplash Potion of Weakness&r, then feed it a &egolden apple&r and keep it safe until it shakes off the curse."
	]
	quest.01AEA88B2B09DEC1.title: "Mercy"
	quest.02361E7320E1F9FC.quest_desc: [
		"The village smith has finally shown you how real armor is riveted."
		""
		"Craft any one &eEpic Knights&r chest piece below. Steel comes from the smith's recipes (see JEI)."
	]
	quest.02361E7320E1F9FC.title: "Steel and Mail"
	quest.02374E2D16A15D80.quest_desc: [
		"Atop the &eAurora Palace&r on the Glacier, the &eSnow Queen&r shields herself with orbiting ice crystals and drops blizzards on you."
		"Frostbinders will feel at home. Everyone else: break the crystals, then strike while she's exposed."
	]
	quest.02374E2D16A15D80.title: "IV-c. The Snow Queen"
	quest.026303C6D76AC6B0.quest_desc: [
		"A ring found you. Violet, White or Black, you are a &eLantern&r now: you can fly, and your will takes shape as constructs."
		""
		"This completes when this light's trial gives you your ring: its own colour, White or Black. The Violet path continues; the &6Last Light&r chapter has opened."
	]
	quest.026303C6D76AC6B0.quest_subtitle: "Ring-bearer"
	quest.026303C6D76AC6B0.title: "&5Ring-Bearer"
	quest.026671933107AB82.quest_desc: [
		"The best armor money, science and an unreasonable amount of power can build."
		""
		"Build the full &eMekaSuit&r (Mekanism): helmet, bodyarmor, pants and boots. Add modules at a Modification Station."
	]
	quest.026671933107AB82.title: "MekaSuit"
	quest.02896C09001ED155.quest_desc: [
		"A little bone token that makes the dark forget you."
		""
		"Craft or find a &eCharm of Stealth&r (Born in Chaos)."
	]
	quest.02896C09001ED155.title: "Charm of Stealth"
	quest.02B017B1537701A1.quest_desc: [
		"On a throne of bone in the Catacombs, a crowned corpse opens its eyes. His court rises with him."
		""
		"Defeat the &eDead King&r deep in Iron's Catacombs (disturb his corpse on the throne). Holy spells and fire hurt him. Party members within 64 blocks get the trial credit too."
	]
	quest.02B017B1537701A1.quest_subtitle: "Ring trial: the boss"
	quest.02B017B1537701A1.title: "&aThe Dead King"
	quest.02BED42B5DAD5EC4.quest_desc: [
		"Enchant an item at &elevel 100&r. Vanilla stops at 30; Apothic Enchanting lets enchantments go far past their normal maximum."
		"This is what Pinnacle gear is made of."
	]
	quest.02BED42B5DAD5EC4.title: "Level One Hundred"
	quest.02FBB44028B65E3A.quest_desc: [
		"The &eDraconic Chestpiece&r: a far bigger shield, more module space, and creative-style flight with the right module."
		"You are now one of the strongest people in this world. The corruption has noticed."
	]
	quest.02FBB44028B65E3A.title: "Draconic Armour"
	quest.03008D8E8269E03C.quest_desc: [
		"When the Devourer fell, it was Red who struck first and hardest. The bards will exaggerate. They won't need to."
		""
		"Complete the Last Light and the Red path. Thank you for burning so bright."
	]
	quest.03008D8E8269E03C.quest_subtitle: "After the Last Light"
	quest.03008D8E8269E03C.title: "&cLegend of the Red Light"
	quest.033F5D992E0D6C86.quest_desc: [
		"Some meals are too big for one person. &eFeasts&r (Roast Chicken, Stuffed Pumpkin, Honey Glazed Ham, Shepherd's Pie) are placed as blocks."
		"Right-click a feast with a bowl to serve a portion. One feast feeds the whole party before a boss fight."
	]
	quest.033F5D992E0D6C86.title: "A Feast for the Party"
	quest.0360619A187284E4.quest_desc: [
		"You dream of a green world beneath a vast lantern, and of a battery the size of a mountain humming with will."
		""
		"Reach &eGreen level 25&r. Then the trial."
	]
	quest.0360619A187284E4.quest_subtitle: "Class level 25"
	quest.0360619A187284E4.title: "The Dream"
	quest.0427BF9BA26E3E1F.quest_desc: [
		"Blue walks where breath turns to frost and the sky is close."
		""
		"Optional: visit a frozen biome (snowy plains, ice spikes, a glacier, frozen peaks...)."
	]
	quest.0427BF9BA26E3E1F.title: "A Taste of Winter"
	quest.04AD09DB0F41B7E4.quest_desc: [
		"In the End, there are islands where even light is afraid to go."
		""
		"Cross Nullscape's &eShadowlands&r and &eVoid Barrens&r in the outer End."
	]
	quest.04AD09DB0F41B7E4.title: "The Void Walk"
	quest.05596818822FF681.quest_desc: [
		"A lumpy dragon that eats rocks and spits lava. A Hoardwarden's kind of beast."
		""
		"Find a &eBook of Dragons&r roost, climb onto a wild dragon and hold on until it stops bucking: then it's yours. A &eGronckle&r suits you best; the Book of Dragons explains each species."
	]
	quest.05596818822FF681.title: "Rock-Eater"
	quest.0563B30B29298DAE.quest_desc: [
		"The light hums whenever you hold ore. It wants more."
		""
		"Mine &e64 raw iron&r and &e16 raw gold&r. With &eFTB Ultimine&r, hold its key (see Controls) to dig a whole vein at once. Ores give Orange lots of XP."
	]
	quest.0563B30B29298DAE.title: "Shiny"
	quest.056E172D848CAC7B.quest_desc: [
		"The &eWyvern Chestpiece&r gives you an energy &eshield&r that soaks up damage before your health does, and it recharges."
		"Charge it from your energy network before every fight."
	]
	quest.056E172D848CAC7B.title: "The Wyvern Chestpiece"
	quest.05B5D8418D6E840F.quest_desc: [
		"Deep in the factory, a war machine of the old empire boots up and speaks in a voice like grinding gears."
		""
		"Kill &eThe Harbinger&r in the Ancient Factory (Cataclysm). It fires lasers and missiles; use cover and close in. Party members within 64 blocks get the trial credit too."
	]
	quest.05B5D8418D6E840F.quest_subtitle: "Ring trial: the boss"
	quest.05B5D8418D6E840F.title: "&eThe Iron Prophet"
	quest.05DAF5E0885C122A.quest_desc: [
		"Enchanting runs deeper here: bookshelves of many kinds shape what the table offers."
		""
		"Enchant an item. &eApotheosis&r reworks enchanting: hover over the table's stats and try special shelves later."
	]
	quest.05DAF5E0885C122A.title: "Apothic Arts"
	quest.065D592CD50DD4BA.quest_desc: [
		"A familiar is a friend who casts spells."
		""
		"Tame any &efamiliar&r (Alshanex's Familiars): hunter, druid, mage, cleric, summoner and more. The Familiar Guide explains how."
	]
	quest.065D592CD50DD4BA.title: "First Familiar"
	quest.066AF9A85D057201.quest_desc: [
		"The Castle in the Sky: coloured keys, locked doors, and a crystal at its heart."
		""
		"Find the &eCastle in the Sky&r (very far from spawn) and conquer it. Collect the keys; take the whole party."
	]
	quest.066AF9A85D057201.title: "Laputa"
	quest.0674181C1345655C.quest_desc: [
		"Mix &ecopper&r and &ezinc&r in a heated basin to make &eBrass&r, Create's second-tier metal. Brass casing makes the smarter machines (brass funnels, tunnels, arms, crafters)."
		"Yellow Stormwrights: brass is your bread and butter."
	]
	quest.0674181C1345655C.title: "Brass"
	quest.067775E997069BA2.quest_desc: [
		"Mithril from deep in the deepslate turns into scrap, ingots, then &eMithril Weave&r, which goes into the strongest robes (Netherite Battlemage)."
		"See the Mining chapter for where to find it."
	]
	quest.067775E997069BA2.title: "Mithril Weave"
	quest.068B7FCC51EA685B.quest_desc: [
		"The Hydra rises from the bog: nine heads, nine hungers, and every one of them in pain."
		""
		"Kill the &eHydra&r in its swamp cave (Ice and Fire). Its heads grow back, so focus them down together; your beasts and summons can keep the others busy. Party members within 64 blocks get the trial credit too."
	]
	quest.068B7FCC51EA685B.quest_subtitle: "Ring trial: the boss"
	quest.068B7FCC51EA685B.title: "&9The Many Heads"
	quest.06F53B5296693236.quest_desc: [
		"A lit village sleeps. A dark one bleeds."
		""
		"Craft &e16 lanterns&r and light up a village you protect."
	]
	quest.06F53B5296693236.title: "Watchman"
	quest.070D911CA99F9EEB.quest_desc: [
		"Raiders love the dark lanes between houses. Take them away."
		""
		"Gather &e32 torches&r and light the village streets and walls. Lit ground also stops monsters spawning inside."
	]
	quest.070D911CA99F9EEB.title: "Walls and Watchfires"
	quest.08083C7DDD91A88D.quest_desc: [
		"Most Draconic items are made by &eFusion Crafting&r. Place a &eFusion Crafting Core&r and set &eCrafting Injectors&r around it, facing the core."
		"Put the main item in the core and the ingredients in the injectors, power the injectors, and start the fusion. JEI shows each fusion recipe and the injector tier it needs."
	]
	quest.08083C7DDD91A88D.title: "Fusion Crafting"
	quest.0817391B0B3EFE3A.quest_desc: [
		"Dragons need a home they can return to."
		""
		"Craft a &eDragon Roost&r (Book of Dragons) for your dragons."
	]
	quest.0817391B0B3EFE3A.title: "A Roost of Your Own"
	quest.0823402DEDD943B3.quest_desc: [
		"Will, poured into steel."
		""
		"Craft a &eHoly Upgrade Orb&r and an &eEvocation Upgrade Orb&r; apply them at the Arcane Anvil."
	]
	quest.0823402DEDD943B3.title: "Blessed Steel"
	quest.0827D67E16FA41D8.quest_desc: [
		"Umvuthi, the beast-caller, summons his tribe and burns the ground with sunlight."
		""
		"Defeat &eUmvuthi&r in his grove. Kill his followers and stay out of the sunstrikes."
	]
	quest.0827D67E16FA41D8.title: "Sun and Mask"
	quest.0836CA1FEF5713ED.quest_desc: [
		"A &eDiamond Backpack&r holds a small storage room and more upgrade slots. Add a &eMagnet Upgrade&r and loot flies to you after a fight."
		"Stack Upgrades let each slot hold far more than 64. Great for miners."
	]
	quest.0836CA1FEF5713ED.title: "Deep Pockets"
	quest.08FE9EE84BC50BE6.quest_desc: [
		"&o\"In brightest day, in blackest night...\"&r"
		"Green is the light of will: a paladin of sword, shield and evocation magic, who protects villages, wins raids and heals allies."
		""
		"Claim the reward to join Green and unlock its talent tree. You can still join other lights later."
	]
	quest.08FE9EE84BC50BE6.quest_subtitle: "Join this light"
	quest.08FE9EE84BC50BE6.title: "&aThe Lightwarden"
	quest.091321F1D685F52A.quest_desc: [
		"On the darkest nights a rider with a burning head leads the harvest of souls."
		""
		"Kill &eLord Pumpkinhead&r (Born in Chaos). Check JEI and the Born in Chaos advancements for how he is called."
	]
	quest.091321F1D685F52A.title: "The Pumpkin King"
	quest.092F6FDB87644B0C.quest_desc: [
		"Build a spawner with the shortest delays, redstone control, no mob AI, no spawn conditions and no need for players."
		"An endless supply of drops, on a switch. Put it in a claimed chunk."
	]
	quest.092F6FDB87644B0C.title: "The Ultimate Spawner"
	quest.09393ABAFC6EA389.quest_desc: [
		"Sophisticated &eshulker boxes&r take upgrades and tiers too, and you can carry them full. They just can't hold other shulker boxes."
		""
		"You'll need shulker shells from the End."
	]
	quest.09393ABAFC6EA389.title: "Pack It Up"
	quest.0965445B21EB0247.quest_desc: [
		"Other dragons fly here too: Gronckles, Deadly Nadders, Monstrous Nightmares, Skrills, Whispering Deaths, and the Night Fury. These ones can be &ebefriended&r."
		"Find a &eHooligan&r (a travelling Viking) and trade with them for the &eBook of Dragons&r. It records what you learn about each species."
	]
	quest.0965445B21EB0247.quest_subtitle: "Book of Dragons"
	quest.0965445B21EB0247.title: "The Book of Dragons"
	quest.0965892683525B86.quest_desc: [
		"The &eChaotic Chestpiece&r and Chaotic weapons are the peak of Draconic Evolution: the most shield, the most damage, the most modules."
		"Few things in any world can stand against a Chaotic Lantern."
	]
	quest.0965892683525B86.title: "Chaotic"
	quest.0968C69FFEDECD8E.quest_desc: [
		"With &eBetter Combat&r each weapon type has its own combo: keep attacking to chain it. Wide swings hit everything in the arc, thrusts reach further, and the last hit of a combo is often the strongest."
		"Two one-handers can be dual-wielded (one in each hand). Two-handers need an empty off-hand. Use &eCombat Roll&r to dodge out of a boss's swing (search 'roll' in Controls)."
	]
	quest.0968C69FFEDECD8E.quest_subtitle: "Better Combat, in depth"
	quest.0968C69FFEDECD8E.title: "Every Weapon Has a Rhythm"
	quest.096D4EE90DBDF2C5.quest_desc: [
		"A tamed beast deserves a home, and a way back if it falls."
		""
		"Craft a &epet bed&r (Redomesticate). Pets bound to a bed come back to it instead of dying for good."
	]
	quest.096D4EE90DBDF2C5.title: "A Bed by the Fire"
	quest.09B2D9960B6507DF.quest_desc: [
		"The last tier: &8Netherite&r storage, with 132 slots and 5 upgrade slots. Add Stack Upgrades and one chest holds a kingdom's treasury."
		""
		"Make a &eDiamond to Netherite&r tier upgrade."
	]
	quest.09B2D9960B6507DF.title: "The Netherite Vault"
	quest.09F0496E152667BB.quest_desc: [
		"The Devourer's shadow wakes the old Cataclysm bosses. Put them down before they join it."
		""
		"Optional: Kill &eMaledictus&r in the Frosted Prison. Another class's chapter may already have sent you there."
	]
	quest.09F0496E152667BB.title: "The Cursed Warlord"
	quest.09FDB2CADE3A11D0.quest_desc: [
		"A &eStorage Controller&r turns a room of chests into one store."
		""
		"Place it touching your storage. Every storage that touches it, or touches one that does, joins its network, as long as it's within &e15 blocks&r. Open the controller to see and search everything at once; whatever you put in goes where it fits best."
		""
		"&7(It works with your sorting: an item goes first to a storage that already holds it.)"
	]
	quest.09FDB2CADE3A11D0.title: "The Quartermaster's Desk"
	quest.0A18BBAFF3F2E674.quest_desc: [
		"In the End stands a pillar of living obsidian. The &eObsidilith&r sends out shockwaves, raises spikes from the floor and drops anvils."
		"Keep moving, and don't fight it near the edge of an island."
	]
	quest.0A18BBAFF3F2E674.title: "III. The Obsidilith"
	quest.0A2F414F719E975D.quest_desc: [
		"A serpent as long as a ship circles in the open ocean."
		""
		"Kill a &eSea Serpent&r (Ice and Fire) in deep ocean. A boat is a bad idea; fly."
	]
	quest.0A2F414F719E975D.title: "Serpent of the Deep"
	quest.0A326122AA9487F0.quest_desc: [
		"Far out at sea, &eSea Serpents&r hunt in the deep ocean. Their scales make Tide Guardian armour, the best for underwater fighting."
		"The &eHydra&r in its swamp cave is a myth of its own: the Wildheart's trial."
	]
	quest.0A326122AA9487F0.title: "The Sea Serpent"
	quest.0A3F0AB0C4E3B7A4.quest_desc: [
		"The &eSunken City&r lies at the bottom of the sea, and the &eLeviathan&r rules it. Fight underwater: Water Breathing, Respiration, and a Tide Guardian or Conduit if you have one."
		"Lantern rings keep you breathing while lit."
	]
	quest.0A3F0AB0C4E3B7A4.title: "III. The Leviathan"
	quest.0A50BE76CAC54284.quest_desc: [
		"The Ogre King rises from his throne, club in hand, crown askew. He thinks the hoard is his."
		""
		"Kill the &eOgre King&r in his fort (plains or swamp). His guards come first. Party members within 64 blocks get the trial credit too."
	]
	quest.0A50BE76CAC54284.quest_subtitle: "Ring trial: the boss"
	quest.0A50BE76CAC54284.title: "&6Crown of the Ogre King"
	quest.0A9A8A8E44341A20.quest_desc: [
		"Below the hills, an empty suit of armor still guards a treasure no one remembers."
		""
		"Find a Mowzie's &eWrought Chamber&r underground and defeat the &eFerrous Wroughtnaut&r. Hit it only when it's stuck after a swing; its armor shrugs off everything else."
	]
	quest.0A9A8A8E44341A20.title: "The Iron Ghost"
	quest.0AD1E48B85E3BF19.quest_desc: [
		"The &econstruct wheel&r lets you design, copy and summon &econstructs&r: shapes made of your light. A new bearer's construct holds 32 blocks; it grows with your will and with every minute your ring stays lit."
		"Stand on a construct you made and lift it with the grip key to ride it. Engines and burners on a construct run off your ring. Careful: crashing at speed digs a crater, so don't land in a friend's base."
	]
	quest.0AD1E48B85E3BF19.title: "Hard Light"
	quest.0B4B3E38A624E7A3.quest_desc: [
		"Its claws, still dripping."
		""
		"Claim the &eTidal Claws&r."
	]
	quest.0B4B3E38A624E7A3.title: "Tidal Claws"
	quest.0BBF041069F58C98.quest_desc: [
		"Plant &erice&r in a shallow puddle, one block of water deep. It grows up out of the water and gives rice panicles (and straw)."
		"Rice is in many good meals: fried rice, cabbage rolls, stuffed pumpkin."
	]
	quest.0BBF041069F58C98.title: "Rice Paddies"
	quest.0BDC1E4E8CDEE4F8.quest_desc: [
		"Craft &eOrganic Compost&r and place it: it slowly decays into &eRich Soil&r. Crops on Rich Soil farmland grow faster."
		"Plant a red or brown mushroom on Rich Soil and it becomes a &eMushroom Colony&r you can harvest again and again."
	]
	quest.0BDC1E4E8CDEE4F8.title: "Rich Soil"
	quest.0C1EA8A1216376F7.quest_desc: [
		"The smith hands you an apron. 'If you're staying, you're fighting.'"
		""
		"Mine iron, smelt it, and craft an &eiron sword&r and a &eshield&r."
	]
	quest.0C1EA8A1216376F7.title: "Make Ready"
	quest.0C51DAC07EC841CD.quest_desc: [
		"You've faced the wild's worst and made friends with its best. The corruption twists creatures; you've seen what the untouched ones can be."
		"Next: dragons (see the Dragons chapter)."
	]
	quest.0C51DAC07EC841CD.title: "Keeper of Beasts"
	quest.0C6C9E354EF0DC62.quest_desc: [
		"The Lich shatters like a dropped icicle, and a blue light settles on your shoulder like snow."
		"When all seems lost, what do you still believe in?"
		""
		"Claim this reward to begin the &ering trial&r: a conversation in chat. The ring will judge you. Your &eanswers&r decide whether you receive your own light, the &fWhite&r, or the &8Black&r. Answer as who you really are."
		"&7(Only works once you have the trial credit from the quest before.)"
	]
	quest.0C6C9E354EF0DC62.quest_subtitle: "The ring will judge you"
	quest.0C6C9E354EF0DC62.title: "The Ring Judges"
	quest.0C882911171A6261.quest_desc: [
		"The master of the fort casts fangs, vexes and worse."
		""
		"Defeat the &eArchevoker&r in the Evoker Fort. Kill the vexes first; fight as a party."
	]
	quest.0C882911171A6261.title: "The Archevoker"
	quest.0CF6728348EC1FBC.quest_desc: [
		"Two upgrades for miners:"
		"&eCompacting&r turns 9 nuggets into an ingot and 9 ingots into a block, all by itself."
		"&eVoid&r deletes what you tell it to: cobblestone, dirt, netherrack. Perfect next to vein mining."
		""
		"Make either one."
	]
	quest.0CF6728348EC1FBC.title: "Compact the Rubble"
	quest.0D318D653EC14377.quest_desc: [
		"Armor stitched from shadow. It makes no sound."
		""
		"Craft the full &eShadow-Walker&r set (Iron's Spells). It boosts ender spells."
	]
	quest.0D318D653EC14377.title: "The Shadow-Walker"
	quest.0D5ED71601889559.quest_desc: [
		"The light pulls you toward heat, toward the place where the world itself is angry."
		""
		"Build a Nether portal (obsidian frame, light it) and enter &cthe Nether&r. Bring fire resistance potions and a stack of blocks."
	]
	quest.0D5ED71601889559.title: "Into the Inferno"
	quest.0D753D4AFCCB39EF.quest_desc: [
		"Feed a Gronckle the right rocks and it spits out the lightest, toughest metal in the world."
		""
		"Keep your Gronckle fed and collect &e4 Gronckle Iron&r (see the Book of Dragons)."
	]
	quest.0D753D4AFCCB39EF.title: "Gronckle Iron"
	quest.0D862938E32EF795.quest_desc: [
		"Every wall, bow and bed starts with a tree."
		""
		"Punch a tree until it drops logs. Any of the logs below counts: bring &e8&r of one kind."
	]
	quest.0D862938E32EF795.title: "Timber"
	quest.0DA006622CB27A6F.quest_desc: [
		"Circuits follow the alloys: Basic, Advanced, Elite, &eUltimate&r. Ultimate circuits go into the best machines and the MekaSuit."
		"Make one."
	]
	quest.0DA006622CB27A6F.title: "Ultimate Control Circuit"
	quest.0E65854F5D032229.quest_desc: [
		"The pack grows."
		""
		"Breed two animals (feed both their favourite food). Every animal you breed earns Indigo XP."
	]
	quest.0E65854F5D032229.title: "New Life"
	quest.0E848F62A53D2227.quest_desc: [
		"Some knowledge doesn't want to be known. Know it anyway."
		""
		"Find an &eEldritch Manuscript&r and learn an eldritch spell (&eSonic Boom&r, &eSculk Tentacles&r, &ePocket Dimension&r)."
	]
	quest.0E848F62A53D2227.title: "Void Touched"
	quest.0E949DE9DA61EBCE.quest_desc: [
		"A great white ape sleeps in the snow, a crystal of living ice clutched in its fist."
		""
		"Kill the &eFrostmaw&r (Mowzie's Mobs) in snowy lands. Its breath freezes; dodge the ground slams."
	]
	quest.0E949DE9DA61EBCE.title: "The White Beast"
	quest.0F2D874979F10118.quest_desc: [
		"Blood cultists sing to a mother who drinks the strength of her children."
		""
		"Find a &eBlood Cultist Hut&r (Discerning the Eldritch) and kill the &eBlood Matriarch&r. Bring the party: her cultists heal her."
	]
	quest.0F2D874979F10118.title: "Mother of Blood"
	quest.102BADC4951F1256.quest_desc: [
		"Scrolls fade. Ink binds."
		""
		"Craft an &eInscription Table&r. Put your spellbook and a scroll in it to write the spell into the book permanently."
	]
	quest.102BADC4951F1256.title: "Ink and Quill"
	quest.103DE65E65DE52A0.quest_desc: [
		"When the Devourer fell, nobody saw the blow that opened its armor. That was the point."
		""
		"Complete the Last Light and the Violet path. They never saw you coming."
	]
	quest.103DE65E65DE52A0.quest_subtitle: "After the Last Light"
	quest.103DE65E65DE52A0.title: "&5Legend of the Violet Light"
	quest.10414CF96335E011.quest_desc: [
		"Three pieces of a broken bone staff, scattered among the graves. Put together, they call a champion."
		""
		"Collect all three &eOminous Bone Staff Fragments&r (lower, middle, upper) from The Graveyard's structures."
	]
	quest.10414CF96335E011.title: "The Ominous Staff"
	quest.1071ED43A06ECDB1.quest_desc: [
		"Bonding takes time, trust and a lot of fish."
		""
		"Craft a &eDragon Whistle&r to call your dragon to you."
	]
	quest.1071ED43A06ECDB1.title: "The Whistle"
	quest.109DC2A4234295F7.quest_desc: [
		"Beaked mask, long coat. Odd for a beast master, but it makes summons stronger."
		""
		"Craft the full &ePlagued&r set (Iron's Spells)."
	]
	quest.109DC2A4234295F7.title: "The Plague Doctor's Coat"
	quest.10B45934FFB9236C.quest_desc: [
		"Your hatchling grows fast on roasted meat, and it grows angry like you."
		""
		"Raise your fire dragon (feed it meat; Dragon Meal speeds it up) and forge it &eiron dragon armor&r (head and body). At stage 3 you can ride it into the sky."
	]
	quest.10B45934FFB9236C.title: "Saddle of Iron, Wings of Fire"
	quest.115F6F1FF8805672.quest_desc: [
		"A Create &eMechanical Harvester&r on a moving contraption (a piston, bearing or cart) cuts ripe crops and replants them as it passes."
		"Add a belt or chute to collect the harvest. See the Create chapter for the basics."
	]
	quest.115F6F1FF8805672.title: "Let the Machines Farm"
	quest.1163E26FCD0558A6.quest_desc: [
		"Inside the castle, &cred&r, &eyellow&r and &9blue&r keys open the doors of the same colour. Find each key before you try its door."
		"The Levitation Crystal waits at the castle's heart, and so do its guardians. Fly or float there with your party."
	]
	quest.1163E26FCD0558A6.title: "Castle in the Sky"
	quest.1182F685AB5D84FE.quest_desc: [
		"Ancient debris, melted with gold, shaped into something that doesn't break."
		""
		"Upgrade a greatweapon to &enetherite&r at a smithing table (netherite template from bastions)."
	]
	quest.1182F685AB5D84FE.title: "Netherite Fury"
	quest.11A3D30705A46E12.quest_desc: [
		"Set the table. Everyone eats tonight."
		""
		"Cook and place a &efeast&r block (roast chicken, honey glazed ham, shepherd's pie...) with a Cooking Pot."
	]
	quest.11A3D30705A46E12.title: "A Feast for the Pack"
	quest.11C777189C78FD6E.quest_desc: [
		"A Lightwarden's second blade is mercy."
		""
		"Craft a &eHoly Rune&r. Holy spells like &eHeal&r and &eFortify&r keep the party standing; healing allies earns Green XP."
	]
	quest.11C777189C78FD6E.title: "Hands That Heal"
	quest.11CC35B3BCAAD7FF.quest_desc: [
		"A tower crowned with copper. On top, a mage who has bottled a thunderstorm."
		""
		"Find an &eElectromancer Tower&r (Discerning the Eldritch) and defeat the &eElectromancer&r."
	]
	quest.11CC35B3BCAAD7FF.title: "The Storm Tower"
	quest.11E6ACD9326C6915.quest_desc: [
		"Every hoard hides an egg. Every egg hides a mount."
		""
		"Take a &efire dragon egg&r from a roost (red, green, bronze or gray). Fire eggs hatch when placed in fire; the hatchling bonds with whoever is nearest."
	]
	quest.11E6ACD9326C6915.title: "Firebrood"
	quest.11E9E3CDB830BBC9.quest_desc: [
		"In the &eBurning Arena&r, the flame knight &eIgnis&r fights in three phases, each hotter than the last. In the end his sword and shield fall to the worthy."
		"His Ignitium makes some of the best armour in the game."
	]
	quest.11E9E3CDB830BBC9.title: "III. Ignis"
	quest.11FD155EC8998B9C.quest_desc: [
		"Know your enemy. Their patrols already sniff along the ridge."
		""
		"Find the pillager camp on the ridge (150-250 blocks from the village) and thin out its patrols: kill &e5 pillagers&r. Bring a friend."
	]
	quest.11FD155EC8998B9C.title: "Scout the Camp"
	quest.12166EE4F9D0CB07.quest_desc: [
		"&eCataclysm: Spellbooks&r adds the &3Abyssal&r school and gear forged from Cataclysm bosses: Ignis mage robes, Abyssal Warlock robes, Excelsius armour, the Book o' R'lyeh."
		"Bless a Ruined Book on a Cataclysm amethyst altar to make the Book o' R'lyeh. Abyssal runes take abyssal focus items. Use JEI to plan your set."
	]
	quest.12166EE4F9D0CB07.quest_subtitle: "Cataclysm: Spellbooks"
	quest.12166EE4F9D0CB07.title: "Spells of the Cataclysm"
	quest.1253D241BDFF2568.quest_desc: [
		"Some beasts can't be tamed. Only stopped."
		""
		"Optional: summon and kill the &eVoid Worm&r (Alex's Mobs; a mysterious worm thrown into the void)."
	]
	quest.1253D241BDFF2568.title: "The Void Worm"
	quest.125C30974C3A6BC4.quest_desc: [
		"Fill your MekaSuit with modules until it can't take any more."
		"Optional. The corruption has never met anything like you."
	]
	quest.125C30974C3A6BC4.title: "Fully Loaded"
	quest.1267666A1277F054.quest_desc: [
		"The sky has a ceiling, and above it is &edeep space&r (Create Cosmonautics). There are two ways up:"
		"&a1.&r A lit ring: keep flying up. Past about &e20,000 blocks&r the ring carries you out of the world, and keeps you breathing while its charge lasts."
		"&a2.&r A rocket: Cosmonautics' thrusters and engines (made with &etitanium&r, a new ore), plus a space helmet. Bring the whole party."
		"Out there you fly toward a world to land on it: the Moon, Oa or Korugar."
	]
	quest.1267666A1277F054.quest_subtitle: "Leave the world"
	quest.1267666A1277F054.title: "Beyond the Sky"
	quest.12AFAE2ACB2038F1.quest_desc: [
		"A ring that turns you into rumour."
		""
		"Craft or find a &eRing of Invisibility&r (Iron's Spells)."
	]
	quest.12AFAE2ACB2038F1.title: "Ring of the Unseen"
	quest.12C16FD16CE3413E.quest_desc: [
		"A Hoardwarden's vault is never full. But it can be impressive."
		""
		"Gather &e9 gold blocks&r, &e9 diamond blocks&r and &e9 emerald blocks&r (kept, not consumed)."
	]
	quest.12C16FD16CE3413E.title: "The Hoard"
	quest.12C92D5DA7EECF40.quest_desc: [
		"&eSimply Swords&r adds fifteen weapon types: longsword, katana, rapier, sai, cutlass, claymore, greataxe, greathammer, scythe, spear, glaive, halberd, chakram, twinblade and warglaive."
		"Each comes in iron, gold, diamond and netherite. Fast weapons suit hit-and-run fighters; heavy ones suit tanks and berserkers. Try a few."
	]
	quest.12C92D5DA7EECF40.title: "Fifteen Ways to Fight"
	quest.12D791B7479EC993.quest_desc: [
		"When you die, your items stay in a &eCorpse&r where you fell, marked on your map. Right-click it to take everything back."
		"A corpse with items in it never despawns, never falls into the void and never burns in lava. Friends can open it too, so a party member can carry your gear home."
	]
	quest.12D791B7479EC993.quest_subtitle: "Corpse"
	quest.12D791B7479EC993.title: "When You Fall"
	quest.12E837E1DAC584D9.quest_desc: [
		"You dream of a yellow world under a storm that never ends, and a spire struck by lightning a thousand times a night."
		""
		"Reach &eYellow level 25&r. Then the trial."
	]
	quest.12E837E1DAC584D9.quest_subtitle: "Class level 25"
	quest.12E837E1DAC584D9.title: "The Dream"
	quest.1351C1C39685C692.quest_desc: [
		"Items live on &eStorage Cells&r (1k, 4k, 16k, 64k, 256k) inside an &eME Drive&r. A cell holds a set number of item types and a total amount."
		"Craft a storage cell and an ME Drive."
	]
	quest.1351C1C39685C692.title: "Drives and Cells"
	quest.13DC9C345CA75F0D.quest_desc: [
		"At the altar, at night, blood and bone call him back: the Corrupted Champion, the Graveyard's lich."
		""
		"At the &eLich Prison&r altar, at &enight&r, use a &efull Vial of Blood&r and all &ethree bone staff pieces&r to summon him, then kill him. Party members within 64 blocks get the trial credit too."
	]
	quest.13DC9C345CA75F0D.quest_subtitle: "Ring trial: the boss"
	quest.13DC9C345CA75F0D.title: "&5The Corrupted Champion"
	quest.1422D752FF3E810E.quest_desc: [
		"A &eStove&r is a tidy heat source: put the pot or skillet on top, or cook six things at once on its own surface."
		"Build a kitchen near your base's waystone. Your party will thank you before every boss."
	]
	quest.1422D752FF3E810E.title: "A Proper Kitchen"
	quest.143A4195ACBAAE04.quest_desc: [
		"The Lantern's words burn behind your eyes: Oa, the Guardians, the seven lights of the spectrum."
		""
		"Read the lore he left you, then turn to &6Act I: Proving Ground&r. The road to a ring starts there."
	]
	quest.143A4195ACBAAE04.quest_subtitle: "Act I opens"
	quest.143A4195ACBAAE04.title: "The Book of Oa"
	quest.145016B237F34441.quest_desc: [
		"The Red light burns hottest where the world is already on fire."
		""
		"Optional: build an obsidian portal and step into the &cNether&r. Red's path lives there."
	]
	quest.145016B237F34441.title: "A Taste of Rage"
	quest.149075E630EE9C53.quest_desc: [
		"Your familiars grow with you."
		""
		"Upgrade a familiar (Alshanex's Familiars; see the Familiar Guide)."
	]
	quest.149075E630EE9C53.title: "Bond of Many"
	quest.1519CF452877BC5E.quest_desc: [
		"You dream of a violet void where islands drift in silence, and of a lantern that only shines in the dark."
		""
		"Reach &eViolet level 25&r. Then the trial."
	]
	quest.1519CF452877BC5E.quest_subtitle: "Class level 25"
	quest.1519CF452877BC5E.title: "The Dream"
	quest.1525E5B986943B98.quest_desc: [
		"You dream of a mountain of gold, and of an orange lantern buried at its heart."
		""
		"Reach &eOrange level 25&r. Then the trial."
	]
	quest.1525E5B986943B98.quest_subtitle: "Class level 25"
	quest.1525E5B986943B98.title: "The Dream"
	quest.15D894FF564947FE.quest_desc: [
		"A colossus of void-steel, and its fist is the treasure."
		""
		"Kill the &eEnder Guardian&r in the Ruined Citadel. Watch for its void runes on the floor."
	]
	quest.15D894FF564947FE.title: "The Guardian's Fist"
	quest.15DD094307D61169.quest_desc: [
		"When the Devourer fell, every ally the Frostbinder shielded was still alive to see it."
		""
		"Complete the Last Light and the Blue path. Winter keeps what it loves."
	]
	quest.15DD094307D61169.quest_subtitle: "After the Last Light"
	quest.15DD094307D61169.title: "&bLegend of the Blue Light"
	quest.161BBFD2D2735C41.quest_desc: [
		"&eBorn in Chaos&r fills the night with horrors: decaying zombies, bone imps, dread hounds, pumpkin-headed riders. Blood Moons bring more of them."
		"The swollen &eMother Spider&r never hunts alone: her spiderlings swarm you. Kill the brood fast."
	]
	quest.161BBFD2D2735C41.quest_subtitle: "Born in Chaos"
	quest.161BBFD2D2735C41.title: "I. The Mother Spider"
	quest.162695535B670CD7.quest_desc: [
		"The Archevoker's own book, its pages still twitching."
		""
		"Get the &eGrimoire of Evokation&r, the evocation spellbook (see JEI)."
	]
	quest.162695535B670CD7.title: "Grimoire of Evokation"
	quest.16285CFDC0D796D1.quest_desc: [
		"Two &eCrushing Wheels&r spinning toward each other crush whatever falls between them, faster than a millstone and with a chance of bonus output."
		"Crushed ore smelts into more ingots than raw ore, and often gives Experience Nuggets too."
	]
	quest.16285CFDC0D796D1.title: "Crushing Wheels"
	quest.166FF0362888C2B9.quest_desc: [
		"Some coffins are sealed for a reason."
		""
		"Desecrate a coffin in a Graveyard crypt to summon its &ewraith&r, then put it back to rest."
	]
	quest.166FF0362888C2B9.title: "Taking From the Dead"
	quest.16C13F18A08C1E2F.quest_desc: [
		"Ink sets how rare a scroll you can write. Pour a bucket's worth (four bottles) of ink into the cauldron and add a metal to brew the next rarity:"
		"&fCommon&r + copper = &aUncommon&r, + iron = &9Rare&r, + gold = &5Epic&r, + amethyst = &6Legendary&r. Brew some &9Rare Ink&r."
	]
	quest.16C13F18A08C1E2F.title: "The Ink Ladder"
	quest.172A3C1A7C98214B.quest_desc: [
		"A &eChemical Injection Chamber&r fed with &ehydrogen chloride&r turns ore into four shards, which go down the purification line."
		"Hydrogen chloride comes from hydrogen and chlorine (from salt water) in a Chemical Infuser."
	]
	quest.172A3C1A7C98214B.title: "Four for One"
	quest.17A953CEF63CB498.quest_desc: [
		"Half eagle, half horse, all pride. A paladin's true steed flies."
		""
		"Tame a &ehippogryph&r (Ice and Fire), found in hills and mountains. The &eBestiary&r explains how. A white one suits a Lightwarden."
	]
	quest.17A953CEF63CB498.title: "White Wings"
	quest.17A9DC484E24C235.quest_desc: [
		"Somebody lives up there. Somebody trades up there."
		""
		"Find a &eSky Village&r floating high above the land."
	]
	quest.17A9DC484E24C235.title: "Village in the Clouds"
	quest.18A40BBFDEDB5230.quest_desc: [
		"&eEndshelves&r need Infused Dragon's Breath, so they come after the Ender Dragon. They're the strongest shelves, and can be upgraded into Draconic Endshelves."
		"Deep-dark &eDeepshelves&r are worth building too."
	]
	quest.18A40BBFDEDB5230.title: "Shelves of the End"
	quest.18B3431556178FEC.quest_desc: [
		"Ignis was a hero once. Now he is fire wearing armor."
		""
		"Kill &eIgnis&r in the Burning Arena. He has three phases and his shield reflects; strike between his combos."
	]
	quest.18B3431556178FEC.title: "Ignis"
	quest.18FEBB4AB2572697.quest_desc: [
		"Some blades are forged. Some are born burning."
		""
		"Optional: find a fire-touched &eSimply Swords&r unique (dungeon and boss loot)."
	]
	quest.18FEBB4AB2572697.title: "Ember Edge"
	quest.1916068CC0FEF748.quest_desc: [
		"A king's crown and a king's club. Both are yours now."
		""
		"Claim the &eOgre King's Crown&r and the &eOgre King's Club&r."
	]
	quest.1916068CC0FEF748.title: "Spoils of the King"
	quest.191712001806C149.quest_desc: [
		"A &eWayward Compass&r points to the &eCatacombs&r, the crypt where the Dead King sleeps. Iron's other structures (pyromancer towers, the evoker fort, the ice spider den, the citadel) hide mages, knights and rare books."
		"Enter the Catacombs. The Dead King himself is in the Bosses chapter."
	]
	quest.191712001806C149.title: "Into the Catacombs"
	quest.1951EF18DDFE386F.quest_desc: [
		"In the Nether's &eSoul Black Smith&r forge sleeps the &eNetherite Monstrosity&r, a living siege engine that sprays lava and shakes the ground."
		"Fire resistance is not optional."
	]
	quest.1951EF18DDFE386F.title: "III. The Netherite Monstrosity"
	quest.1962471694C78C7F.quest_desc: [
		"Affixed gear you don't want goes into the &eSalvaging Table&r. It breaks items down into rarity materials (Mysterious Scrap Metal, Luminous Crystal Shards and rarer ones)."
		"Those materials pay for reforging, so salvage everything you won't use."
	]
	quest.1962471694C78C7F.title: "Salvage, Don't Toss"
	quest.197F03A4777970F2.quest_desc: [
		"Masked warriors dance in a savanna grove around a chief who commands the sun."
		""
		"Find an &eUmvuthana Grove&r (Mowzie's Mobs) in a savanna."
	]
	quest.197F03A4777970F2.title: "The Sun Tribe"
	quest.1998B3DD6637B6E6.quest_desc: [
		"Pink salt caves glitter with a metal the surface has never seen."
		""
		"Explore Galosphere's &ePink Salt Caves&r and smelt &e8 palladium ingots&r."
	]
	quest.1998B3DD6637B6E6.title: "Silver in the Salt"
	quest.1A2F375D6DDFCC4C.quest_desc: [
		"Three skulls, soul sand, and a storm of black fire. An old test, and still a good one."
		""
		"Summon and kill the &eWither&r (3 wither skeleton skulls on soul sand). Fight it underground or far from your base."
	]
	quest.1A2F375D6DDFCC4C.title: "The Withered King"
	quest.1A4F58C83D0C4D15.quest_desc: [
		"&eGems&r drop from monsters and chests. Put one into an item with an empty &esocket&r at a &eSmithing Table&r; each gem gives different bonuses on weapons, armour or tools."
		"A &eSigil of Socketing&r adds a socket; a &eSigil of Withdrawal&r takes gems back out. Socket a gem now."
	]
	quest.1A4F58C83D0C4D15.title: "Gems and Sockets"
	quest.1A5E64D7B0CE7CCA.quest_desc: [
		"A forest where it's always dusk, and where ancient things guard the way to their masters."
		""
		"Make a portal: a 2x2 pool of water ringed with flowers, then throw in a &ediamond&r. Enter the &eTwilight Forest&r."
	]
	quest.1A5E64D7B0CE7CCA.title: "Into the Twilight"
	quest.1A64EB2896DB6AA8.quest_desc: [
		"God-energy, torn loose in the devouring."
		""
		"Collect a &eDraconic Soul Fragment&r: it drops when the Ender Dragon dies. If you missed it, respawn the dragon and kill it again."
	]
	quest.1A64EB2896DB6AA8.title: "Draconic Soul Fragment"
	quest.1A65CBBEF6215580.quest_desc: [
		"In the Nether, a giant stone fist sleeps in its arena. The &eGauntlet&r punches, fires lasers and blasts the ground. Hit its glowing eye when it opens."
		"The Bloodfire Berserker's trial. Its cousin the &eVoid Blossom&r grows in lush caves below the Overworld."
	]
	quest.1A65CBBEF6215580.title: "II. The Nether Gauntlet"
	quest.1AA30515C29411EC.quest_desc: [
		"Grab, pull, punch. The perfect tank's tool."
		""
		"Claim the &eGauntlet of Guard&r from the Ender Guardian."
	]
	quest.1AA30515C29411EC.title: "Gauntlet of Guard"
	quest.1AC7BF77F1623A7A.quest_desc: [
		"&eLegendary Monsters&r hides a boss in each of its temples and ruins. In the &eFrostbitten Temple&r, an icy golem guards the treasure."
		"Its eyes (Eye of Frost, Eye of Moss...) belong to these bosses; look them up in JEI."
	]
	quest.1AC7BF77F1623A7A.quest_subtitle: "Legendary Monsters"
	quest.1AC7BF77F1623A7A.title: "I. The Frostbitten Golem"
	quest.1AF2243D64B72896.quest_desc: [
		"You dream of crystal peaks floating in the void, and of a frozen heart that beats once a year."
		""
		"Reach &eBlue level 25&r. Then the trial."
	]
	quest.1AF2243D64B72896.quest_subtitle: "Class level 25"
	quest.1AF2243D64B72896.title: "The Dream"
	quest.1B1C849E54CD33FE.quest_desc: [
		"A fortress hanging at the edge of the sky, built by riders who never landed."
		""
		"Find a When Dungeons Arise sky fortress: &eHeavenly Rider&r, &eChallenger&r or &eConqueror&r (around Y 200). Bring slow falling."
	]
	quest.1B1C849E54CD33FE.title: "Fortress in the Sky"
	quest.1B461C01C2B78409.quest_desc: [
		"Drop charged certus, redstone and nether quartz into water together: they react into &eFluix Crystals&r."
		"Fluix makes cables and most network parts. Make a stack's worth over time."
	]
	quest.1B461C01C2B78409.title: "Fluix"
	quest.1B88950EAC0BB55D.quest_desc: [
		"Giant whales drift through the sky carrying ships on their backs, and one carries an arena."
		"Land on a &eSky Whale Ship&r. Whatever lives up there won't be glad to see you."
	]
	quest.1B88950EAC0BB55D.title: "The Sky Whale"
	quest.1BCA73E1CE923FFA.quest_desc: [
		"Crossbow bolts bite. Iron bites back."
		""
		"Craft and wear any piece of iron armor. More is better: Day Seven is not forgiving."
	]
	quest.1BCA73E1CE923FFA.title: "Iron Skin"
	quest.1C44FC28B9B0C90F.quest_desc: [
		"The monolith wakes, and it remembers being a god."
		""
		"Kill the &eObsidilith&r. Its attack patterns are colour-coded; learn them, then strike."
	]
	quest.1C44FC28B9B0C90F.title: "Obsidilith"
	quest.1C65139AC587CC51.quest_desc: [
		"Waystones stand in villages and in the wild (about one every 25 chunks). Craft one for your base (see JEI) so you can always get home."
		"Teleporting costs XP: about one level per 100 blocks (27 at most), and 27 levels to change dimension. Warping to a global waystone is free. Each player activates a waystone for themselves."
	]
	quest.1C65139AC587CC51.title: "A Waystone for Home"
	quest.1C65D882069EDD83.quest_desc: [
		"Many Alex's creatures drop parts for gear: &eRoadrunner Boots&r (fast on sand), the Crocodile Chestplate, the Tarantula Hawk Elytra, the Squid Grapple and more."
		"Make the Roadrunner Boots from feathers of the quick desert birds."
	]
	quest.1C65D882069EDD83.title: "Trophies of the Wild"
	quest.1C7CF2E95844D04B.quest_desc: [
		"A raid is only a raid while villagers live. Give them spears and they will stand with you."
		""
		"Recruit a &eGuard&r (Guard Villagers): sneak and right-click an unemployed villager while holding a sword or crossbow. Keep the villagers alive!"
	]
	quest.1C7CF2E95844D04B.title: "Hire Spears"
	quest.1CA863EEDF4D5535.quest_desc: [
		"There are dragons of every kind, and every kind wants something different from you."
		""
		"Find a &eBook of Dragons&r roost, climb onto a wild dragon and hold on until it stops bucking. Read the Book of Dragons to learn what each species wants."
	]
	quest.1CA863EEDF4D5535.title: "Here Be Dragons"
	quest.1CCA99026B690E83.quest_desc: [
		"Every animal you pass turns its head to look at you, and you hear: &o\"We are with you.\"&r"
		""
		"Reach &eIndigo level 10&r. Breeding, taming, harvesting and your summons' kills all count."
	]
	quest.1CCA99026B690E83.quest_subtitle: "Class level 10"
	quest.1CCA99026B690E83.title: "The Light Whispers"
	quest.1DAE5DAC9D6F6EF0.quest_desc: [
		"At the head of an &eevoker fort&r stands the &eArchevoker&r, an illager mage with fangs, vexes and shields of its own."
		"Its robes are Archevoker school armour: Lightwardens take note."
	]
	quest.1DAE5DAC9D6F6EF0.quest_subtitle: "Iron's Spells"
	quest.1DAE5DAC9D6F6EF0.title: "I. The Archevoker"
	quest.1DB08251A912DB04.quest_desc: [
		"&eMekanism&r adds osmium, tin, lead, uranium and fluorite ores. &eOsmium&r goes into nearly every Mekanism machine, tin and copper make bronze, and lead shields you from radiation."
		"The Mekanism chapter shows how to turn one ore into two, three, then five ingots."
	]
	quest.1DB08251A912DB04.title: "Ores of the Machine Age"
	quest.1DD2CBEC71A82CA6.quest_desc: [
		"Seven Corps, seven lights, one ring each. Rings aren't crafted: yours comes at the end of your class's road, from its &ering trial&r. The ring chooses; it refuses the unworthy."
		"The Guardians on Oa are watching who earns one. Until then, learn what the rings and lanterns do."
	]
	quest.1DD2CBEC71A82CA6.quest_subtitle: "Create: Lanterns"
	quest.1DD2CBEC71A82CA6.title: "The Lantern Corps"
	quest.1DDBF1CF32EA3AD8.quest_desc: [
		"Lightning doesn't swing. Lightning strikes."
		""
		"Craft a quick duelling blade: a rapier, katana, estoc or the Amethyst Rapier. Fast weapons + Combat Roll suit a Stormwright."
	]
	quest.1DDBF1CF32EA3AD8.title: "The Duelist"
	quest.1DEEC5A99378DC99.quest_desc: [
		"Robes of the illager magi, turned to a better cause."
		""
		"Craft the full &eArchevoker&r set (Iron's Spells). It boosts evocation spell power."
	]
	quest.1DEEC5A99378DC99.title: "The Archevoker's Mantle"
	quest.1ECAE28D914DD08D.quest_desc: [
		"The violet ring stayed. It loves you, and it is terrifying."
		""
		"Optional, Violet ring only: learn &eVoid Lure&r (Spectral Hub HUD)."
	]
	quest.1ECAE28D914DD08D.title: "The Violet Answered"
	quest.1ECD1DB6E0DAF0FF.quest_desc: [
		"In the dark forest, a fortress of illager magi practises evocation of the worst kind."
		""
		"Find an &eEvoker Fort&r (Iron's Spells), usually in dark forests and taigas."
	]
	quest.1ECD1DB6E0DAF0FF.title: "The Evoker's Fort"
	quest.1EF55A06379C0DF8.quest_desc: [
		"The Devourer's shadow wakes the old Cataclysm bosses. Put them down before they join it."
		""
		"Optional: Kill &eScylla&r in the Acropolis (at sea). Another class's chapter may already have sent you there."
	]
	quest.1EF55A06379C0DF8.title: "Storm Queen"
	quest.1EFE5240E7146A81.quest_desc: [
		"Ice that never melts, and a will that never breaks."
		""
		"Unlock the &ePinnacle&r world tier (Apotheosis: a full Epic affix set and the Ender Dragon slain; CTRL+T switches tiers) and wield a &6Mythic&r battlemage blade with ice gems. Tick the checkmark when you do."
	]
	quest.1EFE5240E7146A81.quest_subtitle: "Extreme gear"
	quest.1EFE5240E7146A81.title: "Mythic Winter"
	quest.1F1FE50908BB6FCA.quest_desc: [
		"Mekanism machines run on energy (they take FE too). A &eHeat Generator&r burns lava or fuel; solar and wind generators make free power; a Create alternator works as well."
		"Build a Heat Generator to start."
	]
	quest.1F1FE50908BB6FCA.quest_subtitle: "Mekanism Generators"
	quest.1F1FE50908BB6FCA.title: "Power Up"
	quest.1F4C496BE30FC5EC.quest_desc: [
		"On a far End island, a citadel of obsidian and void. Its guardian wears a gauntlet worth a kingdom."
		""
		"Find the &eRuined Citadel&r (Cataclysm) on the outer End islands. An &eEye of Void&r points the way."
	]
	quest.1F4C496BE30FC5EC.title: "The Ruined Citadel"
	quest.2043A54F0A57B67F.quest_desc: [
		"Pilgrims of a dead faith left a temple in the soul sand. Their ghosts didn't leave."
		""
		"Find a &eSanctum&r (Jaden's Nether Expansion), usually in soul sand valleys. Watch out for banshees."
	]
	quest.2043A54F0A57B67F.title: "The Ashen Sanctum"
	quest.204535BF31BBEDAB.quest_desc: [
		"The Gauntlet's light gutters out, and something red drifts down from the ceiling. It circles you. It asks."
		"Is it rage that drives you, or something else?"
		""
		"Claim this reward to begin the &ering trial&r: a conversation in chat. The ring will judge you. Your &eanswers&r decide whether you receive your own light, the &fWhite&r, or the &8Black&r. Answer as who you really are."
		"&7(Only works once you have the trial credit from the quest before.)"
	]
	quest.204535BF31BBEDAB.quest_subtitle: "The ring will judge you"
	quest.204535BF31BBEDAB.title: "The Ring Judges"
	quest.208FD9E316195FEB.quest_desc: [
		"Yellow sees a thunderstorm and asks how to bottle it."
		""
		"Optional: make &eAndesite Alloy&r, the first step of every &eCreate&r machine."
	]
	quest.208FD9E316195FEB.title: "A Taste of the Storm"
	quest.20EA5FD46EEDF223.quest_desc: [
		"An eagle on your fist is a second pair of eyes, and a second set of claws."
		""
		"Tame a &ebald eagle&r (Alex's Mobs; see its Animal Dictionary) and craft a &eFalconry Glove&r to launch it."
	]
	quest.20EA5FD46EEDF223.title: "Falconer"
	quest.21071DFA17C7349B.quest_desc: [
		"A berserker doesn't carry a shield. A berserker carries something bigger."
		""
		"Craft any two-handed greatweapon below. Better Combat gives each one wide sweeping combos; keep your off-hand empty."
	]
	quest.21071DFA17C7349B.title: "Two Hands, One Purpose"
	quest.2109548C6FB48CCA.quest_desc: [
		"The light is strongest where the world is coldest."
		""
		"Visit one of the harsh frozen biomes below. Ice spell kills in cold biomes give extra Blue XP."
	]
	quest.2109548C6FB48CCA.title: "Where Breath Freezes"
	quest.213C0FE1515AC3F9.quest_desc: [
		"The dunes ripple the wrong way."
		""
		"Optional: kill a &eDeath Worm&r in a desert (Ice and Fire). Its chitin makes good armor."
	]
	quest.213C0FE1515AC3F9.title: "Something Under the Sand"
	quest.214D41F2772E9FD8.quest_desc: [
		"A stone tower with a sealed door, and a voice: 'Prove yourself.'"
		""
		"Find a tier-1 &eCombat Shrine&r (Dungeons and Taverns) and beat its trial. Higher tiers come later; tier 1 is fair for fresh iron."
	]
	quest.214D41F2772E9FD8.title: "Trial of the Shrine"
	quest.218F4601A7AD2E46.quest_desc: [
		"Its claws, sewn into a robe. Now you're the thing in the dark."
		""
		"Craft the &eNightmare Mask&r and &eNightmare Robe&r (Born in Chaos, see JEI)."
	]
	quest.218F4601A7AD2E46.title: "Mantle of the Night"
	quest.21C87627A3F954DE.quest_desc: [
		"In the snowy forest, the lord of the yetis throws ice like boulders."
		""
		"Kill the &eAlpha Yeti&r in its cave. The trophy counts too."
	]
	quest.21C87627A3F954DE.title: "The Alpha Yeti"
	quest.21C8764B60285A29.quest_desc: [
		"In a lush cave, a flower the size of a house has learned to hate."
		""
		"Kill the &eVoid Blossom&r (Bosses of Mass Destruction) in its overgrown cavern underground. Kill its spore minions fast."
	]
	quest.21C8764B60285A29.title: "The Deep Bloom"
	quest.21DC7910ED86F2C2.quest_desc: [
		"Galosphere's &epalladium&r ore smelts into ingots for &eSterling&r armour and horse armour."
		"Pink salt caves are worth a visit too: salt preserves meat into jerky that lasts on long trips."
	]
	quest.21DC7910ED86F2C2.title: "Palladium and Sterling"
	quest.2241E47DFE19B260.quest_desc: [
		"The tallest shrine. The hardest voice. 'Prove yourself' once more."
		""
		"Beat a tier-5 &eCombat Shrine&r (Dungeons and Taverns)."
	]
	quest.2241E47DFE19B260.title: "The Highest Trial"
	quest.226E6720BCDFDEFC.quest_desc: [
		"A black dragon you can only see when it wants you to. The perfect partner."
		""
		"Tame a &eNight Fury&r (Book of Dragons): find one near a roost, climb on and hold on until it stops bucking."
	]
	quest.226E6720BCDFDEFC.title: "Offspring of Lightning and Death"
	quest.22AD767CB6A4FAC9.quest_desc: [
		"A dragon made of storm. It thinks the sky is its alone. Correct it."
		""
		"Kill an adult &elightning dragon&r (Ice and Fire). They roost in jungles, savannas and badlands."
	]
	quest.22AD767CB6A4FAC9.title: "Storm Rival"
	quest.22D587B91368DFE4.quest_desc: [
		"Under the hills, old cellars still breed the dead."
		""
		"Find a &eYUNG's Better Dungeon&r (zombie, skeleton, spider or small dungeon). They hide underground: follow caves and listen for mobs."
	]
	quest.22D587B91368DFE4.title: "Into the Dark"
	quest.231F7273D3EE21B6.quest_desc: [
		"In the silence between heartbeats, a voice: &o\"They never see the ones who matter.\"&r"
		""
		"Reach &eViolet level 10&r. Night kills, sneak kills, undead kills and End kills all count."
	]
	quest.231F7273D3EE21B6.quest_subtitle: "Class level 10"
	quest.231F7273D3EE21B6.title: "The Light Whispers"
	quest.234761C69AD1A858.quest_desc: [
		"&o\"Winter keeps what it loves.\"&r"
		"Blue is the light of hope: an ice battlemage of sword and spell, who explores frozen lands and the sky islands, and protects the party."
		""
		"Claim the reward to join Blue and unlock its talent tree. You can still join other lights later."
	]
	quest.234761C69AD1A858.quest_subtitle: "Join this light"
	quest.234761C69AD1A858.title: "&bThe Frostbinder"
	quest.236EE676F59D999E.quest_desc: [
		"The old dragon's hide, bound around a void-hungry spellbook."
		""
		"Make the &eDragonskin Spell Book&r (Iron's Spells; dragonskin comes from the Ender Dragon)."
	]
	quest.236EE676F59D999E.title: "Dragonskin"
	quest.237A60B851DF921F.quest_desc: [
		"A pyramid half-swallowed by the desert, cursed by a pharaoh who never shared."
		""
		"Find the &eCursed Pyramid&r (L_Ender's Cataclysm) in a desert. An &eEye of Desert&r points the way."
	]
	quest.237A60B851DF921F.title: "Pyramid of Greed"
	quest.2384463DF48A34E8.quest_desc: [
		"The dead keep their best things close. A Hoardwarden asks politely, with a brush."
		""
		"Brush suspicious sand or gravel (trail ruins, desert wells, ocean ruins) until you recover a &epottery sherd&r."
	]
	quest.2384463DF48A34E8.title: "Grave Goods"
	quest.23BBEB9A964DEB4B.quest_desc: [
		"In Iron's &eCitadel&r, where the Ancient Knights still stand guard, burns the &eEcho of Tyros, First Flamebearer&r: a fire mage boss of the extreme tier."
		"Fire resistance, ice spells, and a full party."
	]
	quest.23BBEB9A964DEB4B.title: "IV. The Echo of Tyros"
	quest.23E240F2FE8C0FF5.quest_desc: [
		"Every hero ends up with a cellar full of loot. Let's make it a good one."
		""
		"A &eSophisticated chest&r or &ebarrel&r starts like any chest: 27 slots. But it takes &eupgrades&r, it can be &eraised a tier without emptying it&r, and when you break it, it &ekeeps everything inside&r: it drops as one packed chest, like a shulker box. No more emptying a room to move it."
		""
		"Make either one (JEI shows the recipe). You can recolour and re-texture them later at a &eDecoration Table&r."
	]
	quest.23E240F2FE8C0FF5.quest_subtitle: "Sophisticated Storage"
	quest.23E240F2FE8C0FF5.title: "A Proper Chest"
	quest.23E87BF2241821DC.quest_desc: [
		"A &eDragonforge&r is a 3x3x3 shell of Dragonforge Bricks with a core in the centre and an aperture in the wall. A dragon's breath into the aperture is what heats it."
		"Use your own tamed dragon (or a captured one). Build the core."
	]
	quest.23E87BF2241821DC.title: "The Dragonforge"
	quest.241D471CE977E2A3.quest_desc: [
		"Oa and Korugar hang among the stars. A Lantern can fly there, but a Stormwright brings the whole party."
		""
		"Build a ship that can leave the world: Create Aeronautics for the hull (&e16 Pearlescent Levitite&r), Create Cosmonautics' titanium thrusters to break the sky. Then take your crew into &edeep space&r."
	]
	quest.241D471CE977E2A3.title: "Starship"
	quest.246758B0F7777A14.quest_desc: [
		"Under the ground, caves of singing crystal glow in the dark."
		""
		"Explore Galosphere's &eCrystal Canyons&r and gather &e8 allurite&r and &e8 lumiere shards&r."
	]
	quest.246758B0F7777A14.title: "Crystal Canyons"
	quest.248F1BFE83A2CB3E.quest_desc: [
		"Slay a dragon. Never alone: one player draws its breath while the others shoot. Fire resistance potions help a lot against fire dragons."
		"Dragons are flying bosses. Fight in the open where you can see them coming, and bring lots of arrows."
	]
	quest.248F1BFE83A2CB3E.title: "Dragonslayer"
	quest.24AEEB8F30D8B54E.quest_desc: [
		"&eSky Villages&r float high above the ground, on islands of their own."
		"Get up there with a balloon, an elytra or a long staircase, and visit one. A waystone up there saves the climb next time."
	]
	quest.24AEEB8F30D8B54E.title: "Villages Above the Clouds"
	quest.24AFFAD186272776.quest_desc: [
		"Scales of the deep, shaped into armor."
		""
		"Craft a full &eTide Guardian&r set from sea serpent scales (any colour; this checks the blue set, see JEI)."
	]
	quest.24AFFAD186272776.title: "Tide Guardian"
	quest.24C306648E41BBEE.quest_desc: [
		"In the End, a huge gentle beast drifts between the islands, eating starlight."
		""
		"Tame a &eCosmaw&r in the End (Alex's Mobs; it likes cosmic cod)."
	]
	quest.24C306648E41BBEE.title: "Star-Eater"
	quest.24D71A6EF8F0B097.quest_desc: [
		"&eYUNG's Better Nether Fortresses&r turns the fortress into a real castle, with a keep, lava halls and blaze-filled towers."
		"Blazes drop the rods you need for Create's Blaze Burner and the Eye of Ender."
	]
	quest.24D71A6EF8F0B097.title: "The Burning Keep"
	quest.252168FAAF6E3A6E.quest_desc: [
		"One cut. That's all it ever takes."
		""
		"Unlock the &ePinnacle&r world tier (Apotheosis: a full Epic affix set and the Ender Dragon slain; CTRL+T switches tiers) and wield &6Mythic&r daggers with void gems. Tick the checkmark when you do."
	]
	quest.252168FAAF6E3A6E.quest_subtitle: "Extreme gear"
	quest.252168FAAF6E3A6E.title: "Mythic Shadow"
	quest.254726A302E5A26F.quest_desc: [
		"Thunder rolls on a clear day, and in it you hear: &o\"Faster.\"&r"
		""
		"Reach &eYellow level 10&r. Create milestones, machines and lightning kills all count."
	]
	quest.254726A302E5A26F.quest_subtitle: "Class level 10"
	quest.254726A302E5A26F.title: "The Light Whispers"
	quest.258B88543F01C883.quest_desc: [
		"Build a &eScroll Forge&r (polished deepslate and crying obsidian). Put in ink, paper and a &eschool focus&r (a blaze rod for fire, a frozen bone for ice...), then pick a spell to write."
		"Rarer ink unlocks rarer spells. This is how you get the exact spell you want instead of hoping for loot."
	]
	quest.258B88543F01C883.title: "The Scroll Forge"
	quest.2599D36BF40169F6.quest_desc: [
		"A prison of black stone, an altar, and chains that don't hold anything any more."
		""
		"Find the &eLich Prison&r (The Graveyard). Its altar is where the trial begins."
	]
	quest.2599D36BF40169F6.title: "The Lich Prison"
	quest.25D2F0AFBE5A5904.quest_desc: [
		"The &eSimple Reforging Table&r rerolls an item's affixes, paid for with &eSigils of Rebirth&r and rarity materials. It offers you three results; pick the one you like."
		"It handles the lower rarities. Good for turning a decent sword into a great one."
	]
	quest.25D2F0AFBE5A5904.title: "Reforging"
	quest.25DDBB1E29BA8F0B.quest_desc: [
		"Mekanism multiplies ore. An &eEnrichment Chamber&r turns one ore into &etwo&r dusts; smelt them for two ingots."
		"Every later tier builds on the one before, so keep this machine."
	]
	quest.25DDBB1E29BA8F0B.quest_subtitle: "Ore processing, tier 1"
	quest.25DDBB1E29BA8F0B.title: "Two for One"
	quest.2614B042F2A60027.quest_desc: [
		"A ring found you. Red, White or Black, you are a &eLantern&r now: you can fly, and your will takes shape as constructs."
		""
		"This completes when this light's trial gives you your ring: its own colour, White or Black. The Red path continues to the right; the &6Last Light&r chapter has opened."
	]
	quest.2614B042F2A60027.quest_subtitle: "Ring-bearer"
	quest.2614B042F2A60027.title: "&cRing-Bearer"
	quest.267E1565AC13AA98.quest_desc: [
		"The minimap sits in the corner of your screen. Press &eM&r for the full &eWorld Map&r and &eB&r to drop a waypoint where you stand."
		"Your deaths are marked automatically, and OPAC party members can show up on the map. The land is &eTerralith&r: about a hundred biomes, and a title appears each time you enter a new one."
	]
	quest.267E1565AC13AA98.quest_subtitle: "Xaero's Minimap and World Map"
	quest.267E1565AC13AA98.title: "A World Worth Mapping"
	quest.269607E68DC71B58.quest_desc: [
		"Your first machine. The &eMetallurgic Infuser&r soaks metal in an infusion type: iron with carbon (coal) becomes Enriched Iron and then &esteel&r, copper with redstone becomes &eInfused Alloy&r."
		"Steel is the backbone of every other Mekanism machine."
	]
	quest.269607E68DC71B58.title: "The Metallurgic Infuser"
	quest.26AB5EAE518480B7.quest_desc: [
		"Treasure you can't find is treasure you don't have. A Hoardwarden counts."
		""
		"Build a &eStorage Controller&r and a &eStack Upgrade&r: a desk to keep the ledger and shelves that hold twice what they should. The mod guide &aThe Quartermaster's Ledger&r shows how."
		""
		"&7Optional: it doesn't hold up your path."
	]
	quest.26AB5EAE518480B7.quest_subtitle: "Optional"
	quest.26AB5EAE518480B7.title: "The Counting House"
	quest.26F5D51B0ACA9B09.quest_desc: [
		"Lift, thrust, steering and a heading: put them together into a real airship or plane, with a deck your friends can stand on."
		"Fly it to a Sky Village or a Heavenly fortress. Name it with a &eNameplate&r; every good ship has a name."
	]
	quest.26F5D51B0ACA9B09.title: "Captain of the Clouds"
	quest.270A24D0F4DA18E6.quest_desc: [
		"Infused Alloy (copper and redstone), then &eReinforced Alloy&r (with diamond), then &eAtomic Alloy&r (with refined obsidian). Each tier of machine and circuit needs the next alloy."
		"Make Atomic Alloy."
	]
	quest.270A24D0F4DA18E6.title: "The Alloy Ladder"
	quest.275477230EA58D78.quest_desc: [
		"Loot is heavy. Glory is heavier."
		""
		"Craft a &eBackpack&r (Sophisticated Backpacks). Wear it or place it; add upgrades like Pickup or Magnet later."
	]
	quest.275477230EA58D78.title: "Pack Mule"
	quest.275825B06E09C8CB.quest_desc: [
		"Under an old stronghold, a guardian of carved stone was built to keep thieves out. You're a thief."
		""
		"Defeat the &eAncient Guardian&r (Legendary Monsters). Its &eGuide Book&r and structure advancements show where it waits."
	]
	quest.275825B06E09C8CB.title: "The Stone That Walks"
	quest.2786786758B27169.quest_desc: [
		"The &eCooking Pot&r is the heart of the kitchen. Set it over heat (campfire, fire, magma or a Stove), put in up to six ingredients and a bowl, and it cooks a meal."
		"Cook a &eBeef Stew&r. JEI (press &eU&r on the pot) lists every pot recipe."
	]
	quest.2786786758B27169.quest_subtitle: "The Cooking Pot"
	quest.2786786758B27169.title: "Soup's On"
	quest.27B62C75A5F32909.quest_desc: [
		"Rarely, a zombie, skeleton, creeper or enderman comes back huge: a &eMutant&r. They're mini-bosses that roam the night."
		"The &eMutant Zombie&r gets back up after it falls unless you burn its body. Fight it with fire nearby."
	]
	quest.27B62C75A5F32909.title: "Mutant Monsters"
	quest.27C3398D849C054D.quest_desc: [
		"The shield that never breaks."
		""
		"Unlock the &ePinnacle&r world tier (Apotheosis: a full Epic affix set and the Ender Dragon slain; CTRL+T switches tiers) and carry a &6Mythic&r sword and shield with holy gems. Tick the checkmark when you do."
	]
	quest.27C3398D849C054D.quest_subtitle: "Extreme gear"
	quest.27C3398D849C054D.title: "Mythic Bulwark"
	quest.27D1AD286CCBD7E2.quest_desc: [
		"Little hunters with big bows camp in the woods. They might follow someone kind."
		""
		"Find a &eHunter Campsite&r (Alshanex's Familiars)."
	]
	quest.27D1AD286CCBD7E2.title: "The Hunter's Camp"
	quest.288497335C26C96F.quest_desc: [
		"Hold the &eSpell Wheel&r key to choose a spell from your book, then press &eCast Selected Spell&r. Quick-cast slots let you bind favourites to their own keys. Search 'Iron' in Controls to see and change them."
		"Each spell costs mana and has a cooldown. Some are instant, some you hold to channel. Mana refills over time; rings and armour raise it."
	]
	quest.288497335C26C96F.title: "Casting Like a Mage"
	quest.28940EAD00BDC5FE.quest_desc: [
		"A &eNavigation Table&r points toward a target (a map or compass item) and gives a redstone signal you can wire into your steering. An &eAltitude Sensor&r tells you how high you are."
		"Place a Navigation Table. With redstone, your ship can fly itself."
	]
	quest.28940EAD00BDC5FE.title: "Thataway!"
	quest.28C2207452566432.quest_desc: [
		"Its hammer was a weapon long before it was a tool."
		""
		"Claim the &eInfernal Forge&r, the Monstrosity's hammer (drop or JEI recipe)."
	]
	quest.28C2207452566432.title: "The Infernal Forge"
	quest.28C651EF57364F08.quest_desc: [
		"Under the desert, the &eCursed Pyramid&r hides the &eAncient Remnant&r, a colossal sand-beast that charges through walls."
		"Cataclysm has more to hunt at this tier: the Ender Guardian in the Ruined Citadel, Maledictus in the Frosted Prison, Scylla in the Acropolis."
	]
	quest.28C651EF57364F08.title: "III. The Ancient Remnant"
	quest.28CFC2D2F0AA2CD9.quest_desc: [
		"The &eGorgon&r waits in a temple by the sea. Meet her gaze and you turn to stone. Fight with your eyes turned away from her."
		"Her head, once taken, turns others to stone instead."
	]
	quest.28CFC2D2F0AA2CD9.title: "Don't Look"
	quest.28F3DECC2D51E759.quest_desc: [
		"&eYUNG's Better Strongholds&r are vast: libraries, prisons, crypts and the End portal room deep inside. The nearest one is about 2,000 blocks from spawn."
		"Follow an Eye of Ender. Mark the portal room with a waystone: you'll be back."
	]
	quest.28F3DECC2D51E759.title: "The Great Stronghold"
	quest.29188001C859EF93.quest_desc: [
		"Frozen bones, frozen gold. An ice dragon's den."
		""
		"Find an &eice dragon&r roost or cave (Ice and Fire) in frozen lands."
	]
	quest.29188001C859EF93.title: "Blue Scales"
	quest.29212BDA019C5EB1.quest_desc: [
		"A gem in the rough is a promise. A cut gem is a weapon."
		""
		"Find an &eApotheosis gem&r (rare mob and chest drop) and build a &eGem Cutting Table&r to raise gem rarity."
	]
	quest.29212BDA019C5EB1.title: "Gem Cutter"
	quest.293DE41D7936108C.quest_desc: [
		"The Devourer's shadow wakes the old Cataclysm bosses. Put them down before they join it."
		""
		"Optional: Kill &eThe Leviathan&r in the Sunken City (deep ocean). Another class's chapter may already have sent you there."
	]
	quest.293DE41D7936108C.title: "From the Abyss"
	quest.294D92BDCA54BD55.quest_desc: [
		"The finest steel winter has ever made."
		""
		"Forge the full &eIce Dragonsteel&r armor set."
	]
	quest.294D92BDCA54BD55.title: "Armor of the Frozen Wyrm"
	quest.2989589966667E79.quest_desc: [
		"A &eMillstone&r grinds what you put in: wheat into flour, ores into crushed ore, flowers into dye."
		"Gears change speed: a large cogwheel driving a small one doubles the speed (and the stress)."
	]
	quest.2989589966667E79.title: "Grind It Down"
	quest.29C499638BB4A9C2.quest_desc: [
		"Chaos shards and Draconic Cores fuse into the &eChaotic Core&r, the last and strongest core."
		"Chaotic injectors, crystals and gear follow."
	]
	quest.29C499638BB4A9C2.title: "The Chaotic Core"
	quest.29EF89870067439C.quest_desc: [
		"Right-click a placed storage with a &etier upgrade&r and it grows on the spot, contents and all."
		""
		"&6Copper&r 45 slots · &7Iron&r 54 slots and 2 upgrade slots · &eGold&r 81 and 3 · &bDiamond&r 108 and 4 · &8Netherite&r 132 and 5."
		""
		"Make a &eBasic to Copper&r or &eBasic to Iron&r tier upgrade."
	]
	quest.29EF89870067439C.title: "Bands of Copper and Iron"
	quest.2A113FF21602753D.quest_desc: [
		"Robes woven to drink heat and give it back as power."
		""
		"Craft the full &ePyromancer&r set (Iron's Spells). It boosts fire spell power and mana."
	]
	quest.2A113FF21602753D.title: "The Pyromancer's Mantle"
	quest.2A2C1FC0B37A5FA5.quest_desc: [
		"Put iron and dragon blood into a burning Dragonforge and it makes &eDragonsteel&r: the best armour and weapons Ice and Fire offers."
		"Fire, ice and lightning dragonsteel each burn, freeze or shock what you hit."
	]
	quest.2A2C1FC0B37A5FA5.title: "Dragonsteel"
	quest.2AE6C960575D7929.quest_desc: [
		"Sleep sets your spawn here, in the village you will defend. The countdown doesn't stop while you dream."
		""
		"Craft a bed (3 wool + 3 planks) and sleep in it."
	]
	quest.2AE6C960575D7929.title: "Rest Before the Storm"
	quest.2B16EE1483E73AC7.quest_desc: [
		"Bones in the bog. Hissing in the dark, from many throats at once."
		""
		"Find a &eHydra Cave&r (Ice and Fire) in a swamp. Mark it."
	]
	quest.2B16EE1483E73AC7.title: "The Swamp's Deep Cave"
	quest.2B19DDF6F27B4986.quest_desc: [
		"&eArtifacts&r are magic trinkets (Running Shoes, Cloud in a Bottle, Feral Claws, Lucky Scarf, Night Vision Goggles...) worn in your curio slots beside the inventory."
		"You find them in chests and underground camps, but some chests are &cMimics&r: if a chest bites, kill it. Mimics drop an artifact."
	]
	quest.2B19DDF6F27B4986.quest_subtitle: "Artifacts"
	quest.2B19DDF6F27B4986.title: "Trinkets and Mimics"
	quest.2B20B811922BCFB1.quest_desc: [
		"Every assassin dreams of a blade like this."
		""
		"Optional: find a void-touched &eSimply Swords&r unique (dungeon and boss loot)."
	]
	quest.2B20B811922BCFB1.title: "Blades of the Void"
	quest.2B279C0D67EA50B1.quest_desc: [
		"Armor forged from a burning hero's heart."
		""
		"Craft the full &eIgnitium&r set from Ignis's ignitium ingots (Mechanical Fusion Anvil, see JEI)."
	]
	quest.2B279C0D67EA50B1.title: "Ignitium Plate"
	quest.2B3D7803A016166B.quest_desc: [
		"Follow a &eWayward Compass&r to the Catacombs. The &eDead King&r rises from his throne with a blade of the grave and the spells of a dead age."
		"The Lightwarden's trial. He can be raised again: use a Dead King Phylactery on his soul."
	]
	quest.2B3D7803A016166B.title: "III. The Dead King"
	quest.2B718B18C041149D.quest_desc: [
		"A named weapon, plate on your back, a shield that won't break, and a pack full of loot. You're armed for what's coming."
		"From here, Apotheosis affixes, Iron's school armour and boss gear take you further."
	]
	quest.2B718B18C041149D.title: "Master-at-Arms"
	quest.2BB9525488FE1E43.quest_desc: [
		"The illagers send their strongest raids against the one who keeps winning."
		""
		"Kill &e10 ravagers&r and &e10 evokers&r: win big raids (drink ominous bottles to call them). Defend with the whole party."
	]
	quest.2BB9525488FE1E43.title: "Bastion of the Realm"
	quest.2BDDF6ED76D0BB73.quest_desc: [
		"Something follows you home on dark nights. It only moves when you aren't looking."
		""
		"Kill the &eNightmare Stalker&r (Born in Chaos). It hunts at night; keep it in front of you."
	]
	quest.2BDDF6ED76D0BB73.title: "The Stalker"
	quest.2BDE79183100B325.quest_desc: [
		"Roosts and caves often hold &edragon eggs&r. Take one while the parent is away (or dead)."
		"Fire eggs hatch in fire, ice eggs in water, lightning eggs under a stormy sky. The Bestiary has the details."
	]
	quest.2BDE79183100B325.title: "A Dragon of Your Own"
	quest.2C02B705A1D77304.quest_desc: [
		"A Hoardwarden is a wall that walks."
		""
		"Craft the &eEpic Knights&r knight cuirass, leggings and boots (steel plates, see JEI)."
	]
	quest.2C02B705A1D77304.title: "Plate and Rivet"
	quest.2C24B1B0D7AD514D.quest_desc: [
		"A druid to heal, a cleric to protect, a summoner to call more friends."
		""
		"Tame a &edruid&r, a &ecleric&r and a &esummoner&r familiar."
	]
	quest.2C24B1B0D7AD514D.title: "A Circle of Familiars"
	quest.2C517D8C33DA1861.quest_desc: [
		"Lanterns of every colour gather around one fire. Nobody speaks for a long time. Then someone says: 'The End.'"
		""
		"Gather your party. Next: the &eChaos Guardian&r in the End, then the Ender Dragon, then the summoning."
	]
	quest.2C517D8C33DA1861.title: "The War Council"
	quest.2C5908E869A4093D.quest_desc: [
		"A ring that once belonged to someone who sold out the stars."
		""
		"Obtain the &eSignet of the Betrayer&r (Iron's Spells, see JEI)."
	]
	quest.2C5908E869A4093D.title: "Signet of the Betrayer"
	quest.2C929056BB9A71CF.quest_desc: [
		"The green ring stayed, the ring of the Corps that came to Earth first."
		""
		"Optional, Green ring only: learn &eAegis&r and &eHammer of Light&r (Spectral Hub HUD). Your constructs cost less will."
	]
	quest.2C929056BB9A71CF.title: "The Green Answered"
	quest.2CF2DFB8C99B8834.quest_desc: [
		"Fill a block of &eFluid Tanks&r with water (a mechanical pump), heat it with Blaze Burners underneath, and put a &eSteam Engine&r on its side. It makes far more stress than any wheel."
		"Bigger boilers and more burners mean more engines. Ponder the Steam Engine for the full rules."
	]
	quest.2CF2DFB8C99B8834.title: "Steam Power"
	quest.2CFA23BB96D7B48C.quest_desc: [
		"&eMekanism&r is industry: machines that process ore, chemicals and energy. Almost all of them start with &eosmium&r."
		"Smelt some osmium ingots. JEI (press &eU&r on an item) shows every machine that uses it."
	]
	quest.2CFA23BB96D7B48C.quest_subtitle: "Mekanism"
	quest.2CFA23BB96D7B48C.title: "Osmium"
	quest.2D157E27E3566367.quest_desc: [
		"Far below, a city of the dead, wired with ears."
		""
		"Find an &eAncient City&r in the Deep Dark and sneak past a sculk sensor without setting it off."
	]
	quest.2D157E27E3566367.title: "Into the Deep Dark"
	quest.2D37821118C9B584.quest_desc: [
		"An altar that only wakes in the End, and an orb that remembers whoever holds it."
		""
		"Optional: get a &eShadow Altar&r and a &eShadow Orb&r (Dark Doppelganger, see JEI)."
	]
	quest.2D37821118C9B584.title: "The Shadow Altar"
	quest.2D436E09B88C915F.quest_desc: [
		"Evocation is the paladin's art: fangs from the ground, a shield of force, a summoned steed."
		""
		"Craft an &eEvocation Rune&r (see JEI). Look for &eFang Strike&r, &eFang Ward&r, &eShield&r and &eSummon Horse&r scrolls."
	]
	quest.2D436E09B88C915F.title: "Fang and Ward"
	quest.2DB9AA5C6A6A7DE6.quest_desc: [
		"You dream of running with a pack across an endless plain, and you can't tell which of the beasts is you."
		""
		"Reach &eIndigo level 25&r. Then the trial."
	]
	quest.2DB9AA5C6A6A7DE6.quest_subtitle: "Class level 25"
	quest.2DB9AA5C6A6A7DE6.title: "The Dream"
	quest.2E05DCF24A61C6CE.quest_desc: [
		"Under a mountain, an old factory still runs. Something inside is building itself."
		""
		"Find the &eAncient Factory&r (L_Ender's Cataclysm). An &eEye of Mech&r points the way."
	]
	quest.2E05DCF24A61C6CE.title: "The Ancient Factory"
	quest.2E4285D2EC0562C8.quest_desc: [
		"An &eEncased Fan&r blowing through something processes items in its path: through &9water&r it washes, through &clava or fire&r it smelts, through a campfire it smokes, through &bsoul fire&r it haunts."
		"Washing crushed ore gives extra nuggets. Put the fan beside a belt for a free furnace line."
	]
	quest.2E4285D2EC0562C8.title: "Wind Through Fire and Water"
	quest.2E8B455A4A07E874.quest_desc: [
		"A stone that falls up. Build a hull from it and your ship needs no balloon."
		""
		"Make &e16 Levitite&r (Create Aeronautics, see JEI) and build an airship that can carry the whole party."
	]
	quest.2E8B455A4A07E874.title: "Lighter Than Air"
	quest.2ED47A2E25D727E7.quest_desc: [
		"&eEmber's Floating Islands&r adds seventeen sky islands: amethyst rocks, a cherry shrine, a cemetery, camps, a steampunk island and a hut with its own waystone."
		"Find the &eHut with a Waystone&r and activate it: a free landing spot in the sky."
	]
	quest.2ED47A2E25D727E7.title: "Islands in the Sky"
	quest.2ED7BD0588C69B6C.quest_desc: [
		"Korugar is a darker world: the Dread Plains, the Fear Bogs, the Fear Spire and Sinestro's Watchtower. The Yellow light was born here, in fear and storms."
		"Reach it from deep space, by ring or by ship. Go armed."
	]
	quest.2ED7BD0588C69B6C.title: "Korugar"
	quest.2F7331C2531580DD.quest_desc: [
		"Violet hunts at night, where the dead don't stay buried."
		""
		"Optional: find a graveyard (The Graveyard mod). Come at night if you're brave."
	]
	quest.2F7331C2531580DD.title: "A Taste of the Void"
	quest.2FB5CC52F4BE55B9.quest_desc: [
		"On a &eSpace Station&r in the End waits &eThe Obliterator&r. No hit on it does more than 20 damage, it adapts to your attacks, and it heals if you leave it alone."
		"It can't be hurt while you fly or hold high ground: fight it on its own level, rings off."
	]
	quest.2FB5CC52F4BE55B9.title: "IV. The Obliterator"
	quest.2FDAFDFEC10078B7.quest_desc: [
		"The Warden is blind. It doesn't need eyes."
		""
		"Either &ekill the Warden&r, or outlast it: loot &e16 echo shards&r from the city while it hunts you."
	]
	quest.2FDAFDFEC10078B7.title: "Outlast the Warden"
	quest.303B6152FB3715C9.quest_desc: [
		"Old carved stones hum in many villages. Touch one and it remembers you."
		""
		"Right-click any &eWaystone&r you find to activate it; then you can travel between activated stones. Craft a &eWarp Stone&r to build your own waystones."
	]
	quest.303B6152FB3715C9.title: "Stones That Remember"
	quest.30899067516FC100.quest_desc: [
		"A weapon carved from the golem's heart."
		""
		"Claim &eThe Great Frost&r (see JEI)."
	]
	quest.30899067516FC100.title: "The Great Frost"
	quest.30C0E1FE88BC1DDF.quest_desc: [
		"The best of everything, and all of it yours."
		""
		"Unlock the &ePinnacle&r world tier (Apotheosis: a full Epic affix set and the Ender Dragon slain; CTRL+T switches tiers) and wear &6Mythic&r armor with every socket filled by perfect gems. Tick the checkmark when you do."
	]
	quest.30C0E1FE88BC1DDF.quest_subtitle: "Extreme gear"
	quest.30C0E1FE88BC1DDF.title: "Mythic Hoard"
	quest.30C95406029007B0.quest_desc: [
		"Some spells are paid in mana. Red pays in blood, and hits harder for it."
		""
		"Craft a &eBlood Rune&r (JEI). Blood spells like &eBlood Slash&r and &eDevour&r heal you as you hurt others."
	]
	quest.30C95406029007B0.title: "Blood Price"
	quest.30F4F56965DCD9FB.quest_desc: [
		"Book of Dragons species live in &eroosts&r: barren, cave, cliff, glade and wetland. Roost maps point the way to them."
		"Find a roost and step inside. Quietly."
	]
	quest.30F4F56965DCD9FB.title: "Find a Roost"
	quest.30FB9673AE4FF52F.quest_desc: [
		"A spellbook holds spells for good, and lets you cast them with mana instead of burning scrolls."
		""
		"Get any &eIron's Spells spellbook&r (craft one or loot it) and equip it in its curio slot. Pick and cast spells with the spell-wheel keybind (see Controls)."
	]
	quest.30FB9673AE4FF52F.title: "A Book of Your Own"
	quest.3114135D9FF5FD48.quest_desc: [
		"&eMouse Tweaks&r speeds up inventories. &eScroll the wheel&r over a stack to move items one at a time into the other inventory."
		"&eHold Shift and drag&r across slots to move many stacks at once. &eRight-click and drag&r to spread a stack evenly over several slots."
	]
	quest.3114135D9FF5FD48.title: "Faster Fingers"
	quest.311B254EFCB5ED7C.quest_desc: [
		"Green is the light of those who keep others safe, and that starts with knowing them."
		""
		"Optional: trade with a villager."
	]
	quest.311B254EFCB5ED7C.title: "A Taste of Will"
	quest.313D5F9A56CFE504.quest_desc: [
		"An &eEnergy Core&r is a giant multiblock battery that grows in tiers. Place the core with four &eEnergy Core Stabilizers&r around it, then build the shell its preview shows."
		"Energy Pylons move power in and out. One core can hold enough to run everything else in this chapter."
	]
	quest.313D5F9A56CFE504.title: "The Energy Core"
	quest.315F01947224A3A6.quest_desc: [
		"It is huge. It is armored. It never saw you."
		""
		"Kill the &eEnder Guardian&r in the Ruined Citadel. Strike from behind; dodge the void runes."
	]
	quest.315F01947224A3A6.title: "Assassinate the Guardian"
	quest.316EF1ACDC7E5F1A.quest_desc: [
		"Every chest is a promise."
		""
		"Open &e25 loot chests&r in structures (Lootr counts each one you open for yourself). Opening loot chests gives Orange XP."
	]
	quest.316EF1ACDC7E5F1A.title: "Treasure Hunter"
	quest.3171F9F01152DBDE.quest_desc: [
		"A &eModular Accumulator&r stores energy; stack several into one big battery. A &eTesla Coil&r charges items placed under it."
		"Store power by day so night-time machines keep running."
	]
	quest.3171F9F01152DBDE.title: "Store the Spark"
	quest.31745A40CBF5328D.quest_desc: [
		"&eApotheosis&r gives gear a &erarity&r (&fCommon&r, &aUncommon&r, &9Rare&r, &5Epic&r, &6Mythic&r) and random &eaffixes&r: bonus damage, life steal, crit, sockets, special effects on hit."
		"Read the &eChronicle of Shadows&r, Apotheosis's own guide: craft a book with a gold ingot. It explains every system in this chapter."
	]
	quest.31745A40CBF5328D.title: "Loot With a Pedigree"
	quest.31B69BEBEBA20614.quest_desc: [
		"Copper thread and storm-silk: robes that hum."
		""
		"Craft the full &eElectromancer&r set (Iron's Spells). It boosts lightning spell power and mana."
	]
	quest.31B69BEBEBA20614.title: "The Electromancer's Coat"
	quest.322031015C27349E.quest_desc: [
		"Deep in the troll caves, a Troll Vault holds the &eLamp of Cinders&r. Its flame burns away the thorns that wall off the last region."
		"Bring it out alive."
	]
	quest.322031015C27349E.title: "VI. The Lamp of Cinders"
	quest.32321ADFCBBCD09E.quest_desc: [
		"Blocking with &eShield Expansion&r costs stamina, and a well-timed block &eparries&r. Better shields block more before they break your guard and give a wider parry window."
		"Shields go wood, iron, gold, diamond, netherite. Parry a boss's big swing and you get a free opening."
	]
	quest.32321ADFCBBCD09E.quest_subtitle: "Shield Expansion"
	quest.32321ADFCBBCD09E.title: "A Better Guard"
	quest.323E7F57F56CDB32.quest_desc: [
		"Lay &eTrain Track&r, place a &eTrain Station&r, build a train on bogeys with &eTrain Casing&r and &eControls&r, then assemble it at the station."
		"Give it a &eSchedule&r and it runs on its own. A rail line between bases is a great party project."
	]
	quest.323E7F57F56CDB32.title: "All Aboard"
	quest.3246C3EBFC7D1AB3.quest_desc: [
		"The Gauntlet wakes when you step into its hall: a giant armored fist of the old Nether lords."
		""
		"Kill the &eNether Gauntlet&r in its blackstone arena in the Nether (the quest before helps you find it). Fire resistance helps. Party members within 64 blocks get the trial credit too."
	]
	quest.3246C3EBFC7D1AB3.quest_subtitle: "Ring trial: the boss"
	quest.3246C3EBFC7D1AB3.title: "&cThe Crucible of Rage"
	quest.324B012A8C25BD7F.quest_desc: [
		"On high peaks, &eTongbi&r sets a challenge: climb the stone pillar it raises while it hurls rocks at you."
		"Reach the top to win the Geomancer's gear. Optional for climbers."
	]
	quest.324B012A8C25BD7F.title: "Tongbi, the Sculptor"
	quest.325B876C2BCA6B1D.quest_desc: [
		"The &eAncient Codex&r is the best crafted spellbook: the most slots and the most mana."
		"A full Codex of Legendary spells is the mark of an archmage. The corruption fears it."
	]
	quest.325B876C2BCA6B1D.title: "The Ancient Codex"
	quest.32E392621FBEBED9.quest_desc: [
		"Redomesticate adds &epet enchantments&r: Health Boost, Fireproof, Healing Aura, Chain Lightning, Ore Scenting and more. Their books turn up in chests."
		"Look for &eTethered Teleport&r: waystones don't carry pets in this pack, but a tethered pet follows you anywhere, even across dimensions."
	]
	quest.32E392621FBEBED9.title: "Enchanted Companions"
	quest.32EF5F7D2F6B66E2.quest_desc: [
		"Even a berserker needs mana to throw fire."
		""
		"Craft the &eWandering Magician&r robe and pants (Iron's Spells). They add mana and spell power."
	]
	quest.32EF5F7D2F6B66E2.title: "Robes of the Wanderer"
	quest.331D70B63FEC281F.quest_desc: [
		"A &ePortable Engine&r burns fuel to make rotation right on your contraption, so propellers turn wherever you go."
		"Fill it with coal, charcoal or wood. Place and power one."
	]
	quest.331D70B63FEC281F.title: "An Engine That Flies"
	quest.3372AADE579E8035.quest_desc: [
		"Your breath fogs indoors. Frost creeps across your windows in summer."
		""
		"Craft an &eIce Rune&r (see JEI). Look for &eIce Block&r, &eFrostwave&r, &eRay of Frost&r and &eIce Tomb&r scrolls."
	]
	quest.3372AADE579E8035.title: "First Frost"
	quest.34173202C4338097.quest_desc: [
		"The light likes the sound of your blade. Give it more."
		""
		"Kill &e30 zombies&r and &e20 skeletons&r, ideally with your greatweapon. Red XP grows fastest from two-hander kills and fighting at low health."
	]
	quest.34173202C4338097.title: "First Blood"
	quest.341E17319D8504C7.quest_desc: [
		"Climb the &eDark Tower&r (carminite builders, ghastlings, towerwood borers) to the Ur-Ghast's chamber. Kill ghasts near a &eGhast Trap&r to drag it down."
		"Its Fiery Tears join the Hydra's blood for Fiery gear."
	]
	quest.341E17319D8504C7.title: "IV-b. The Ur-Ghast"
	quest.3429FBDC224B5856.quest_desc: [
		"Storage that doesn't touch the rest can still join: a &eStorage Link&r connects whatever it touches to a controller in range."
		""
		"&eStorage Input&r, &eOutput&r and &eI/O&r blocks open the whole network to hoppers, Create funnels and pipes. Feed your farm straight into the vault."
	]
	quest.3429FBDC224B5856.title: "Long Reach"
	quest.347233F755BC9DA7.quest_desc: [
		"Something huge is beating on the village walls."
		""
		"Optional: kill a &eMutant Zombie&r (Mutant Monsters). Burn it before it gets back up."
	]
	quest.347233F755BC9DA7.title: "Too Big to Bury"
	quest.34BC81A57C996B15.quest_desc: [
		"Knives are the cook's tool. Kill animals with one for extra cuts (ham, bacon), and use it on tall grass to gather &eStraw&r."
		"Start with flint; upgrade to iron, gold, diamond or netherite later."
	]
	quest.34BC81A57C996B15.title: "A Cook's Knife"
	quest.3507146111222F17.quest_desc: [
		"A raised shield at the right moment turns a killing blow into an opening."
		""
		"Craft an &eIron Shield&r (Shield Expansion). Block just as a hit lands to parry and stagger the attacker."
	]
	quest.3507146111222F17.title: "Parry!"
	quest.35281BFEFD168993.quest_desc: [
		"When the Devourer fell, the fleet that carried the Lanterns home was yours."
		""
		"Complete the Last Light and the Yellow path. The storm bows to you."
	]
	quest.35281BFEFD168993.quest_subtitle: "After the Last Light"
	quest.35281BFEFD168993.title: "&eLegend of the Yellow Light"
	quest.352BE091CB69CA55.quest_desc: [
		"&o\"No beast fights alone.\"&r"
		"Indigo is the light of compassion: a ranger and beast master with bow and summons, who tames, breeds and farms, bonds dragons and keeps familiars."
		""
		"Claim the reward to join Indigo and unlock its talent tree. You can still join other lights later."
	]
	quest.352BE091CB69CA55.quest_subtitle: "Join this light"
	quest.352BE091CB69CA55.title: "&9The Wildheart"
	quest.35597C2BED112815.quest_desc: [
		"In the End, crystal mountains float over the void, colder than any glacier."
		""
		"Fly to Nullscape's &eCrystal Peaks&r in the End's outer islands."
	]
	quest.35597C2BED112815.title: "Heart of Winter"
	quest.358575D46049BD70.quest_desc: [
		"A ghast as old as the forest cries at the top of a dark tower."
		""
		"Climb the &eDark Tower&r and kill the &eUr-Ghast&r. Destroy its tears. The trophy counts too."
	]
	quest.358575D46049BD70.title: "The Ur-Ghast"
	quest.35962FDF975D78EB.quest_desc: [
		"Moss and stone walk in the &eMossy Temple&r: the &eOvergrown Colossus&r. It's slow and it hits very hard."
		"Other Legendary bosses wait in the Cloudy Temple, the Ruined Pyramid, the Shulker Tower and the Skeletosaurus Nest."
	]
	quest.35962FDF975D78EB.title: "II. The Overgrown Colossus"
	quest.35DCA83A9AAB7427.quest_desc: [
		"Right-click a blaze with an &eEmpty Blaze Burner&r to catch it. Feed it fuel to heat the basin above; a &eBlaze Cake&r makes it superheated for a while."
		"Blazes live in Nether fortresses. A Central Power Battery keeps burners lit for free (see the Lanterns chapter)."
	]
	quest.35DCA83A9AAB7427.title: "A Blaze in a Cage"
	quest.362AE6AB138063AE.quest_desc: [
		"Nine blocks of each is a start. A true Hoardwarden's vault has no bottom."
		""
		"Make a &8Diamond to Netherite&r tier upgrade and a &eTier 4 Stack Upgrade&r (kept, not consumed). One netherite chest with those holds more than a dragon's lair."
		""
		"&7Optional: it doesn't hold up your path."
	]
	quest.362AE6AB138063AE.quest_subtitle: "Optional"
	quest.362AE6AB138063AE.title: "A Bottomless Hoard"
	quest.36B1FF2EFF4A47A8.quest_desc: [
		"A hungry guard is a dead guard. Stock the larder before the siege."
		""
		"Bring &e6&r of any one cooked food below. Smelt meat in a furnace, or craft bread from wheat. AppleSkin shows hunger and saturation on your HUD."
	]
	quest.36B1FF2EFF4A47A8.title: "Something to Eat"
	quest.36E219F5BA54FDAF.quest_desc: [
		"The Leviathan is the sea's oldest beast. It does not hate you. It is just hungry."
		""
		"Kill &eThe Leviathan&r in the Sunken City. Fight it underwater with the party; its tentacles grab and its beam burns."
	]
	quest.36E219F5BA54FDAF.title: "Leviathan"
	quest.36EDD4546670CEEA.quest_desc: [
		"An ancient fire-king's echo still burns, waiting for a challenger worthy of his scythe."
		""
		"Kill &eTyros&r, Iron's Spells' fire boss (see JEI for the &eCinderous Soulcaller&r and how to call him). One of the hardest fire fights in the pack: bring the party."
	]
	quest.36EDD4546670CEEA.title: "The Echo of Tyros"
	quest.36FB59925FCF8B9B.quest_desc: [
		"A &eSharestone&r is a waystone that links to every other sharestone of the same colour. Everyone can use it, so it's the easiest network for a party."
		"Pick a colour for your group (green suits the Corps) and put one at each base, farm and dungeon you use. Warp Plates and scrolls also travel for free."
	]
	quest.36FB59925FCF8B9B.title: "The Party Network"
	quest.370FF51A4E3C407D.quest_desc: [
		"Earth magic is patient: it shakes the ground, toughens the skin, and swallows enemies."
		""
		"Craft a &eNature Rune&r (see JEI). Orange's earth spells are &eEarthquake&r, &eStomp&r and &eOakskin&r; hunt for their scrolls."
	]
	quest.370FF51A4E3C407D.title: "Rune of the Deep Earth"
	quest.37150DFF6443489E.quest_desc: [
		"A &eCharger&r puts power into certus crystals. It needs energy: AE2 takes FE (from a Create alternator or Mekanism) through an Energy Acceptor, or you can crank it by hand."
		"Make Charged Certus Quartz."
	]
	quest.37150DFF6443489E.title: "Charged Certus"
	quest.3740EFEE1B14B1C6.quest_desc: [
		"&eEpic Knights&r adds medieval armour, shields and weapons, and most of it starts with &eSteel&r. Look up the Steel Ingot in JEI (press &eR&r) to see how it's made."
		"Steel also makes plates and chain for the heavier armours."
	]
	quest.3740EFEE1B14B1C6.quest_subtitle: "Epic Knights"
	quest.3740EFEE1B14B1C6.title: "The Smith's Metal"
	quest.376409C57EF41CCA.quest_desc: [
		"&o\"Your doom approaches.\"&r It caps every hit, adapts to your damage, and heals if you leave it alone."
		""
		"Optional: kill &eThe Obliterator&r. It is &cinvulnerable while you fly or hold high ground&r: fight it on foot, as a party."
	]
	quest.376409C57EF41CCA.title: "The Obliterator"
	quest.379605E26CF23304.quest_desc: [
		"The pharaoh's guardian: a skeleton the size of a temple, still guarding the gold."
		""
		"Kill the &eAncient Remnant&r deep in the Cursed Pyramid. Its sandstorms blind; fight it as a party."
	]
	quest.379605E26CF23304.title: "The Ancient Remnant"
	quest.37B03381095496C5.quest_desc: [
		"The &eAlchemist Cauldron&r brews elixirs (healing, evasion, invisibility, oakskin) and upgrades ink. Light a fire under it and fill it with water or ink."
		"It needs Cinder Essence, which the Ancient Knights of the old citadels drop."
	]
	quest.37B03381095496C5.title: "The Alchemist Cauldron"
	quest.37C508D5C6921284.quest_desc: [
		"The &eME Controller&r is the brain of the network. Power it through an &eEnergy Acceptor&r (FE in, AE out) and connect everything to it with cable."
		"Without a controller a small network still works, but with one you get many more channels."
	]
	quest.37C508D5C6921284.title: "The ME Controller"
	quest.37E07018C0D1AFEA.quest_desc: [
		"&eTrolls&r (forest, frost and mountain) live underground and turn to stone in sunlight. Lure one out at dawn, or fight it in its cave."
		"Their leather makes troll armour; their weapons are tree trunks and stone columns."
	]
	quest.37E07018C0D1AFEA.title: "Troll Hunt"
	quest.380E4D081B8C3972.quest_desc: [
		"Travellers gather where the ale flows, and so do rumours of treasure."
		""
		"Find a &eDungeons and Taverns&r tavern. Taverns sit near roads in most biomes; their traders sell maps to other structures."
	]
	quest.380E4D081B8C3972.title: "A Warm Tavern"
	quest.38951A087DFB8D92.quest_desc: [
		"Awakened draconium and Wyvern Cores fuse into a &eDraconic Core&r."
		"With it come Draconic injectors, Draconic energy crystals and Draconic gear."
	]
	quest.38951A087DFB8D92.title: "The Draconic Core"
	quest.38AB49D0D57D6ECC.quest_desc: [
		"The scythe of a dead king, still warm."
		""
		"Claim the &eDecrepit Scythe&r from Tyros."
	]
	quest.38AB49D0D57D6ECC.title: "The Decrepit Scythe"
	quest.38C0BA22A8ED9AFA.quest_desc: [
		"Every colour of stone, every rarity, all of it. Mine."
		""
		"Collect &e12 Apotheosis gems&r and a &eGem Case&r to keep them in."
	]
	quest.38C0BA22A8ED9AFA.title: "Gem Hoarder"
	quest.38C17D771861FB28.quest_desc: [
		"Upgrade your backpack in a crafting table to keep its contents: leather, then copper, iron, gold, diamond and netherite. Open it with &eB&r while you wear it."
		"Upgrades go in its side slots: &ePickup&r and &eMagnet&r grab loot, &eFeeding&r feeds you, and &eCrafting&r, &eSmelting&r and &eTool Swapper&r do what they say."
	]
	quest.38C17D771861FB28.quest_subtitle: "Sophisticated Backpacks"
	quest.38C17D771861FB28.title: "A Bigger Pack"
	quest.38C2C17418139BC4.quest_desc: [
		"The End island hasn't changed. The void around it has: something has been feeding there."
		""
		"Travel to &ethe End&r again (stronghold portal or an End Gateway)."
	]
	quest.38C2C17418139BC4.title: "Return to the End"
	quest.3918EB5A28D9957C.quest_desc: [
		"In the &eSnowy Forest&r, a cave holds the &eAlpha Yeti&r. It throws ice and pounds the ground: watch for falling icicles."
		"Its fur makes Yeti armour, and its death opens the Glacier."
	]
	quest.3918EB5A28D9957C.title: "III-c. The Alpha Yeti"
	quest.393E219782FBBE11.quest_desc: [
		"&eJEI&r is the item list beside your inventory. Hover any item and press &eR&r for its recipes, or &eU&r for what uses it."
		"Search with the bar at the bottom. Start with &e@&r to search a mod (&e@create&r, &e@irons&r). Press &eA&r over an item to bookmark it."
		"Stuck on a quest? Look the item up in JEI first."
	]
	quest.393E219782FBBE11.quest_subtitle: "Every recipe, one key away"
	quest.393E219782FBBE11.title: "Just Enough Items"
	quest.394C31B5D56BD25E.quest_desc: [
		"&eWhen Dungeons Arise&r builds huge dungeons: the Foundry, Mechanical Nest, Plague Asylum, Coliseum, Shiraz Palace, Thornborn Towers and more."
		"Start small: an &eIllager Campsite&r. The big ones take a full party and a full evening."
	]
	quest.394C31B5D56BD25E.title: "When Dungeons Arise"
	quest.395A718A1B183C3C.quest_desc: [
		"Every storm starts as a breeze."
		""
		"Power your first machine: place a &eWater Wheel&r in flowing water or build a &eWindmill&r on a Windmill Bearing."
	]
	quest.395A718A1B183C3C.title: "Spark Plug"
	quest.397CD37A58E6EAA6.quest_desc: [
		"Maledictus: a cursed warlord with a phantom army and a grudge older than the ice."
		""
		"Kill &eMaledictus&r in the Frosted Prison. He summons phantom weapons; keep moving and fight as a party."
	]
	quest.397CD37A58E6EAA6.title: "Prison of Curses"
	quest.398BA86B092F2DE7.quest_desc: [
		"With the Hydra, the Ur-Ghast and the Snow Queen all dead, the &eHighlands&r welcome you."
		"Troll caves wind beneath them, and giants walk in the clouds above."
	]
	quest.398BA86B092F2DE7.title: "V. The Highlands Open"
	quest.39F4E53D2CD1B1E4.quest_desc: [
		"&eGalosphere&r adds three cave biomes: &dCrystal Canyons&r (huge crystal clusters), &aLichen Caves&r and &dPink Salt Caves&r."
		"They lie deep underground. A title shows on screen when you walk into one."
	]
	quest.39F4E53D2CD1B1E4.quest_subtitle: "Galosphere"
	quest.39F4E53D2CD1B1E4.title: "Crystal Canyons"
	quest.3A006E0FB26A4B43.quest_desc: [
		"The Warband answers to one man: &cWarlord Vex&r, a hulking pillager captain with a boss bar of his own."
		""
		"Storm the camp (or catch him in the raid) and kill him. Anyone in your party within 64 blocks gets the credit."
	]
	quest.3A006E0FB26A4B43.quest_subtitle: "Warlord Vex"
	quest.3A006E0FB26A4B43.title: "Head of the Snake"
	quest.3A1E0FB18B8E1004.quest_desc: [
		"You know the tools. Now pick a chapter: magic, dragons, machines, monsters. Follow whatever you and your friends enjoy most."
		"The Lantern Corps reward those who keep going. So does this book."
	]
	quest.3A1E0FB18B8E1004.title: "Ready for the Road"
	quest.3A1F365762BC75BE.quest_desc: [
		"Press &eK&r to open your skill trees (Pufferfish's Skills). The &eAdventurer&r tree is open to everyone: you earn its points by fighting, exploring and beating bosses."
		"Each class you join unlocks its own tree. Hover a node to read it, click to spend a point. Some quests in these guides give skill XP too."
	]
	quest.3A1F365762BC75BE.quest_subtitle: "Press K"
	quest.3A1F365762BC75BE.title: "The Skill Tree"
	quest.3A459FF8B1DB63A9.quest_desc: [
		"Six dead knights still guard their stronghold in the dark forest."
		""
		"Kill all &e6 Knight Phantoms&r in the &eKnight Stronghold&r. The trophy counts too."
	]
	quest.3A459FF8B1DB63A9.title: "The Knight Phantoms"
	quest.3A71D28030F1BAB9.quest_desc: [
		"Armor for your winged steed."
		""
		"Craft &eHippogryph Armor&r (iron or better)."
	]
	quest.3A71D28030F1BAB9.title: "Barding for the Sky"
	quest.3ABEA8EF80C1F8D9.quest_desc: [
		"Quest progress belongs to your &eFTB Team&r. Make one with the team button in your inventory (the small icons at the top left) or &e/ftbteams party create <name>&r, then &e/ftbteams party invite <player>&r."
		"Team members share quest progress, but each member claims their own rewards, so nobody misses out."
	]
	quest.3ABEA8EF80C1F8D9.quest_subtitle: "Shared quest progress"
	quest.3ABEA8EF80C1F8D9.title: "Form a Team"
	quest.3B1C74E3DC0DC181.quest_desc: [
		"The &eNight Fury&r is the rarest and fastest of them all. Few have seen one; fewer have tamed one."
		"Optional, and a long hunt."
	]
	quest.3B1C74E3DC0DC181.title: "The Unholy Offspring of Lightning and Death"
	quest.3B42585CBAE25EAE.quest_desc: [
		"Lighter than steel, harder than diamond, and only found very, very deep."
		""
		"Mine &eMithril&r ore deep underground (Iron's Spells) and smelt &e4 mithril ingots&r."
	]
	quest.3B42585CBAE25EAE.title: "Mithril"
	quest.3B4EAE8DFDD4F288.quest_desc: [
		"The heaviest mage armor there is. A paladin's kind of robe."
		""
		"Craft the full &eNetherite Battlemage&r set (Iron's Spells)."
	]
	quest.3B4EAE8DFDD4F288.title: "Netherite Battlemage"
	quest.3B50262A28ADB79B.quest_desc: [
		"Whole lands float above the clouds, with forests, rivers and their own seasons."
		""
		"Visit one of Terralith's &eSkylands&r biomes (spring, summer, autumn or winter)."
	]
	quest.3B50262A28ADB79B.title: "Skylands"
	quest.3B53A6D07EA4A87A.quest_desc: [
		"The &eNetherite Shield&r is the strongest guard in the pack. It won't burn if you drop it in lava, and it shrugs off most things short of a boss."
		"Tanks: pair it with heavy plate and stand in front of your party."
	]
	quest.3B53A6D07EA4A87A.title: "Unbreakable Guard"
	quest.3B551359B6C3D18C.quest_desc: [
		"A ring found you. Orange, White or Black, you are a &eLantern&r now: you can fly, and your will takes shape as constructs."
		""
		"This completes when this light's trial gives you your ring: its own colour, White or Black. The Orange path continues; the &6Last Light&r chapter has opened."
	]
	quest.3B551359B6C3D18C.quest_subtitle: "Ring-bearer"
	quest.3B551359B6C3D18C.title: "&6Ring-Bearer"
	quest.3BA580E77CD84085.quest_desc: [
		"The Hydra's last head sinks into the mud, and an indigo light rises like a breath on a cold morning."
		"Can you feel another's pain as your own?"
		""
		"Claim this reward to begin the &ering trial&r: a conversation in chat. The ring will judge you. Your &eanswers&r decide whether you receive your own light, the &fWhite&r, or the &8Black&r. Answer as who you really are."
		"&7(Only works once you have the trial credit from the quest before.)"
	]
	quest.3BA580E77CD84085.quest_subtitle: "The ring will judge you"
	quest.3BA580E77CD84085.title: "The Ring Judges"
	quest.3BEDC0599E6B6C89.quest_desc: [
		"The red ring stayed. It burns under your skin like a second heartbeat."
		""
		"Optional, Red ring only: learn your powers &eHellbolt&r and &eInferno&r (see the Spectral Hub HUD), and recharge at a Red Lantern."
	]
	quest.3BEDC0599E6B6C89.title: "The Red Answered"
	quest.3BF46C9EFECDA2B9.quest_desc: [
		"A ring is only as strong as its last charge."
		""
		"Optional: recharge your ring at a Lantern of its colour (or at the Central Power Battery on Oa, if your fleet can reach it)."
	]
	quest.3BF46C9EFECDA2B9.title: "Recharge"
	quest.3C37C2BD3E45DBCC.quest_desc: [
		"Steel quenched in a storm dragon's blood."
		""
		"Smelt &e4 lightning dragonsteel ingots&r in a Lightning Dragonforge (Ice and Fire, see JEI)."
	]
	quest.3C37C2BD3E45DBCC.title: "Lightning Dragonsteel"
	quest.3C4ED23396BF4CA9.quest_desc: [
		"High above the land, WDA's &eHeavenly&r sky fortresses (Rider, Challenger, Conqueror) float at cloud height."
		"You'll need a way up: a balloon (Create Aeronautics), an elytra, or a very tall tower. Don't fall off."
	]
	quest.3C4ED23396BF4CA9.title: "Fortress in the Clouds"
	quest.3C87BED9F9E36848.quest_desc: [
		"The horn sounds three times. Torches on the ridge. They are coming."
		""
		"When the countdown ends the raid hits the village. Survive every wave &oas a party&r and earn &eHero of the Village&r. Villagers must be alive for the raid to count."
	]
	quest.3C87BED9F9E36848.quest_subtitle: "The Warband marches"
	quest.3C87BED9F9E36848.title: "Day Seven"
	quest.3CD7945E9E85193A.quest_desc: [
		"Three altars (Sword, Maw and Bat) summon &eShade&r bosses when you activate them with &eCrystallized Blood&r."
		"Defeat the &eShade Maw&r. Optional, and not a fight for one."
	]
	quest.3CD7945E9E85193A.title: "The Shade Altars"
	quest.3CF5878B6C8899A8.quest_desc: [
		"No dragon for you. You'll build your wings."
		""
		"Craft a &eHot Air Burner&r and &e8 hot air envelopes&r (Create Aeronautics). Build a balloon, assemble it with a &ePhysics Assembler&r (Simulated) and take off. Bring a friend as crew."
	]
	quest.3CF5878B6C8899A8.title: "Lift-Off"
	quest.3CF93E872F112D0B.quest_desc: [
		"A &eSteering Wheel&r turns your ship by hand: grab it and spin. A &eThrottle Lever&r sets engine power, and linked receivers let you fly from a cockpit."
		"Grab and spin a Steering Wheel."
	]
	quest.3CF93E872F112D0B.title: "Hands on the Wheel"
	quest.3D602CC37C25D64A.quest_desc: [
		"The village is safe, for now. The Lantern's warning isn't. The Guardians want warriors, and warriors are made, not born."
		""
		"This chapter teaches the pack's essentials. Party up: dungeons are friendlier with friends."
	]
	quest.3D602CC37C25D64A.title: "Proving Ground"
	quest.3D91E7DDBF619B69.quest_desc: [
		"The crystal still holds the Frostmaw's breath."
		""
		"Claim the &eIce Crystal&r. Use it to breathe frost yourself."
	]
	quest.3D91E7DDBF619B69.title: "Heart of the Beast"
	quest.3D995FB0B5EF68AB.quest_desc: [
		"Your own dragon's breath, caught in a forge of ice."
		""
		"Build an &eIce Dragonforge&r and fuel it with your grown ice dragon's breath. Smelt &e4 ice dragonsteel ingots&r."
	]
	quest.3D995FB0B5EF68AB.title: "Ice Dragonsteel"
	quest.3DB0FF5B45E4B250.quest_desc: [
		"A village that trusts you is a village that fights beside you."
		""
		"Trade until you hold &e32 emeralds&r. Every trade earns Green XP."
	]
	quest.3DB0FF5B45E4B250.title: "Friend of the Village"
	quest.3DDEF31A1820C9B1.quest_desc: [
		"On the glacier, a palace of aurora, and a queen who has never been warm."
		""
		"Kill the &eSnow Queen&r at the top of the &eAurora Palace&r. The trophy counts too."
	]
	quest.3DDEF31A1820C9B1.title: "The Snow Queen"
	quest.3DEC395F71CBFAA9.quest_desc: [
		"A flaming colosseum where a fallen knight still duels the dead."
		""
		"Find the &eBurning Arena&r (Cataclysm) in the Nether. An &eEye of Flame&r points the way if you have one."
	]
	quest.3DEC395F71CBFAA9.title: "The Burning Arena"
	quest.3E02F4A3535A33E8.quest_desc: [
		"Eat a course of every meal Farmer's Delight can make. It takes every crop, every pot recipe and a few feasts."
		"A well-fed party is a party that survives the Blood Moon."
	]
	quest.3E02F4A3535A33E8.title: "Master Chef"
	quest.3E63C9B6F8DCE22D.quest_desc: [
		"Better spellbooks hold more spells and add mana. The ladder goes Flimsy Journal, &eIronbound Tome&r, Apprentice's Spell Book, Enchanted Spell Book, Ancient Codex."
		"Unique books (Necronomicon, Druidic Tome, Frostbranded Book...) come from bosses and dungeons and boost one school. Get an Ironbound Tome."
	]
	quest.3E63C9B6F8DCE22D.title: "A Bigger Book"
	quest.3F19BD4F10ED15EA.quest_desc: [
		"Fuse draconium with the Dragon Heart's power and it &eawakens&r: a much stronger metal that glows with dragon fire."
		"Awakened Draconium goes into every Draconic-tier item."
	]
	quest.3F19BD4F10ED15EA.title: "Awakened Draconium"
	quest.3FABA7B06F979873.quest_desc: [
		"A worn book of village prayers, still warm with faith."
		""
		"Get the &eVillager Bible&r spellbook (Iron's Spells, see JEI). It favours holy spells."
	]
	quest.3FABA7B06F979873.title: "The Villager Bible"
	quest.401D599376786D79.quest_desc: [
		"The Forest has its own materials. &eIronwood&r (from raw ironwood found in hollow trees and chests) and &eSteeleaf&r (from steeleaf plants) make sturdy early armour and tools."
		"Hollow hills hold ore and treasure, guarded by redcaps."
	]
	quest.401D599376786D79.title: "Twilight Metals"
	quest.40B02B3592E9B845.quest_desc: [
		"Something enormous lives in the void under the End islands. The &eVoid Worm&r can be called up there (its dictionary page says how), and it splits into pieces when hurt."
		"Kill every piece. Its parts make the &eDimensional Carver&r, a portal you can carry."
	]
	quest.40B02B3592E9B845.title: "The Void Worm"
	quest.40DFF024CA3B3563.quest_desc: [
		"She dropped her thunder. Pick it up."
		""
		"Claim &eCeraunus&r or &eAstrape&r, Scylla's storm weapons."
	]
	quest.40DFF024CA3B3563.title: "Spear of the Storm"
	quest.410920EFEE631C53.quest_desc: [
		"&eFarmer's Delight&r adds four crops: &acabbage&r, &ctomato&r, &6onion&r and &frice&r. They grow wild across many biomes (fields, beaches, swamps, riverbanks)."
		"Break the wild plants for seeds, or check village chests."
	]
	quest.410920EFEE631C53.title: "Crops of the Wild"
	quest.41308D6BDB42C63C.quest_desc: [
		"Machines need rotation. A &eWater Wheel&r on a shaft beside flowing water makes it; a windmill bearing with sails makes more."
		"Every source has a &estress capacity&r (SU), and every machine uses some. Goggles and a Stressometer show how much you have left."
	]
	quest.41308D6BDB42C63C.title: "Power From the River"
	quest.41722EC03995F59B.quest_desc: [
		"An old woman swears the ruins hold 'paper that burns without fire'. Magic is real here."
		""
		"Find any &eIron's Spells scroll&r in chests (village houses, ruins, dungeons). Right-click it to cast its spell once."
	]
	quest.41722EC03995F59B.title: "Whispers on Paper"
	quest.4173CDC6BD4DDD01.quest_desc: [
		"&eMowzie's Mobs&r adds handcrafted mini-bosses (you may already have met the Ferrous Wroughtnaut). In the savanna, masked Umvuthana guard their chief in a hidden &egrove&r."
		"Defeat &eUmvuthi&r. Kill the masked followers first; the chief calls the sun down on you."
	]
	quest.4173CDC6BD4DDD01.quest_subtitle: "Mowzie's Mobs"
	quest.4173CDC6BD4DDD01.title: "Umvuthi, the Sunbird"
	quest.417DD7ABCC04D54B.quest_desc: [
		"The &eMutant Skeleton&r fires volleys of arrows and leaves its bones behind."
		"Its ribs, skull and limbs craft into &eMutant Skeleton armour&r."
	]
	quest.417DD7ABCC04D54B.title: "Bones of a Giant"
	quest.418812DFB57AF3F8.quest_desc: [
		"Special shelves push the stats much further than wood. The &eHellshelf&r comes from the Nether."
		"Mix shelves: each kind adds different amounts of Eterna, Quanta and Arcana. JEI (press &eU&r on a shelf) shows them."
	]
	quest.418812DFB57AF3F8.title: "Shelves of Fire"
	quest.422190F6EF35CE7F.quest_desc: [
		"Good armor has room for treasure."
		""
		"Get a &eSigil of Socketing&r and add a socket to your gear at a smithing table, then set a gem in it. Socketing gems gives Orange XP."
	]
	quest.422190F6EF35CE7F.title: "A Setting for Every Stone"
	quest.4226B5451ED18586.quest_desc: [
		"The indigo ring stayed. Any lantern's light will feed it now."
		""
		"Optional, Indigo ring only: learn &ePack Leap&r and &eSwap with your beast&r (Spectral Hub HUD)."
	]
	quest.4226B5451ED18586.title: "The Indigo Answered"
	quest.42EB62F6D5CCE173.quest_desc: [
		"A &eMana Upgrade Orb&r (arcane runes) raises your maximum mana; a school orb raises that school's spell power. Apply them at the Arcane Anvil."
		"Each piece of gear takes a limited number of upgrades. Pick the orbs that match your class."
	]
	quest.42EB62F6D5CCE173.title: "More Mana"
	quest.433A3B752D8E180E.quest_desc: [
		"Stone that flowers. Armor that casts."
		""
		"Craft the &eBloom Stone&r mage set (Cataclysm: Spellbooks, see JEI): hat, chestplate, skirt and greaves. Orange's earth-school armor."
	]
	quest.433A3B752D8E180E.title: "Bloom Stone Regalia"
	quest.4390FD0DBE8598BC.quest_desc: [
		"&o\"Mine.\"&r"
		"Orange is the light of the hoard: an earth-magic tank in heavy plate, who digs deep, loots everything and cuts gems."
		""
		"Claim the reward to join Orange and unlock its talent tree. You can still join other lights later."
	]
	quest.4390FD0DBE8598BC.quest_subtitle: "Join this light"
	quest.4390FD0DBE8598BC.title: "&6The Hoardwarden"
	quest.43AB103215A8C63F.quest_desc: [
		"&eAppleSkin&r shows how much a food will restore on your hunger bar, and your hidden &esaturation&r (the yellow outline)."
		"Saturation keeps you healing in a long fight. Farmer's Delight meals have the most; see the Farming chapter. Carry real food, not just raw meat."
	]
	quest.43AB103215A8C63F.title: "Eat Well, Fight Well"
	quest.43D584811F015042.quest_desc: [
		"Fire, water, pressure. Real power at last."
		""
		"Build a &eSteam Engine&r on a heated Fluid Tank (Create)."
	]
	quest.43D584811F015042.title: "Full Steam"
	quest.4428B46FAA6F2B38.quest_desc: [
		"At the heart of the cult waits the &5Ascended One&r, one of the deadliest mages in the world. Its fall opens the way to the eldritch arts (Eldritch Soulshards, the Apocrypha, demonic weapons)."
		"An extreme fight. Bring your best book, your best robes and your whole party."
	]
	quest.4428B46FAA6F2B38.title: "The Ascended One"
	quest.444339F7215B5BB3.quest_desc: [
		"When the Devourer fell, the Hoardwarden held the line, and then picked up everything it dropped."
		""
		"Complete the Last Light and the Orange path. The hoard is yours."
	]
	quest.444339F7215B5BB3.quest_subtitle: "After the Last Light"
	quest.444339F7215B5BB3.title: "&6Legend of the Orange Light"
	quest.4470410443BFCE80.quest_desc: [
		"A &eMagic Map&r shows the Forest's biomes and marks boss structures. Make the focus from a raven feather and torchberries, then the map."
		"Optional, but it saves hours of wandering."
	]
	quest.4470410443BFCE80.title: "A Map of Twilight"
	quest.4499E4D28A76D2DA.quest_desc: [
		"Eldritch cults gather in hidden places: the &eCultist Base&r, blood cultist huts and the Electromancer Tower. Their apostles and acolytes cast forbidden spells."
		"Find a Cultist Base. Read their &eGuardian's Guidebook&r if you find one: it is this addon's guide."
	]
	quest.4499E4D28A76D2DA.title: "Discerning the Eldritch"
	quest.449CD85FB94FBE59.quest_desc: [
		"The corruption breeds monsters. This ladder runs left to right: &fI&r early, &aII&r mid, &9III&r late, &5IV&r extreme. Each row is one mod's line of bosses."
		"&eCo-op:&r boss kills count for everyone in your team; chests use Lootr, so each player gets their own loot. If you die, your corpse waits for you, and a friend can carry it out."
	]
	quest.449CD85FB94FBE59.quest_subtitle: "How to read this ladder"
	quest.449CD85FB94FBE59.title: "The Bestiary of Ruin"
	quest.45BF99755114F784.quest_desc: [
		"Call bigger things."
		""
		"Upgrade to a &eGreater Conjurer's Talisman&r."
	]
	quest.45BF99755114F784.title: "Greater Conjuring"
	quest.45E7FE276D6092BF.quest_desc: [
		"Hearty meals give &eNourishment&r: your food bar stops dropping (except while you heal). Soups and stews give &eComfort&r: you regenerate however hungry you are."
		"Eat one before a long dungeon. AppleSkin shows how much each meal restores."
	]
	quest.45E7FE276D6092BF.title: "Nourishment and Comfort"
	quest.45EDBAFE5385B1CF.quest_desc: [
		"A long blade is a warning. A short one is an answer."
		""
		"Craft any dagger below. Daggers strike fast; sneak attacks with them earn double Violet XP."
	]
	quest.45EDBAFE5385B1CF.title: "Silent Steel"
	quest.45FC56A04D3CC373.quest_desc: [
		"Surround a &eBlank Runestone&r with eight focus items of one school to make that school's &erune&r. Eight runes around an &eEmpty Upgrade Orb&r make a school orb."
		"The empty orb takes arcane ingots, cinder essence and mithril. Make one."
	]
	quest.45FC56A04D3CC373.title: "Runes and Orbs"
	quest.4621B62FA19861EB.quest_desc: [
		"A &ePropeller Bearing&r builds a big propeller from the blocks you attach in front of it (sails work well). More blades, more thrust."
		"The &eGyroscopic Propeller Bearing&r tilts to stay upright: ideal for helicopters. Air gets thinner the higher you go, so engines lose power near the ceiling."
	]
	quest.4621B62FA19861EB.title: "In Thrust We Trust"
	quest.4623BD0C3EC08ED7.quest_desc: [
		"The full &eReforging Table&r works on every rarity, up to Mythic. Higher rarities cost rarer materials."
		"Reforge the weapon you plan to keep through the late game."
	]
	quest.4623BD0C3EC08ED7.title: "The Reforging Table"
	quest.4697BC3064184895.quest_desc: [
		"&eDungeons Weapons&r brings gear from Minecraft Dungeons: claymores, daggers, double axes, maces, sickles, anchors and great hammers."
		"Gold-named versions (Firebrand, Stormlander, Sun's Grace, Nightmare's Bite) are rare finds with extra powers. Keep an eye on your loot."
	]
	quest.4697BC3064184895.title: "Weapons From Another Game"
	quest.46CECEEFBE4B9B2B.quest_desc: [
		"&eCompanions!&r adds odd allies and their homes: the Teddy Tower, the Monkey Temple, Baba Yaga's hut, a factory and a traveller's tent."
		"Hatch a &eCroissant Dragon&r from its egg, collect copper, Nether and End coins, and see what the Frog Bonanza does with them. Visit a Teddy Tower."
	]
	quest.46CECEEFBE4B9B2B.quest_subtitle: "Companions!"
	quest.46CECEEFBE4B9B2B.title: "Strange Companions"
	quest.473E9DBF0FC2870F.quest_desc: [
		"Once it trusts you, climb on. A wild dragon bucks: hold on until it calms down, and it's yours."
		"Bind it to a &eRattlestaff&r or &eDragon Whistle&r to call and command it."
	]
	quest.473E9DBF0FC2870F.title: "Hold On Tight"
	quest.47432867DAC9308A.quest_desc: [
		"Crystal magic, bound in silver."
		""
		"Craft the &eSterling Tome&r (Galosphere: Spellbooks, see JEI). It favours Blue's crystal spells."
	]
	quest.47432867DAC9308A.title: "The Sterling Tome"
	quest.474FF24DAA3CD72A.quest_desc: [
		"School armour boosts one school's power and your mana: &cPyromancer&r, &bCryomancer&r, &eElectromancer&r, &6Priest&r, &5Shadow-Walker&r, &4Cultist&r, &aPlagued&r, &fArchevoker&r, and the all-round Wizard robes."
		"Most need &eArcane Cloth&r. Craft or loot a set for your school."
	]
	quest.474FF24DAA3CD72A.title: "Robes of Your School"
	quest.4776CFB8245FC9ED.quest_desc: [
		"The stars come back, one by one. Somewhere on Oa, the Guardians write your names in light."
		""
		"You did it. The Epilogue's extreme bosses are optional: for those who want more."
	]
	quest.4776CFB8245FC9ED.quest_subtitle: "Epilogue"
	quest.4776CFB8245FC9ED.title: "Afterglow"
	quest.47989AA8B17C9DE8.quest_desc: [
		"The &eDraconic Reactor&r makes more power than anything else in the game, and if you run it wrong it explodes and wipes out everything around it."
		"Optional. Read up first, build it far from home and from your friends' bases, and never leave it unwatched."
	]
	quest.47989AA8B17C9DE8.title: "The Draconic Reactor"
	quest.479E7C43116EAF6B.quest_desc: [
		"Your dragon can wear armour too: head, neck, body and tail pieces in iron, gold, diamond, netherite, silver or dragonsteel."
		"Armour it before you take it into a boss fight."
	]
	quest.479E7C43116EAF6B.title: "Armour for a Dragon"
	quest.47AD8C9420FF2818.quest_desc: [
		"You dream of a red planet under a red sun, and of a ring that tastes like iron."
		""
		"Reach &eRed level 25&r. Then the trial."
	]
	quest.47AD8C9420FF2818.quest_subtitle: "Class level 25"
	quest.47AD8C9420FF2818.title: "The Dream"
	quest.4815C4F1359E41EB.quest_desc: [
		"Drink it and your skin hardens into living wood."
		""
		"Brew an &eOakskin Elixir&r (Iron's Spells alchemy, see JEI). Great before a boss."
	]
	quest.4815C4F1359E41EB.title: "Skin Like Bark"
	quest.4831BBC7DBAE7D59.quest_desc: [
		"An Epic Knights &elance&r hits much harder from horseback: a mounted charge can break a raider line. Zweihanders, flails, pikes and halberds are slow but brutal on foot."
		"Optional, but a knight on a horse is a fine sight."
	]
	quest.4831BBC7DBAE7D59.title: "Lances and Two-Handers"
	quest.485CA0D160F4CB53.quest_desc: [
		"In the &eSwamp&r lies a Labyrinth. A Maze Map helps; minotaurs roam its halls. The &eMinoshroom&r at its heart charges like a bull."
		"It drops a Minotaur Axe and &eMeef Stroganoff&r. Eat the stroganoff: the Fire Swamp beyond needs it."
	]
	quest.485CA0D160F4CB53.title: "III-a. The Minoshroom"
	quest.487B03288CED39F6.quest_desc: [
		"The first tier of draconic power."
		""
		"Craft a &eWyvern Core&r and the &eWyvern Chestpiece&r at the Fusion Crafting Core (Draconic Evolution, see its Information Tablet)."
	]
	quest.487B03288CED39F6.title: "Wyvern"
	quest.4884995A80241E83.quest_desc: [
		"A ring found you. Indigo, White or Black, you are a &eLantern&r now: you can fly, and your will takes shape as constructs."
		""
		"This completes when this light's trial gives you your ring: its own colour, White or Black. The Indigo path continues; the &6Last Light&r chapter has opened."
	]
	quest.4884995A80241E83.quest_subtitle: "Ring-bearer"
	quest.4884995A80241E83.title: "&9Ring-Bearer"
	quest.48A4D05E80DA307A.quest_desc: [
		"Three heads breathing fire across a burning swamp."
		""
		"Kill the &eHydra&r in its lair in the Fire Swamp. Bring fire resistance. The trophy counts too."
	]
	quest.48A4D05E80DA307A.title: "The Fire Swamp Hydra"
	quest.48EA6271CE4DF52E.quest_desc: [
		"&eWDA: Seven Seas&r launches warships onto the oceans: the Victory Frigate, Unicorn Galleon, Corsair Corvette and Pirate Junk."
		"Board a Victory Frigate. Watch for cannons, and bring a boat in case you have to leave in a hurry."
	]
	quest.48EA6271CE4DF52E.title: "Pirates on the Horizon"
	quest.48ED16F24901F306.quest_desc: [
		"In snowy lands a giant white ape sleeps, often clutching an &eIce Crystal&r. Wake it and it fights with ice breath and ground slams."
		"Keep moving to dodge the ice breath, and bring a ranged weapon. Frostbinders will want that crystal."
	]
	quest.48ED16F24901F306.title: "Frostmaw"
	quest.49363DC1B5982350.quest_desc: [
		"Wyvern tools are powered by energy, mine huge areas at once and never break while charged."
		"Make a Wyvern Pickaxe."
	]
	quest.49363DC1B5982350.title: "Wyvern Tools"
	quest.499BC04DBAB0C257.quest_desc: [
		"A paladin who swore your oath once. Something else holds his sword now."
		""
		"Defeat the &ePossessed Paladin&r (Legendary Monsters). Its &eGuide Book&r and structure advancements show where he waits."
	]
	quest.499BC04DBAB0C257.title: "The Fallen Paladin"
	quest.49D3F64B0581741A.quest_desc: [
		"Charred hills, melted sand, a smell of burnt gold. A fire dragon lives here."
		""
		"Find a &efire dragon&r roost or cave (Ice and Fire), in hot or temperate lands. Scout it; don't wake an adult alone."
	]
	quest.49D3F64B0581741A.title: "Ash and Embers"
	quest.4A9EDA15CF5EFDD5.quest_desc: [
		"Fire is the oldest rage. Learn to carry it."
		""
		"Craft a &eFire Rune&r (blank runestone + fire ingredients, see JEI). Runes are the base of every fire-school item. Look for &eFireball&r and &eBurning Dash&r scrolls."
	]
	quest.4A9EDA15CF5EFDD5.title: "Kindling"
	quest.4AA25BB8BF76A321.quest_desc: [
		"A giant of moss and stone, the forest's anger given legs."
		""
		"Defeat the &eOvergrown Colossus&r (Legendary Monsters). Its &eGuide Book&r and structure advancements show where it sleeps."
	]
	quest.4AA25BB8BF76A321.title: "The Overgrown Colossus"
	quest.4AA50782E9120B3B.quest_desc: [
		"Keep flying with your dragon, feeding it and fighting beside it, and the two of you bond."
		"A bonded dragon is a partner, not a pet. Wildhearts know the difference."
	]
	quest.4AA50782E9120B3B.title: "A True Bond"
	quest.4ABA87F568949DC7.quest_desc: [
		"Every device uses a &echannel&r. Normal cable carries 8, dense cable 32, and each face of the controller sends out 32. Run out and devices go dark."
		"A &eNetwork Tool&r shows channel use. Fluix glass cable is the place to start."
	]
	quest.4ABA87F568949DC7.title: "Cables and Channels"
	quest.4AD73DCC91DC3FB8.quest_desc: [
		"An old geomancer shapes pillars of stone and dares travellers to climb them."
		""
		"Find Mowzie's &eSculptor&r and beat his challenge (climb while he attacks). His prize is the &eEarthrend Gauntlet&r."
	]
	quest.4AD73DCC91DC3FB8.title: "Earthrend"
	quest.4AEDE533563EC49A.quest_desc: [
		"A spellbook bound in blaze-hide, warm to the touch, hungry for spells."
		""
		"Get the &eBlaze Instruction Manual&r, the fire school's spellbook (see JEI). Move your spells into it at the Inscription Table."
	]
	quest.4AEDE533563EC49A.title: "The Blaze Instruction Manual"
	quest.4B182067015DB71B.quest_desc: [
		"Friends share danger, not loot. The chests here remember who opened them."
		""
		"Open a structure chest. With &eLootr&r every player gets their own loot from each chest, so nobody steals from the party."
	]
	quest.4B182067015DB71B.title: "Yours Alone"
	quest.4B9B92C773BE9BA3.quest_desc: [
		"The illagers' siege beasts break walls. Break them first."
		""
		"Kill &e3 ravagers&r and &e5 evokers&r. Raids at higher Bad Omen levels bring them."
	]
	quest.4B9B92C773BE9BA3.title: "Break the Beast"
	quest.4BAD95D59BAF58FC.quest_desc: [
		"More voltage."
		""
		"Craft a &eLightning Upgrade Orb&r and apply it at the Arcane Anvil."
	]
	quest.4BAD95D59BAF58FC.title: "Overcharge"
	quest.4C1DFCE0B7367D4B.quest_desc: [
		"Break a monster spawner with a &eSilk Touch&r pickaxe and it drops as an item you can place anywhere."
		"A dungeon spawner near your base becomes a mob farm."
	]
	quest.4C1DFCE0B7367D4B.quest_subtitle: "Apothic Spawners"
	quest.4C1DFCE0B7367D4B.title: "Take the Spawner"
	quest.4C55B6292DE9D06C.quest_desc: [
		"Every titan of the Cataclysm, fallen to your party."
		""
		"Optional: earn the &eL_Ender's Cataclysm&r advancement for slaying every one of its bosses."
	]
	quest.4C55B6292DE9D06C.title: "Cataclysm's End"
	quest.4C8DACDF094EB089.quest_desc: [
		"The top of the mountain. Mythic gear, perfect gems and the hardest monsters in the pack."
		"This is the tier the final fight is meant for."
	]
	quest.4C8DACDF094EB089.title: "World Tier: Pinnacle"
	quest.4CA6E68CDAEFD0CD.quest_desc: [
		"MekaSuit pieces and the Meka-Tool take &emodules&r (jetpack, nutrition, vision, speed, shields...). You install them at the &eModification Station&r."
		"Build one."
	]
	quest.4CA6E68CDAEFD0CD.title: "The Modification Station"
	quest.4CB37C54C4ECFC3E.quest_desc: [
		"&eCreate&r builds machines from spinning shafts and gears. Hover any Create item and &ehold W&r to &ePonder&r it: an animated lesson that shows how it works."
		"Make a &eWrench&r (rotates blocks; shift-right-click picks up Create blocks) and &eEngineer's Goggles&r (show speed and stress when you look at machines)."
	]
	quest.4CB37C54C4ECFC3E.quest_subtitle: "Create"
	quest.4CB37C54C4ECFC3E.title: "Ponder Everything"
	quest.4CCCC0DA6F518EE6.quest_desc: [
		"A battlemage's off-hand: a staff that sharpens every frost spell."
		""
		"Craft Iron's &eIce Staff&r."
	]
	quest.4CCCC0DA6F518EE6.title: "The Ice Staff"
	quest.4CD191ECF590F37C.quest_desc: [
		"In the wreck lies a dying man in green light. 'The dark between the stars... it is coming. Seven lights...'"
		""
		"Kneel by the dying &aGreen Lantern&r and listen to him until he is done. His ring flies off to find someone worthy. &oNot you. Not yet.&r"
	]
	quest.4CD191ECF590F37C.title: "The Last Words"
	quest.4D02A6FF51227430.quest_desc: [
		"Villagers tell of a guardian of iron who never sleeps."
		""
		"Optional: build an Iron Golem (4 iron blocks in a T, carved pumpkin on top)."
	]
	quest.4D02A6FF51227430.title: "The Iron Warden"
	quest.4D1332807D3C7E60.quest_desc: [
		"The Lantern said the spectrum has seven lights. Each one calls a different kind of hero:"
		"&cRed&r Bloodfire Berserker: fire, rage, the Nether.  &6Orange&r Hoardwarden: earth, mines, treasure."
		"&eYellow&r Stormwright: lightning, speed, machines.  &aGreen&r Lightwarden: paladin of villages and raids."
		"&bBlue&r Frostbinder: ice and sky.  &9Indigo&r Wildheart: beasts, dragons, familiars.  &5Violet&r Voidblade: night, undead, the End."
		""
		"Open &bThe Seven Lights&r chapters and join one, or several: each class has its own talent tree and questline. Try the taste quests here first if you can't decide."
	]
	quest.4D1332807D3C7E60.quest_subtitle: "Choose your path"
	quest.4D1332807D3C7E60.title: "The Seven Lights"
	quest.4D2214F3985AFF96.quest_desc: [
		"The Champion falls apart into dust and bone, and a violet light slips out of the shadows as if it had always been there."
		"Who would you give everything for?"
		""
		"Claim this reward to begin the &ering trial&r: a conversation in chat. The ring will judge you. Your &eanswers&r decide whether you receive your own light, the &fWhite&r, or the &8Black&r. Answer as who you really are."
		"&7(Only works once you have the trial credit from the quest before.)"
	]
	quest.4D2214F3985AFF96.quest_subtitle: "The ring will judge you"
	quest.4D2214F3985AFF96.title: "The Ring Judges"
	quest.4DB73C2CD0B29845.quest_desc: [
		"Gems come in purities: &7Cracked&r, Chipped, Flawed, Normal, Flawless, &6Perfect&r. Higher purity, bigger bonus."
		"The &eGem Cutting Table&r uses gem dust and rarity materials to raise a gem's purity. Higher world tiers drop purer gems."
	]
	quest.4DB73C2CD0B29845.title: "Cutting Gems"
	quest.4DBFAFA10F3F5496.quest_desc: [
		"Some nights the moon changes (&eEnhanced Celestials&r). A &cBlood Moon&r brings hordes of undead: get behind walls or fight it out together."
		"A &9Blue Moon&r makes you lucky, and a &6Harvest Moon&r gives better harvests. A message in chat tells you when each one rises."
	]
	quest.4DBFAFA10F3F5496.title: "Watch the Moon"
	quest.4E47B59531AAD15D.quest_desc: [
		"Lift gets you up; &ethrust&r moves you. A spinning &ePropeller&r (wooden or andesite) pushes the contraption the other way."
		"Place and power a propeller. A wrench reverses a Smart Propeller."
	]
	quest.4E47B59531AAD15D.title: "For Every Action..."
	quest.4E5BF2FB1C008A1C.quest_desc: [
		"You don't tame a dragon. You raise one."
		""
		"Take an &eice dragon egg&r (blue, white, sapphire or silver). Ice eggs hatch when placed in water; stay close so it bonds with you."
	]
	quest.4E5BF2FB1C008A1C.title: "A Bond, Not a Conquest"
	quest.4E8EB2630EAB8E98.quest_desc: [
		"&eGalosphere: Spellbooks&r turns Galosphere's metals and crystals into magic gear: the &eSterling Tome&r (palladium), Sterling robes and the Allurite Pendant."
		"Craft a Sterling Tome. Palladium is in the Mining chapter."
	]
	quest.4E8EB2630EAB8E98.quest_subtitle: "Galosphere: Spellbooks"
	quest.4E8EB2630EAB8E98.title: "The Sterling Tome"
	quest.4E9862CC1B177E8E.quest_desc: [
		"A drowned city on the deep sea floor, ruled by a beast too large to see whole."
		""
		"Find the &eSunken City&r (L_Ender's Cataclysm) under the ocean. An &eEye of Abyss&r points the way. Bring water breathing."
	]
	quest.4E9862CC1B177E8E.title: "The Sunken City"
	quest.4EA5762E16679C64.quest_desc: [
		"Pick a harness that suits you: Gothic, Maximilian, Crusader, Winged Hussar, Kastenbrust and more. Helmets (Armet, Bascinet, Greathelm, Sallet) mix with any set."
		"Heavy plate is the early wall for front-line players: the Orange Hoardwarden and Green Lightwarden live in it."
	]
	quest.4EA5762E16679C64.title: "Full Plate"
	quest.4F12B5FEB7A15D3A.quest_desc: [
		"Lightning strikes the same sea temple again and again. Something there calls it down."
		""
		"Find the &eAcropolis&r (L_Ender's Cataclysm) at sea. An &eEye of Storm&r points the way."
	]
	quest.4F12B5FEB7A15D3A.title: "The Drowned Acropolis"
	quest.4F16D97C3CCC6C6F.quest_desc: [
		"Mail on your back, a heater shield on your arm. The watch's uniform."
		""
		"Craft &eEpic Knights&r chainmail and a &eSteel Heater Shield&r."
	]
	quest.4F16D97C3CCC6C6F.title: "Shield of the Watch"
	quest.4F871DC874D30B22.quest_desc: [
		"The King's crown rolls to your feet, and an orange light rises out of it, hungry and patient."
		"What would you give up to keep what you have?"
		""
		"Claim this reward to begin the &ering trial&r: a conversation in chat. The ring will judge you. Your &eanswers&r decide whether you receive your own light, the &fWhite&r, or the &8Black&r. Answer as who you really are."
		"&7(Only works once you have the trial credit from the quest before.)"
	]
	quest.4F871DC874D30B22.quest_subtitle: "The ring will judge you"
	quest.4F871DC874D30B22.title: "The Ring Judges"
	quest.4F897E8304AB1C4D.quest_desc: [
		"Some swords are forged in storms."
		""
		"Optional: find a storm-touched &eSimply Swords&r unique (dungeon and boss loot)."
	]
	quest.4F897E8304AB1C4D.title: "Stormbringer"
	quest.4FF1BC63DEFF6F21.quest_desc: [
		"A &eCrafting Terminal&r on the network shows everything you've stored and lets you craft straight from it. Search it like JEI."
		"Put one where your whole party can reach it: every item, everyone's, in one place."
	]
	quest.4FF1BC63DEFF6F21.title: "One Chest to Rule Them All"
	quest.504A88861AF015FF.quest_desc: [
		"A Frostbinder walks on snow that swallows others."
		""
		"Walk on powder snow wearing leather boots."
	]
	quest.504A88861AF015FF.title: "Light Feet"
	quest.5055B34A854D926D.quest_desc: [
		"The world is getting more dangerous, and its treasures richer."
		""
		"Wear a full set of &eaffix gear&r (helmet, chestplate, leggings, boots and a weapon with coloured Apotheosis names), then press &eCTRL+T&r to enter the Frontier world tier. Higher tiers: tougher mobs, better loot."
	]
	quest.5055B34A854D926D.title: "Beyond the Haven"
	quest.505AC3DA09671D40.quest_desc: [
		"Storage, terminals, buses and autocrafting: your base thinks for itself now."
		"From here: wireless terminals, P2P tunnels, spatial storage. The AE2 guide (hold &eG&r) covers them all."
	]
	quest.505AC3DA09671D40.title: "Network Online"
	quest.50FAF5FED37370D5.quest_desc: [
		"A &eMechanical Press&r over a depot or belt flattens ingots into &esheets&r. Over a basin it compacts things together."
		"Iron sheets go into a lot of Create recipes, and into Crafts & Additions parts."
	]
	quest.50FAF5FED37370D5.title: "The Mechanical Press"
	quest.51052FCB989B3BDC.quest_desc: [
		"You and your dragon think the same thought at the same time."
		""
		"Reach a &etrue bond&r with a Book of Dragons dragon (keep riding, feeding and fighting together)."
	]
	quest.51052FCB989B3BDC.title: "Dragon Whisperer"
	quest.517BA16621ED9CD2.quest_desc: [
		"White fur and blue thread. The cold bends around you."
		""
		"Craft the full &eCryomancer&r set (Iron's Spells). It boosts ice spell power and mana."
	]
	quest.517BA16621ED9CD2.title: "The Cryomancer's Coat"
	quest.517F5A9607E408C9.quest_desc: [
		"Mekanism turns raw ore into refined power, and power into anything."
		""
		"Build a &eMetallurgic Infuser&r (Mekanism) and infuse &e8 steel ingots&r."
	]
	quest.517F5A9607E408C9.title: "Steel and Osmium"
	quest.51AEDB145F8D26B4.quest_desc: [
		"An &eElectric Motor&r does the reverse: it turns FE back into rotation, at a speed you set. Power a contraption anywhere a wire can reach."
		"With alternators, wires, accumulators and motors, your factory has no limits but your imagination (and your stress budget)."
	]
	quest.51AEDB145F8D26B4.title: "The Electric Motor"
	quest.51E71A5275A81540.quest_desc: [
		"&eDungeons and Taverns&r scatters dangerous houses across the land: illager manors and hideouts, witch villas, toxic lairs and crypts. Wandering traders even sell maps to them."
		"An &eIllager Manor&r is a full mansion of evokers and vindicators. Go with friends."
	]
	quest.51E71A5275A81540.quest_subtitle: "Dungeons and Taverns"
	quest.51E71A5275A81540.title: "The Illager Manor"
	quest.52302F430863CE96.quest_desc: [
		"The Harbinger's core sparks once, and a yellow light slides out of the wreck like a struck match."
		"Do you master fear, or does it master you?"
		""
		"Claim this reward to begin the &ering trial&r: a conversation in chat. The ring will judge you. Your &eanswers&r decide whether you receive your own light, the &fWhite&r, or the &8Black&r. Answer as who you really are."
		"&7(Only works once you have the trial credit from the quest before.)"
	]
	quest.52302F430863CE96.quest_subtitle: "The ring will judge you"
	quest.52302F430863CE96.title: "The Ring Judges"
	quest.523B03A65BDCCBB5.quest_desc: [
		"A balloon is a closed space walled with &eHot Air Envelope&r blocks. A &eHot Air Burner&r under it fills it with hot air, and the hot air lifts the contraption."
		"Bigger balloon, more lift. Heavy blocks (stone, metal) need more; planks and wool are light. Fill an airtight envelope."
	]
	quest.523B03A65BDCCBB5.title: "Head in the Clouds"
	quest.524D6032EBA887CF.quest_desc: [
		"Far beyond the sky lies &aOa&r, the Guardians' world: the Citadel, the Guardian Outpost, the Lantern Spire, and the great Central Power Battery that recharges ten times faster than any other."
		"Fly there from deep space with your party and recharge every ring and Lantern you carry."
	]
	quest.524D6032EBA887CF.title: "Oa"
	quest.529F08437E474690.quest_desc: [
		"Fuse Draconium Cores with a Nether Star and more to make a &eWyvern Core&r: the key to the Wyvern tier."
		"Wyvern injectors let you fuse the next tier up."
	]
	quest.529F08437E474690.title: "The Wyvern Core"
	quest.52A174FAC254E04A.quest_desc: [
		"&o\"Fall to your knees, worm!\"&r A serpent three hundred blocks long, a god-eater, a hunger with a voice."
		"Green shields. Blue protects. Indigo's beasts hold the adds. Yellow and Red burst. Orange holds the line. Violet finds the weak point."
		""
		"Summon the &eDevourer of Gods&r and kill it. It scales with every player present, and the party shares a small budget of deaths: when it runs out, it leaves. Fly. Everyone nearby gets the credit."
	]
	quest.52A174FAC254E04A.quest_subtitle: "The Devourer of Gods"
	quest.52A174FAC254E04A.title: "The Last Light"
	quest.52BC9E208CB8B259.quest_desc: [
		"A citadel at the edge of the End, guarded by a colossus of void-steel. Perfect for an assassination."
		""
		"Find the &eRuined Citadel&r (Cataclysm). An &eEye of Void&r points the way."
	]
	quest.52BC9E208CB8B259.title: "The Ruined Citadel"
	quest.52D9666D48DB1EA5.quest_desc: [
		"A &eMechanical Arm&r picks items up from one place and puts them somewhere else: depots, belts, chests, machines, even Blaze Burners."
		"Click the input and output blocks with the arm in hand before you place it."
	]
	quest.52D9666D48DB1EA5.title: "The Mechanical Arm"
	quest.530EE98DC7417659.quest_desc: [
		"Somewhere far out (about 9,500 blocks from spawn) stands &eThe Lost Castle&r, one huge, rare castle dungeon."
		"A long trip and a long fight. Optional, for the brave."
	]
	quest.530EE98DC7417659.title: "The Lost Castle"
	quest.5351CF40B2FFBC95.quest_desc: [
		"&o\"The closer to death you are, the harder you hit.\"&r"
		"Red is the light of rage: fire and blood magic, huge two-handed weapons, and the burning Nether."
		""
		"Claim the reward to join Red and unlock its talent tree. You can still join other lights later."
	]
	quest.5351CF40B2FFBC95.quest_subtitle: "Join this light"
	quest.5351CF40B2FFBC95.title: "&cThe Bloodfire Berserker"
	quest.538DBE0128525881.quest_desc: [
		"Hammer, flatten, repeat. The machine never tires."
		""
		"Build a &eMechanical Press&r and press iron ingots into sheets."
	]
	quest.538DBE0128525881.title: "Iron Under Pressure"
	quest.5412430C2EFAA7FF.quest_desc: [
		"A &eRolling Mill&r makes rods and wire. Wind &eCopper Wire&r onto a spool, then click two &eConnectors&r with it to string a power line between them."
		"Large Connectors carry more over longer distances. Run lines from your power plant to every machine."
	]
	quest.5412430C2EFAA7FF.title: "Power Lines"
	quest.5438E9EC2D445993.quest_desc: [
		"Far out in the End void floats a shattered island, crackling with chaos energy. Something enormous circles it."
		""
		"Find &eDraconic Evolution's Chaos Island&r far out in the End. Fly (your ring or elytra) and mark the way home. Tick when you see it."
	]
	quest.5438E9EC2D445993.title: "The Chaos Island"
	quest.54CCB4DDE1277042.quest_desc: [
		"Illagers build big when nobody stops them."
		""
		"Find an illager stronghold: a Woodland Mansion, a Dungeons and Taverns &eIllager Manor&r, or a When Dungeons Arise &eIllager Fort&r or &eWindmill&r."
	]
	quest.54CCB4DDE1277042.title: "The Illager Manor"
	quest.54E9CEB563912077.quest_desc: [
		"A metal station hangs in the End's void. Something inside keeps count of every hit it takes."
		""
		"Optional: find the &eSpace Station&r (Legendary Monsters) in the End."
	]
	quest.54E9CEB563912077.title: "The Place of the Beginning"
	quest.550119A8F32EAEA1.quest_desc: [
		"Even the tormented can be brought home."
		""
		"Redeem a &etormented villager&r by ringing a &ebell&r near it (The Graveyard)."
	]
	quest.550119A8F32EAEA1.title: "Redemption"
	quest.554A77F418CFDBBC.quest_desc: [
		"&eHippogryphs&r (half eagle, half horse) live in the hills and mountains. Tame one and you have a flying mount long before you have a dragon."
		"Lightwardens: the white hippogryph is your path's steed."
	]
	quest.554A77F418CFDBBC.title: "Wings of the Griffon"
	quest.558F18D1C97008FD.quest_desc: [
		"A mage in white wanders the snow, freezing anything that comes close."
		""
		"Defeat an Iron's &eCryomancer&r in cold lands (or near ice structures). Frost resistance helps."
	]
	quest.558F18D1C97008FD.title: "The Cryomancer"
	quest.55959D7C0EDBFFE4.quest_desc: [
		"Legends speak of a castle in the sky, and a stone that points to it."
		""
		"Craft (or trade a master Cartographer for) a &eLevitation Stone&r (Castle in the Sky). It needs an elytra and netherite."
	]
	quest.55959D7C0EDBFFE4.title: "The Levitation Stone"
	quest.55BF0D96A77A5676.quest_desc: [
		"Steel, osmium and glass make a &eSteel Casing&r: the frame of almost every Mekanism machine."
		"Make a few. You'll need them for everything from here on."
	]
	quest.55BF0D96A77A5676.title: "Steel Casing"
	quest.55D5577648C03FFE.quest_desc: [
		"Rotation becomes current, current becomes rotation, anywhere you want it."
		""
		"Craft an &eAlternator&r and an &eElectric Motor&r (Create Crafts & Additions) and wire them with copper spools."
	]
	quest.55D5577648C03FFE.title: "Current Affairs"
	quest.560BCB38A4EF0894.quest_desc: [
		"&o\"Faster than thunder, brighter than lightning.\"&r"
		"Yellow is the light of the storm and the machine: lightning magic, quick duelling blades, and &eCreate&r, &eAeronautics&r, Mekanism and Draconic tech. In co-op, Yellow builds the party's fleet."
		""
		"Claim the reward to join Yellow and unlock its talent tree. You can still join other lights later."
	]
	quest.560BCB38A4EF0894.quest_subtitle: "Join this light"
	quest.560BCB38A4EF0894.title: "&eThe Stormwright"
	quest.560E85E7DA8CBFA3.quest_desc: [
		"Big footprints, bigger camps. The ogres pay tribute to a king."
		""
		"Find an &eogre outpost&r (Kings & Monsters, plains and swamps) and kill &e5 ogre grunts&r."
	]
	quest.560E85E7DA8CBFA3.title: "Ogre Country"
	quest.561DAD01A97076E1.quest_desc: [
		"A Stormwright reaches further than anyone else."
		""
		"Craft an &eExtendo Grip&r: it doubles your reach while held in the off-hand."
	]
	quest.561DAD01A97076E1.title: "Long Arm of the Law"
	quest.561F7CA7B55CC07A.quest_desc: [
		"Feed your hatchling meat and it grows, stage by stage, over many days. Once it's big enough you can ride it."
		"The &eDragon Command Staff&r tells it to sit, follow or wander. A &eDragon Horn&r carries it in your pocket."
	]
	quest.561F7CA7B55CC07A.title: "Raising a Dragon"
	quest.564C6BFC7E6CF8E8.quest_desc: [
		"Frozen ruins keep their secrets well. Too well."
		""
		"Explore a frozen ruin: Terralith's &eFrosted Dungeon&r or &eGlacial Hut&r, an igloo, or Iron's &eImpaled Icebreaker&r ship."
	]
	quest.564C6BFC7E6CF8E8.title: "Under the Ice"
	quest.56C546359803E79D.quest_desc: [
		"A paladin rides to war."
		""
		"Tame a horse and craft it &eBarding&r (Epic Knights horse armor) and a &esaddle&r. The &eSummon Horse&r spell gives you a spectral steed too."
	]
	quest.56C546359803E79D.title: "Warhorse"
	quest.56F29CB5B97E013D.quest_desc: [
		"In the burning &eFire Swamp&r, the three-headed &eHydra&r guards its lair. Hit its heads when they open to bite, and keep out of the fire."
		"Its &eFiery Blood&r makes the Fiery set. (This is Twilight's Hydra; Ice and Fire has another.)"
	]
	quest.56F29CB5B97E013D.title: "IV-a. The Hydra"
	quest.56FE3DB0C3721ECE.quest_desc: [
		"A &ePrecision Mechanism&r is made by &esequenced assembly&r: a gold sheet passes under deployers and a press several times on a belt. Some come out as scrap, so make a few."
		"Many advanced machines need them, and so does the Lantern &ePower Core&r."
	]
	quest.56FE3DB0C3721ECE.title: "Precision Mechanism"
	quest.570A56AC1B569429.quest_desc: [
		"Every dragon in the sky knows your name."
		""
		"Fill &eevery dragon's entry&r in the Book of Dragons: meet, study and tame them all."
	]
	quest.570A56AC1B569429.title: "Dragon Master"
	quest.57115979D5A6C0FE.quest_desc: [
		"Every scroll is a spell someone was too afraid to cast."
		""
		"Collect &e3 Iron's Spells scrolls&r from chests and mob drops. Keep the good ones: you can write them into a spellbook."
	]
	quest.57115979D5A6C0FE.title: "Scrolls of Power"
	quest.57E11CCA254859FD.quest_desc: [
		"Dig a &e2x2 pool of water&r in grass, ring it with flowers or other small plants, and throw a &ediamond&r in. Lightning strikes and the portal opens."
		"The Twilight Forest is dark and dangerous, and its regions unlock in order: beat a region's boss and the next region opens. Areas you haven't earned hurt you (blindness, hunger, fire)."
	]
	quest.57E11CCA254859FD.title: "Through the Pool"
	quest.57EC4D6EE9B557F7.quest_desc: [
		"&eApplied Energistics 2&r stores every item you own in one digital network. It starts with a &emeteorite&r: a crater with a sky-stone core holding inscriber presses and budding certus quartz."
		"AE2 has a full guide built in: hover any AE2 item and hold &eG&r. Find a meteorite (a Meteorite Compass helps once you have certus)."
	]
	quest.57EC4D6EE9B557F7.quest_subtitle: "Applied Energistics 2"
	quest.57EC4D6EE9B557F7.title: "A Stone From the Sky"
	quest.584D0173CCE0FD42.quest_desc: [
		"An obsidian pillar on a lonely End island. It hums. It waits."
		""
		"Find the &eObsidilith's arena&r (Bosses of Mass Destruction) in the End."
	]
	quest.584D0173CCE0FD42.title: "The Black Monolith"
	quest.5868E0324D1F7072.quest_desc: [
		"Summit asks for the Wither's death, among other things. Monsters here hit hard; your gear should have Rare or better affixes and socketed gems."
		"Lantern ring trials sit around this tier."
	]
	quest.5868E0324D1F7072.title: "World Tier: Summit"
	quest.5887F13DAC8CA6DB.quest_desc: [
		"Raise your storage to &eGold&r (81 slots, 3 upgrade slots) or &bDiamond&r (108 slots, 4 upgrade slots)."
		""
		"Make an &eIron to Gold&r or &eGold to Diamond&r tier upgrade."
	]
	quest.5887F13DAC8CA6DB.title: "Gold and Diamond"
	quest.58A9636561642D33.quest_desc: [
		"Put a &eSkillet&r on a campfire or stove and right-click raw food onto it to cook it quickly."
		"It's also a heavy, clanging weapon in a pinch."
	]
	quest.58A9636561642D33.title: "The Skillet"
	quest.58F00D129B74235A.quest_desc: [
		"See stress, speed and capacity at a glance."
		""
		"Craft &eEngineer's Goggles&r and wear them while building machines."
	]
	quest.58F00D129B74235A.title: "Engineer's Eyes"
	quest.58F8B252EA85017C.quest_desc: [
		"A spellbook that crackles when you open it."
		""
		"Get the &eStormweaver's Spell Tome&r, the lightning spellbook (Discerning the Eldritch, see JEI)."
	]
	quest.58F8B252EA85017C.title: "Stormweaver's Tome"
	quest.59151DCB97640A5E.quest_desc: [
		"The tribe of compassion carries staffs, not swords."
		""
		"Optional: obtain an &eIndigo Staff&r (Create: Lanterns, see JEI)."
	]
	quest.59151DCB97640A5E.title: "The Indigo Staff"
	quest.5928D38F7250B143.quest_desc: [
		"Wizards build tall and live alone, and their libraries outlive them."
		""
		"Find a mage tower: a &eTerralith&r Mage Tower or an &eIron's Spells&r mountain tower. Loot the bookshelves and chests for spells."
	]
	quest.5928D38F7250B143.title: "The Mage's Spire"
	quest.5987165544FAB182.quest_desc: [
		"&eLimited barrels&r hold one kind of item per section and show it on the front, with the count. They're drawers for a tidy base: one, two, three or four sections."
		""
		"Make any limited barrel."
	]
	quest.5987165544FAB182.title: "One Thing per Drawer"
	quest.598B95EF8B9711AB.quest_desc: [
		"&eAlex's Mobs&r puts more than ninety creatures into the world, from roadrunners to cachalot whales. Some are friendly, some can be tamed, some will eat you."
		"Craft the &eAnimal Dictionary&r (see JEI). Each creature has a page: where it lives, what it drops, how to tame it."
	]
	quest.598B95EF8B9711AB.quest_subtitle: "Alex's Mobs"
	quest.598B95EF8B9711AB.title: "The Animal Dictionary"
	quest.59A70DB6E42B27DE.quest_desc: [
		"The Dead King's crown clatters to the floor, and a green light rises from the dust, steady and unafraid."
		"Will you stand when standing costs you everything?"
		""
		"Claim this reward to begin the &ering trial&r: a conversation in chat. The ring will judge you. Your &eanswers&r decide whether you receive your own light, the &fWhite&r, or the &8Black&r. Answer as who you really are."
		"&7(Only works once you have the trial credit from the quest before.)"
	]
	quest.59A70DB6E42B27DE.quest_subtitle: "The ring will judge you"
	quest.59A70DB6E42B27DE.title: "The Ring Judges"
	quest.59D970A32FEC8FEE.quest_desc: [
		"In the &eOgre King's Fort&r the King sits on his throne with his guard, mages and brutes. Break the guard first, then the King."
		"He is the Hoardwarden's trial. His crown and club are worth the trip."
	]
	quest.59D970A32FEC8FEE.title: "II. The Ogre King"
	quest.59F28861F4828FB3.quest_desc: [
		"The &eAugmenting Table&r changes one affix instead of the whole item: upgrade it or reroll just that line, using Sigils of Enhancement."
		"This is how you perfect an item without losing what you already like about it."
	]
	quest.59F28861F4828FB3.title: "Augmenting"
	quest.5A19AE497D44DD58.quest_desc: [
		"The blue ring stayed. Near you, every Green ring burns brighter."
		""
		"Optional, Blue ring only: learn &eFrost Ward&r and &eGlacial Sanctum&r (Spectral Hub HUD). Stand near Green Lanterns to charge them."
	]
	quest.5A19AE497D44DD58.title: "The Blue Answered"
	quest.5A19DE2B0C131BB2.quest_desc: [
		"Weapons here have reach, rhythm and combos. Two-handers sweep, daggers flurry, shields parry."
		""
		"&eBetter Combat&r: hold attack to chain combos, and watch each weapon's range. Two-handers need an empty off-hand. &eCombat Roll&r lets you dodge."
	]
	quest.5A19DE2B0C131BB2.title: "Swing With Weight"
	quest.5A40BC25FFF16E44.quest_desc: [
		"In the Nether's deep dark, a hall of carved blackstone. Inside, a fist the size of a house waits."
		""
		"Find the &eGauntlet's arena&r (Bosses of Mass Destruction) somewhere in the Nether. Mark it, then come back ready."
	]
	quest.5A40BC25FFF16E44.title: "Black Iron Halls"
	quest.5A8D0F520FD317ED.quest_desc: [
		"Robed figures pray to something that answered."
		""
		"Find and enter the &eCultist Base&r (Discerning the Eldritch)."
	]
	quest.5A8D0F520FD317ED.title: "The Cult of the Ascended"
	quest.5A9BD68FA27F6736.quest_desc: [
		"Every spell belongs to a school: &cFire&r, &bIce&r, &eLightning&r, &6Holy&r, &5Ender&r, &4Blood&r, &fEvocation&r, &aNature&r, &3Eldritch&r. The addons add Abyssal and others."
		"Each light leans on its own: Red fire and blood, Blue ice, Yellow lightning, Green evocation and holy, Orange earthy nature, Violet ender and eldritch, Indigo summons. School armour and orbs make your school stronger."
	]
	quest.5A9BD68FA27F6736.title: "The Schools of Magic"
	quest.5AD810CF9B08C986.quest_desc: [
		"The warlord's cursed metal, reforged into a battlemage's armor."
		""
		"Craft the &eCursium Mage&r set (Cataclysm: Spellbooks): circlet, breastplate, skirt and greaves."
	]
	quest.5AD810CF9B08C986.title: "Cursium Mage"
	quest.5B0E6736D77B2F73.quest_desc: [
		"You fly at night, unseen, and land behind the enemy."
		""
		"Reach a &etrue bond&r with your dragon (keep riding, feeding and fighting together)."
	]
	quest.5B0E6736D77B2F73.title: "Shadow Wings"
	quest.5B14410CCC077E2C.quest_desc: [
		"Your dragon's breath, caught in a forge of its own scales, makes the hardest steel there is."
		""
		"Build a &eDragonforge&r (Ice and Fire) and fuel it with your grown fire dragon's breath. Smelt &e4 fire dragonsteel ingots&r."
	]
	quest.5B14410CCC077E2C.title: "Fire Dragonsteel"
	quest.5B78C0072B6A93BF.quest_desc: [
		"You and your beasts, perfected together."
		""
		"Unlock the &ePinnacle&r world tier (Apotheosis: a full Epic affix set and the Ender Dragon slain; CTRL+T switches tiers) and draw a &6Mythic&r bow with gems for your summons. Tick the checkmark when you do."
	]
	quest.5B78C0072B6A93BF.quest_subtitle: "Extreme gear"
	quest.5B78C0072B6A93BF.title: "Mythic Pack"
	quest.5BB38B704E03D906.quest_desc: [
		"A village fell to the dead. Its people are still there, tormented."
		""
		"Find an &eoverrun village&r (The Graveyard). Fight through the undead."
	]
	quest.5BB38B704E03D906.title: "Overrun"
	quest.5C81151897C00410.quest_desc: [
		"Some friends are larger than others."
		""
		"Optional: tame an &eelephant&r, a &egorilla&r or a &egrizzly bear&r (Alex's Mobs)."
	]
	quest.5C81151897C00410.title: "Big Friends"
	quest.5C8C64615BBE08D1.quest_desc: [
		"In the Nether, around height 15, &eAncient Debris&r hides in netherrack. It's slow to mine and only a diamond pickaxe or better breaks it, so bring fire resistance and watch for lava."
		"Netherite upgrades gear and appears in many late recipes: the Levitation Stone, battlemage robes, the best backpacks."
	]
	quest.5C8C64615BBE08D1.title: "Ancient Debris"
	quest.5D0D612A79DD550E.quest_desc: [
		"Every crypt has a door. Few have locks that work from the inside."
		""
		"Find a crypt: The Graveyard's &eCrypt&r or &eHaunted House&r, a Dungeons and Taverns &eUndead Crypt&r, or a Philips Ruins &eAncient Crypt&r."
	]
	quest.5D0D612A79DD550E.title: "Where the Dead Rest"
	quest.5D0F4BE2C2804E47.quest_desc: [
		"There is a canyon where the rock itself is crystal, and it sings when the wind blows."
		""
		"Visit Terralith's &eAmethyst Canyon&r or &eAmethyst Rainforest&r and gather &e16 amethyst shards&r."
	]
	quest.5D0F4BE2C2804E47.title: "Singing Stone"
	quest.5DAF902CAD118182.quest_desc: [
		"Some villages already learned to build walls. They need a captain."
		""
		"Visit a &efortified village&r (CTOV): plains, taiga, mesa or swamp styles have walls and towers."
	]
	quest.5DAF902CAD118182.title: "A Village Worth Defending"
	quest.5DFAAD52D6C4724E.quest_desc: [
		"Draconic gear has a &emodule grid&r. Slot in modules for shield capacity, speed, flight, damage, area mining, auto-feeding and more."
		"Open an item's module grid with its keybind (search 'Draconic' in Controls). Craft a Module Core and a module for your chestpiece."
	]
	quest.5DFAAD52D6C4724E.title: "Modules"
	quest.5DFDEDFFFE4480B1.quest_desc: [
		"The old fortress still burns with blaze-fire. You want that fire."
		""
		"Find a &eYUNG's Better Nether Fortress&r and collect &e8 blaze rods&r from its blazes."
	]
	quest.5DFDEDFFFE4480B1.title: "Fortress Breaker"
	quest.5E095EF50ACD8483.quest_desc: [
		"At the top of the frozen tower, the Night Lich raises its staff, and the snow begins to scream."
		""
		"Kill the &eNight Lich&r at the top of its Lich Tower in frozen lands. Dodge its frost volleys; kill the summoned minions. Party members within 64 blocks get the trial credit too."
	]
	quest.5E095EF50ACD8483.quest_subtitle: "Ring trial: the boss"
	quest.5E095EF50ACD8483.title: "&bThe Lich of the North"
	quest.5EA30FFA425E5415.quest_desc: [
		"A shard of the Guardian's heart. It hums with violence."
		""
		"Claim a &eChaos Shard&r from the Guardian's drops. The summoning needs one."
	]
	quest.5EA30FFA425E5415.title: "Chaos Shard"
	quest.5EBCB3443C5F2341.quest_desc: [
		"A &eStorage Bus&r on a chest, a barrel or a Mekanism bin lets the network use that container as storage. Import and export buses move items in and out of machines."
		"Hook your old chests into the network."
	]
	quest.5EBCB3443C5F2341.title: "The Storage Bus"
	quest.5EEA69529FC0A7FE.quest_desc: [
		"Rage, polished to perfection."
		""
		"Unlock the &ePinnacle&r world tier (Apotheosis: a full Epic affix set and the Ender Dragon slain; CTRL+T switches tiers) and wield a &6Mythic&r greatweapon socketed with fire-touched gems. Tick the checkmark when you hold it."
	]
	quest.5EEA69529FC0A7FE.quest_subtitle: "Extreme gear"
	quest.5EEA69529FC0A7FE.title: "Mythic Fury"
	quest.5F11A884A33324F2.quest_desc: [
		"Enchant an item while your table has at least &e10 of each stat&r."
		"A balanced table gives strong, varied enchantments instead of one lucky roll."
	]
	quest.5F11A884A33324F2.title: "A Balanced Table"
	quest.5F12980AAA06C969.quest_desc: [
		"&eRedomesticate&r makes pets sturdier. Give a pet a &epet bed&r: if it dies, it respawns there instead of being lost."
		"A &eCommand Drum&r orders your pets to follow, stay or wander. A &eDeed of Ownership&r hands a pet to a friend, and a lost pet finds its way to a &eWayward Lantern&r."
	]
	quest.5F12980AAA06C969.quest_subtitle: "Redomesticate"
	quest.5F12980AAA06C969.title: "Pets That Come Home"
	quest.5F50F18F3375FB30.quest_desc: [
		"Ancient debris hides in the Nether's bones. It doesn't burn. Neither will you."
		""
		"Mine ancient debris in the Nether and make &e2 netherite ingots&r."
	]
	quest.5F50F18F3375FB30.title: "Deeper Than Diamond"
	quest.5F5FCB8D88F2C953.quest_desc: [
		"Shrine Towers hold combat trials in five tiers, and each tier is harder than the last. The loot grows with the danger."
		"Find a &eTier 3&r shrine and clear it. Bring the party and plenty of food."
	]
	quest.5F5FCB8D88F2C953.title: "The Third Trial"
	quest.5FF39B3DB1D14C17.quest_desc: [
		"&eMithril&r (Iron's Spells) is rare and hides deep in the deepslate layer. Ultimine helps once you find a vein."
		"Mages need it: mithril goes into every Empty Upgrade Orb and into Mithril Weave for the best school armour."
	]
	quest.5FF39B3DB1D14C17.title: "Mithril, Deep Down"
	quest.6029AB0583C7F139.quest_desc: [
		"Almost every upgrade starts as an &eUpgrade Base&r: planks and iron. Upgrades go in the slots on the side of the storage's window."
		""
		"Wood and copper storage have &e1&r upgrade slot; every tier after that adds one."
		""
		"&7(The same idea as your backpack's upgrades. Backpack and storage upgrades are different items, though: JEI shows which is which.)"
	]
	quest.6029AB0583C7F139.title: "The Upgrade Base"
	quest.60408AB88EDF0604.quest_desc: [
		"Conquer the Castle in the Sky. Few find it, and fewer leave with its crystal."
		"The Lantern Corps took note."
	]
	quest.60408AB88EDF0604.title: "Laputa's Heart"
	quest.6069DEB3DF84212D.quest_desc: [
		"A &eDraconium Core&r is the first of four cores: Draconium, Wyvern, Draconic, Chaotic. Each tier of gear and machine needs the matching core."
		"Craft one."
	]
	quest.6069DEB3DF84212D.title: "The Draconium Core"
	quest.6090D03341E0CE8D.quest_desc: [
		"The &eDigital Miner&r mines a huge area underground for you, picking only the blocks you filter for (ores, say) and leaving the rest."
		"It needs a lot of power. Put it in a forceloaded, claimed chunk and it keeps mining while you're off adventuring."
	]
	quest.6090D03341E0CE8D.title: "The Digital Miner"
	quest.60AC8A92EE87ABDA.quest_desc: [
		"A staff that remembers every storm it stood in."
		""
		"Craft the &eRod o' Lightning&r staff (Iron's Spells). Staffs add spell power to your casts."
	]
	quest.60AC8A92EE87ABDA.title: "Rod o' Lightning"
	quest.60F1E0CF567290DB.quest_desc: [
		"Orange hears the ore singing inside the stone."
		""
		"Optional: find any &6YUNG's Better Mineshaft&r. They come in many biome styles."
	]
	quest.60F1E0CF567290DB.title: "A Taste of Avarice"
	quest.610000E3F869D7E9.quest_desc: [
		"The wild trusts slowly. Earn it."
		""
		"Tame an animal: a wolf (bones), a cat (raw fish), a horse (keep riding it), a parrot (seeds)... Taming gives Indigo XP."
	]
	quest.610000E3F869D7E9.title: "Friend of the Wild"
	quest.61B42D85409C925C.quest_desc: [
		"A metal that drinks energy like a dragon drinks fire."
		""
		"Mine draconium ore (Draconic Evolution; richest in the End) and smelt &e16 draconium ingots&r."
	]
	quest.61B42D85409C925C.title: "Draconium"
	quest.61ECA44BBA92455E.quest_desc: [
		"A tower in the snow hides the &eNight Lich&r. It hurls volleys of blue fire and calls down comets. Keep moving and use cover."
		"The Frostbinder's trial."
	]
	quest.61ECA44BBA92455E.quest_subtitle: "Bosses of Mass Destruction"
	quest.61ECA44BBA92455E.title: "II. The Night Lich"
	quest.6241B524D7B3B8EB.quest_desc: [
		"A warm stew keeps you fed far longer than raw bread."
		""
		"Craft a &eCooking Pot&r (Farmer's Delight) and place it over a fire. Meals give strong, long buffs."
	]
	quest.6241B524D7B3B8EB.title: "Hearth and Pot"
	quest.62579101766313DA.quest_desc: [
		"Simply Swords' &eunique weapons&r (Emberblade, Stormbringer, Soulrender, The Watcher and dozens more) can't be crafted. They come from dungeon chests and boss loot."
		"Each has its own power, on hit or on right-click: read the tooltip. Some take &eRunefused&r or &eNetherfused gems&r for a second power."
	]
	quest.62579101766313DA.title: "Weapons With a Name"
	quest.6265D4BBE1FE0B0E.quest_desc: [
		"Under the swamp, a labyrinth. At its centre, a bull with a mushroom for a head."
		""
		"Find the &eLabyrinth&r and kill the &eMinoshroom&r. A Maze Map helps. The trophy counts too."
	]
	quest.6265D4BBE1FE0B0E.title: "The Minoshroom"
	quest.626A9B3BB36AD8A6.quest_desc: [
		"The &eArcane Anvil&r is the mage's workbench. Combine two scrolls of the same spell and level into one of the next level. &eImbue&r a spell into a weapon so it casts on use."
		"It also applies &eupgrade orbs&r to armour and trinkets. Craft one (amethyst blocks, a diamond, an anvil, polished deepslate)."
	]
	quest.626A9B3BB36AD8A6.title: "The Arcane Anvil"
	quest.627AAC39159EC39C.quest_desc: [
		"A &ePurification Chamber&r fed with &eoxygen&r turns ore into three clumps. Crush them, enrich them, smelt them."
		"Get oxygen (and hydrogen) by splitting water in an &eElectrolytic Separator&r."
	]
	quest.627AAC39159EC39C.title: "Three for One"
	quest.627C0710874D123D.quest_desc: [
		"A ring found you. Yellow, White or Black, you are a &eLantern&r now: you can fly, and your will takes shape as constructs."
		""
		"This completes when this light's trial gives you your ring: its own colour, White or Black. The Yellow path continues; the &6Last Light&r chapter has opened."
	]
	quest.627C0710874D123D.quest_subtitle: "Ring-bearer"
	quest.627C0710874D123D.title: "&eRing-Bearer"
	quest.62AE0482EA7D0527.quest_desc: [
		"The dungeons have masters. Topple one and the world will start to notice you."
		""
		"Defeat one early champion: Mowzie's &eFerrous Wroughtnaut&r (Wrought Chamber, underground), Born in Chaos's &eSupreme Bonescaller&r or &eNightmare Stalker&r, or Iron's &eAncient Knight&r (Citadel). Fight as a party."
	]
	quest.62AE0482EA7D0527.title: "A Champion Falls"
	quest.631999F78D616C16.quest_desc: [
		"&eOgre outposts&r dot the plains and swamps. The &eGrunt Captain&r leads each warband: big, slow, and it hits like a falling tree."
		"If you find the Kings & Monsters Compendium, read it: it's a field guide to ogre country."
	]
	quest.631999F78D616C16.quest_subtitle: "Kings & Monsters"
	quest.631999F78D616C16.title: "I. The Grunt Captain"
	quest.632EBCF165E45D3C.quest_desc: [
		"In the &eDark Forest&r stands the Goblin Knight Stronghold. Its inner doors only open after you place a boss trophy on the &eTrophy Pedestal&r inside."
		"Six &eKnight Phantoms&r guard the deepest hall. Defeat them all for Knightmetal and the way to the Dark Tower."
	]
	quest.632EBCF165E45D3C.title: "III-b. The Knight Phantoms"
	quest.635047C30EFD8DDA.quest_desc: [
		"You reached Frontier in Act I. World tiers go &eHaven > Frontier > Ascent > Summit > Pinnacle&r: each makes monsters stronger and loot better, and from Frontier on, &cApothic Invaders&r (armed boss mobs) roam."
		"Open the tier screen with its key (search 'World Tier' in Controls) to see what unlocks the next tier, then activate it. Each player chooses their own tier."
	]
	quest.635047C30EFD8DDA.title: "World Tier: Ascent"
	quest.6368E9B89CBB7FF6.quest_desc: [
		"Scylla guards the storm's heart. She is lightning given a spear."
		""
		"Kill &eScylla&r in the Acropolis. Stay off the water when she calls the storm; fight as a party."
	]
	quest.6368E9B89CBB7FF6.title: "The Storm Spire"
	quest.63A69A337F7F728F.quest_desc: [
		"Climb the &eLich Tower&r. The Lich hides behind a shield and shadow clones: hit the real one when its shield drops, and swat its fireballs back at it."
		"It drops the &eScepters&r (Twilight, Life Draining, Zombie, Fortification). Its death opens three paths: the swamp, the dark forest and the snow."
	]
	quest.63A69A337F7F728F.title: "II. The Twilight Lich"
	quest.63B682A21FF45F93.quest_desc: [
		"Dragons grow in five &estages&r, from hatchling to ancient. Wild adults live in &eroosts&r on the surface (burnt or frozen land, piles of gold) or in deep caves full of treasure."
		"Find a fire dragon roost and look, from a distance. If the dragon is asleep, leave it that way for now."
	]
	quest.63B682A21FF45F93.title: "Scorched Earth"
	quest.63DDA15A91047C37.quest_desc: [
		"Life itself chose you. Every light of the spectrum burns inside the White."
		""
		"Appears when the ring trial made you a &fWhite Lantern&r."
	]
	quest.63DDA15A91047C37.title: "The White Lantern"
	quest.6433E7CC1DF22252.quest_desc: [
		"A &eMechanical Mixer&r above a &eBasin&r mixes ingredients: dough, alloys, liquids."
		"Some mixes need heat under the basin. That's the next step."
	]
	quest.6433E7CC1DF22252.title: "The Mechanical Mixer"
	quest.647E8E2E39C45C3F.quest_desc: [
		"A &ePattern Encoding Terminal&r writes recipes onto blank patterns. A pattern tells the network how to make one thing."
		"Encode a pattern for something you craft often."
	]
	quest.647E8E2E39C45C3F.quest_subtitle: "Autocrafting, part 1"
	quest.647E8E2E39C45C3F.title: "Patterns"
	quest.648562780A0BA6CE.quest_desc: [
		"The &eEnchanted Spell Book&r (diamond) holds a proper arsenal: attack, defence, movement and healing all in one book."
		"Each book has a rarity limit: a scroll that's too rare won't go into a cheap book. Inscribe your best scrolls at the Inscription Table."
	]
	quest.648562780A0BA6CE.title: "The Enchanted Spell Book"
	quest.65151FAD55B2DE77.quest_desc: [
		"A mace that heals the ones who stand behind it."
		""
		"Optional: find &eSun's Grace&r (Dungeons Weapons unique)."
	]
	quest.65151FAD55B2DE77.title: "Sun's Grace"
	quest.6516263BD5A4DB6B.quest_desc: [
		"Awakened draconium: armor with a shield that regenerates."
		""
		"Craft a &eDraconic Core&r and the &eDraconic Chestpiece&r. You'll need an energy core and awakened draconium."
	]
	quest.6516263BD5A4DB6B.title: "Draconic"
	quest.6533E5E51FB1DF92.quest_desc: [
		"A heavy axe that remembers every metal it has ever cut."
		""
		"Claim the &eAxe of a Thousand Metals&r from the Wroughtnaut."
	]
	quest.6533E5E51FB1DF92.title: "Axe of a Thousand Metals"
	quest.654A2C0114A18F42.quest_desc: [
		"Village guards fight raids and monsters. Give them better swords, crossbows and armour once they trust you (open a guard's inventory by interacting with it); armourers and weaponsmiths repair their gear."
		"With Hero of the Village, ring the village &ebell&r to order every guard nearby to follow you, or set patrol points for them."
	]
	quest.654A2C0114A18F42.quest_subtitle: "Guard Villagers"
	quest.654A2C0114A18F42.title: "Captain of the Guard"
	quest.659F0CAF5A7A7A6F.quest_desc: [
		"Hold &e`&r (the key left of 1) while you break a block: &eFTB Ultimine&r breaks up to &e64&r connected blocks of the same kind. Whole ore veins, whole trees."
		"Scroll the mouse wheel while holding the key to change the shape (a tunnel, a flat square...). Every block costs hunger, so bring food."
	]
	quest.659F0CAF5A7A7A6F.quest_subtitle: "FTB Ultimine"
	quest.659F0CAF5A7A7A6F.title: "Vein Mining"
	quest.65C0AEACD3B72D54.quest_desc: [
		"A great serpent coils in a courtyard of mossy stone."
		""
		"Kill the &eNaga&r in its courtyard. Its scales make good armor. The trophy counts too."
	]
	quest.65C0AEACD3B72D54.title: "The Naga"
	quest.65EF4050B698E190.quest_desc: [
		"Speed and power, perfected."
		""
		"Unlock the &ePinnacle&r world tier (Apotheosis: a full Epic affix set and the Ender Dragon slain; CTRL+T switches tiers) and wield a &6Mythic&r duelling blade with lightning gems. Tick the checkmark when you do."
	]
	quest.65EF4050B698E190.quest_subtitle: "Extreme gear"
	quest.65EF4050B698E190.title: "Mythic Voltage"
	quest.677A3B4AB7E3510B.quest_desc: [
		"A steady voice, calm as a heartbeat: &o\"You stood when others ran. Stand again.\"&r"
		""
		"Reach &eGreen level 10&r. Raids won count the most; trades, cures and healing count too."
	]
	quest.677A3B4AB7E3510B.quest_subtitle: "Class level 10"
	quest.677A3B4AB7E3510B.title: "The Light Whispers"
	quest.67A0C136FDC4647C.quest_desc: [
		"Rage can be sharpened."
		""
		"Craft a &eFire Upgrade Orb&r and apply it to a piece of armor at the &eArcane Anvil&r for more fire spell power."
	]
	quest.67A0C136FDC4647C.title: "Stoke the Flame"
	quest.67E7950324A32716.quest_desc: [
		"The best fight is the one they never knew started."
		""
		"Brew an &eInvisibility Elixir&r (Iron's Spells alchemy). Mobs here hear you too (sound draws them), so move quietly."
	]
	quest.67E7950324A32716.title: "Unseen"
	quest.68C2D91EBA520590.quest_desc: [
		"Spells come two ways: &escrolls&r (cast once, then gone) and &espellbooks&r (keep spells for good, cast with mana). You've tried both in Act I; this chapter goes deeper."
		"&eArcane Essence&r is the mage's basic reagent. Craft &eIron's Guidebook&r (a book plus one Arcane Essence): the mod's own guide, with a page for every system here."
	]
	quest.68C2D91EBA520590.title: "The Arcane Path"
	quest.68D95F7C8504CE4F.quest_desc: [
		"In a walled &eNaga Courtyard&r coils a giant serpent. It charges in straight lines: sidestep, then hit it while it turns."
		"Its scales make Naga armour. Killing it opens the way to the Lich."
	]
	quest.68D95F7C8504CE4F.title: "I. The Naga"
	quest.68F37FEF1C88C1B4.quest_desc: [
		"Steam, brass, precision, trains and electricity: you've mastered Create. The Stormwright's machines hum with your light."
		"Next: take it to the sky with Create Aeronautics."
	]
	quest.68F37FEF1C88C1B4.title: "The Clockwork Factory"
	quest.6940B5CF0F9AC447.quest_desc: [
		"Purple banners on a wall of logs. Inside, a throne made for something enormous."
		""
		"Find the &eOgre King's Fort&r (Kings & Monsters) in plains or swamp lands. Scout the walls; the guards are tough."
	]
	quest.6940B5CF0F9AC447.title: "The King's Fort"
	quest.69417D8FB8A49452.quest_desc: [
		"&eIce and Fire&r adds &esapphire&r in cold mountains and &esilver&r underground. Silver weapons hurt the undead more. &eKings & Monsters&r adds &eBog Iron&r in swamps."
		"Apotheosis gems aren't mined: they drop from monsters and chests (see the Apotheosis chapter)."
	]
	quest.69417D8FB8A49452.title: "Gems of the Wild"
	quest.69793773ECA52D20.quest_desc: [
		"The headless lord rides a hellish steed and throws burning pumpkin bombs. Knock him from the saddle and he fights on foot, angrier."
		"Born in Chaos's darkest knight."
	]
	quest.69793773ECA52D20.title: "III. Lord Pumpkinhead"
	quest.699F1A9D5C701BF2.quest_desc: [
		"A dead dragon is a treasure chest: &escales&r for armour, &ebones&r for tools and weapons, &eblood&r and a &eheart&r."
		"Make a dragonbone tool. Then bathe a dragonbone sword in dragon blood for a Flamed, Iced or Lightning blade."
	]
	quest.699F1A9D5C701BF2.title: "Bone, Blood and Scale"
	quest.69B7B5EDDAC4FD51.quest_desc: [
		"Claimed chunks stop other players from breaking your blocks or opening your chests. Open the world map (&eM&r), right-click a chunk (or drag to select several) and pick the claim option. Or stand in the chunk and type &e/openpac-claims claim&r."
		"Each player can claim up to &e500&r chunks and forceload &e10&r, which keeps farms and machines running while you're away."
	]
	quest.69B7B5EDDAC4FD51.quest_subtitle: "Protect your base"
	quest.69B7B5EDDAC4FD51.title: "Stake Your Claim"
	quest.69E0E6713E98203C.quest_desc: [
		"&eZinc&r ore lies in stone and deepslate. Zinc and copper make &ebrass&r, Create's middle-tier metal, which you need for precision mechanisms and the Lantern Power Core."
		"Crush it with Create's crushing wheels for extra yield."
	]
	quest.69E0E6713E98203C.title: "Zinc for Create"
	quest.6A09F5CCC3DCBBE0.quest_desc: [
		"A skeleton the size of a house, and it shoots like one."
		""
		"Optional: kill a &eMutant Skeleton&r (Mutant Monsters). Its bones make armor."
	]
	quest.6A09F5CCC3DCBBE0.title: "Bones of a Giant"
	quest.6A100BE6A6B3CAF1.quest_desc: [
		"&eBudding certus quartz&r grows crystal buds on its faces. Harvest the fully grown clusters for &eCertus Quartz Crystals&r. Breaking a budding block downgrades it, so leave them where they are and harvest around them."
		"A &eGrowth Accelerator&r next to them speeds things up a lot."
	]
	quest.6A100BE6A6B3CAF1.title: "Growing Certus"
	quest.6A238832899BBAE4.quest_desc: [
		"Sometimes two mods use the same ingredients for different items. &ePolymorph&r then shows a small button next to the crafting result."
		"Click it to choose which item you want. It works in crafting tables, furnaces and many machines."
	]
	quest.6A238832899BBAE4.title: "Two Recipes, One Grid"
	quest.6AA3AE02444C8A52.quest_desc: [
		"&o\"The void doesn't see you coming. Neither will they.\"&r"
		"Violet is the light of the void: an assassin with daggers and ender and eldritch magic, who hunts the undead at night and walks the End."
		""
		"Claim the reward to join Violet and unlock its talent tree. You can still join other lights later."
	]
	quest.6AA3AE02444C8A52.quest_subtitle: "Join this light"
	quest.6AA3AE02444C8A52.title: "&5The Voidblade"
	quest.6AA788311BB5CFD6.quest_desc: [
		"Use a &eMechanical Belt&r on two shafts to link them with a conveyor. Funnels put items on and take them off; chutes drop them down."
		"A belt through a fan, under a press, past a saw: that's a factory line."
	]
	quest.6AA788311BB5CFD6.title: "Belts and Funnels"
	quest.6B06611299683912.quest_desc: [
		"Deep in the Nether, an anvil still rings, struck by a smith made of netherite and lava."
		""
		"Find the &eSoul Black Smith&r (L_Ender's Cataclysm) in the Nether."
	]
	quest.6B06611299683912.title: "The Soul Forge"
	quest.6B0E1EFCF9B2CB00.quest_desc: [
		"When the Devourer fell, the Wildheart's pack held its adds at bay, and not one beast was left behind."
		""
		"Complete the Last Light and the Indigo path. No beast fights alone."
	]
	quest.6B0E1EFCF9B2CB00.quest_subtitle: "After the Last Light"
	quest.6B0E1EFCF9B2CB00.title: "&9Legend of the Indigo Light"
	quest.6B2835D59E20E055.quest_desc: [
		"Taller than a door, heavier than a sin."
		""
		"Craft a &eSteel Kite Shield&r. Hold the line: block for the party while they strike."
	]
	quest.6B2835D59E20E055.title: "The Kite Shield"
	quest.6B8A35A12A2236A9.quest_desc: [
		"&9Allurite&r and &eLumiere&r crystals grow beside amethyst in the canyons. Mine the shards for lamps and building blocks."
		"Mages want them too: Galosphere Spellbooks uses them for the Allurite Pendant and Sterling gear."
	]
	quest.6B8A35A12A2236A9.title: "Allurite and Lumiere"
	quest.6C1B0FB04C98AB08.quest_desc: [
		"Tomato vines climb &eRope&r. Hang rope above a tomato plant and it keeps growing upward, giving more tomatoes from the same spot."
		"Optional, but tomato sauce goes into a lot of recipes."
	]
	quest.6C1B0FB04C98AB08.title: "Tomatoes on a Rope"
	quest.6C7054CF22C2CC9B.quest_desc: [
		"The MekaSuit needs &epolonium&r. A &eFission Reactor&r makes nuclear waste; a &eSolar Neutron Activator&r turns it into polonium."
		"&cRadiation is real here.&r Wear a Hazmat suit, carry a Dosimeter, and never break a tank of waste. Build it far from home."
	]
	quest.6C7054CF22C2CC9B.title: "Polonium"
	quest.6C873575F9BC1413.quest_desc: [
		"Right-click a placed spawner with a &espawner modifier&r to change it: spawn more mobs, spawn faster, ignore light, need no player nearby, obey redstone."
		"JEI lists every modifier and what it does (search 'spawner')."
	]
	quest.6C873575F9BC1413.title: "Rewire the Spawner"
	quest.6C95F4A5B169CAC1.quest_desc: [
		"A whale swims through the clouds with a ship on its back."
		""
		"Find a &eSky Whale Ship&r (or the rare frozen whale) and board it."
	]
	quest.6C95F4A5B169CAC1.title: "Whale Song"
	quest.6C9E9A0A988971E9.quest_desc: [
		"&eUniversal Cables&r carry power; an &eEnergy Cube&r stores it. Use a &eConfigurator&r on a machine to set which side takes power, items or chemicals in and out (each side shows a colour)."
		"Build an Energy Cube and wire your generator to it."
	]
	quest.6C9E9A0A988971E9.title: "Cables and Cubes"
	quest.6CBAE237A6AB3291.quest_desc: [
		"The world is ready to give you its best, and its worst."
		""
		"Unlock the &eSummit&r world tier (Apotheosis): slay the Wither and wear a full set of &9Rare&r affix gear, then press &eCTRL+T&r."
	]
	quest.6CBAE237A6AB3291.title: "The Summit"
	quest.6CC37C7242FED208.quest_desc: [
		"Place an ingredient on a &eCutting Board&r and right-click it with a knife to slice it: cabbage leaves, raw pasta, sliced meat. Other tools work too: an axe strips logs, a pickaxe breaks bricks."
		"Many pot recipes need ingredients cut first, so keep the board next to your stove."
	]
	quest.6CC37C7242FED208.title: "The Cutting Board"
	quest.6CD8BBA54D7A6B57.quest_desc: [
		"Every smart network part needs processors: &eLogic&r (gold), &eCalculation&r (certus) and &eEngineering&r (diamond)."
		"Make one of each. Automate them later with the Inscriber and a few hoppers."
	]
	quest.6CD8BBA54D7A6B57.title: "Processors"
	quest.6CF04BABC19012C3.quest_desc: [
		"The stars go out one by one. Something vast is eating its way toward Earth, and the Guardians call every ring-bearer home."
		""
		"Opens for anyone with a ring from any class. This chapter is the endgame: prepare, cross the Twilight, break the Chaos Guardian, and face the Devourer &otogether&r."
	]
	quest.6CF04BABC19012C3.quest_subtitle: "All lights answer"
	quest.6CF04BABC19012C3.title: "The Gathering"
	quest.6CF925BDECCECE10.quest_desc: [
		"Summons from every school answer you: vexes, the raised dead, polar bears."
		""
		"Craft a &eConjurer's Talisman&r (Iron's Spells) to strengthen your summons. Look for summon scrolls (&eSummon Vex&r, &eRaise Dead&r, &eSummon Polar Bear&r...)."
	]
	quest.6CF925BDECCECE10.title: "Conjurer's Talisman"
	quest.6D049C75A3B4062D.quest_desc: [
		"Vex's Warband was one of many."
		""
		"Kill &e20 pillagers&r and &e10 vindicators&r. Illager kills earn Green XP."
	]
	quest.6D049C75A3B4062D.title: "Purge the Warbands"
	quest.6D20252DFB539C98.quest_desc: [
		"Logs become planks, planks become a workbench, and the workbench becomes everything else."
		""
		"Turn logs into planks in your inventory grid, then craft a &eCrafting Table&r and a wooden pickaxe."
	]
	quest.6D20252DFB539C98.title: "A Place to Work"
	quest.6D3734D049D74CB1.quest_desc: [
		"Draconic machines and gear run on energy (FE works). A Draconic &eGenerator&r burns fuel; your Create, Mekanism or Crafts & Additions power works just as well."
		"Fusion crafting eats a lot of it, so build a real power supply first."
	]
	quest.6D3734D049D74CB1.title: "Draconic Power"
	quest.6D46B9E14415956C.quest_desc: [
		"Every winter has its sword."
		""
		"Optional: find a legendary frost weapon: the &eBoreal Blade&r, &eFrostfall&r, &eIcewhisper&r, &eThe Snowgrave&r or &eThe Ice Spear&r."
	]
	quest.6D46B9E14415956C.title: "Blades of Winter"
	quest.6D7DB039636DD04B.quest_desc: [
		"The Warband's swords were cheap. Yours shouldn't be."
		""
		"Craft any one of these weapons (Simply Swords, Epic Knights or Dungeons Weapons). JEI shows the recipes."
	]
	quest.6D7DB039636DD04B.title: "A Proper Blade"
	quest.6DB66E1C7C0A5876.quest_desc: [
		"A blade that sets the air on fire as it swings."
		""
		"Forge a &eFire Dragonsteel Sword&r."
	]
	quest.6DB66E1C7C0A5876.title: "Dragonfire Edge"
	quest.6DC282D3042F9DE1.quest_desc: [
		"The top tier: dissolve ore in sulfuric acid (&eChemical Dissolution Chamber&r), clean the slurry (&eChemical Washer&r), and grow crystals (&eChemical Crystallizer&r). Five ingots per ore."
		"A big build, but it pays back every ore you ever mine. Orange Hoardwardens approve."
	]
	quest.6DC282D3042F9DE1.title: "Five for One"
	quest.6DDF00A4D4AA60BE.quest_desc: [
		"Burn through the Thornlands and climb to the &eFinal Plateau&r and its unfinished castle. The Forest has no final boss yet; reaching it is the victory."
		"Few walk this far into the dusk."
	]
	quest.6DDF00A4D4AA60BE.title: "VII. The Final Plateau"
	quest.6DE912ABD3F2D382.quest_desc: [
		"&eOpen Parties and Claims&r (OPAC) guards your land. Its parties are separate from FTB Teams, so make one here too."
		"Press &e'&r (apostrophe) to open the OPAC menu, choose &eParty&r and create one, then invite your friends by name. You can also type &e/openpac-parties create&r."
		"Party members can build in each other's claims and see each other on the map."
	]
	quest.6DE912ABD3F2D382.quest_subtitle: "Open Parties and Claims"
	quest.6DE912ABD3F2D382.title: "A Party of Your Own"
	quest.6DF84EA75C5562EA.quest_desc: [
		"&eYUNG's&r rebuilt the classic structures: temples, witch huts, ocean monuments, fortresses, mineshafts and the stronghold."
		"The new desert temples hide puzzles and traps, and the treasure room only opens when you solve them. Look around before you pull any lever."
	]
	quest.6DF84EA75C5562EA.quest_subtitle: "YUNG's Better Desert Temples"
	quest.6DF84EA75C5562EA.title: "Puzzles in the Sand"
	quest.6E4E3A1A790CB409.quest_desc: [
		"Deep under the deepslate, something glitters."
		""
		"Mine a diamond (best at Y -50 and below). Bring torches; the caves are crowded."
	]
	quest.6E4E3A1A790CB409.title: "Diamonds!"
	quest.6E81D13211AD6F77.quest_desc: [
		"A &ePower Core&r is the heart of a Central Power Battery: brass blocks, precision mechanisms and a beacon. It comes fully charged and keeps its charge if you break and replace it."
		"Make one. You'll need Create's brass and precision mechanisms (see the Create chapter)."
	]
	quest.6E81D13211AD6F77.title: "The Power Core"
	quest.6EB488C095E5AEC5.quest_desc: [
		"Along ocean cliffs, the winged sea serpent &eNaga&r dives at anyone on the shore and spits poison."
		"Hit it while it's grounded after a dive. Its fangs make a poison dagger."
	]
	quest.6EB488C095E5AEC5.title: "The Naga"
	quest.6EBE9D9DFCCBD788.quest_desc: [
		"Beasts eat. People eat. A Wildheart keeps both fed."
		""
		"Grow and harvest &e8 each&r of rice, tomatoes, cabbage and onions (Farmer's Delight; wild crops give seeds). Harvesting earns Indigo XP."
	]
	quest.6EBE9D9DFCCBD788.title: "Harvest Feast"
	quest.6EE0B72AFB308E69.quest_desc: [
		"One floating castle hides more than 10,000 blocks from spawn. The &eLevitation Stone&r leads you to it."
		"Craft it (an elytra ringed by netherite ingots and phantom membranes) or buy one from a master Cartographer. It needs the End and the Nether first, so it's a late trip."
	]
	quest.6EE0B72AFB308E69.quest_subtitle: "Castle in the Sky"
	quest.6EE0B72AFB308E69.title: "The Levitation Stone"
	quest.6F0720CE8F12A4C9.quest_desc: [
		"Plate that shines like a sunrise and makes holy spells hit like hammers."
		""
		"Craft the &eLightbringer Chestplate&r (Iron's Spells paladin armor, see JEI)."
	]
	quest.6F0720CE8F12A4C9.title: "Lightbringer"
	quest.6FC18666677E14CD.quest_desc: [
		"A lich rules the tall tower at the forest's heart, behind a shield of spinning shields."
		""
		"Climb the &eLich Tower&r and kill the &eTwilight Lich&r. Break his shields first. The trophy counts too."
	]
	quest.6FC18666677E14CD.title: "The Twilight Lich"
	quest.6FD74E6486C0CC43.quest_desc: [
		"Everything the ring does costs charge. Craft the &eLantern&r of your light (see JEI) and stand within 6 blocks of it to start the charging ritual."
		"A Lantern holds a lot, but it only refills at a &eCentral Power Battery&r. An idle ring slowly recovers a little on your will alone, and dying costs it a quarter of its charge. A dropped ring flies back to you."
	]
	quest.6FD74E6486C0CC43.title: "In Brightest Day"
	quest.6FF3A1335D817D2F.quest_desc: [
		"Their god walks. It wears a human shape badly."
		""
		"Defeat the &eAscended One&r (Discerning the Eldritch) at the heart of the cult. One of the hardest void fights in the pack: bring the party."
	]
	quest.6FF3A1335D817D2F.title: "The Ascended One"
	quest.6FF59B24D5B09D9B.quest_desc: [
		"A spellbook bound in ice that never melts."
		""
		"Get the &eFrostbranded Book&r, the ice school's spellbook (see JEI)."
	]
	quest.6FF59B24D5B09D9B.title: "The Frostbranded Book"
	quest.701A4A7AD5572DC4.quest_desc: [
		"The Chaos Guardian's shards hold the most violent power in the pack. Wear it."
		""
		"After the &eChaos Guardian&r falls (Last Light chapter), craft a &eChaotic Core&r and the &eChaotic Chestpiece&r."
	]
	quest.701A4A7AD5572DC4.title: "Chaotic"
	quest.7052ADBC6D6313B0.quest_desc: [
		"Vanilla villages are gone. &eCTOV&r and &eTowns and Towers&r build villages that match their biome: desert oases, alpine towns, jungle treehouses, swamp stilts, fortified walls."
		"Visit one. Guards defend it, traders deal there, and many keep a waystone near the centre."
	]
	quest.7052ADBC6D6313B0.title: "Villages of a Hundred Styles"
	quest.707B09DA72D72293.quest_desc: [
		"The Graveyard's champion answers only to blood."
		""
		"Get a &eVial of Blood&r (The Graveyard). Keep it: you'll need it &efull&r for the ring trial (its advancement tab shows how)."
	]
	quest.707B09DA72D72293.title: "A Vial of Blood"
	quest.70AB797B6449605E.quest_desc: [
		"Here. Then there. Then behind them."
		""
		"Craft an &eEnder Rune&r (see JEI). Look for &eTeleport&r, &eShadow Slash&r and &eEchoing Strikes&r scrolls."
	]
	quest.70AB797B6449605E.title: "Blink"
	quest.70BC4A9E27A2B814.quest_desc: [
		"A temple frozen solid, and a golem of primal ice that has forgotten how to stop."
		""
		"Defeat the &eFrostbitten Golem&r (Legendary Monsters) in its Frostbitten Temple. The mod's &eGuide Book&r helps you find it."
	]
	quest.70BC4A9E27A2B814.title: "The Frostbitten Golem"
	quest.70CE010C336C4710.quest_desc: [
		"Far from any road stands a castle no king has held for centuries. Its halls are full of the dead."
		""
		"Find &eThe Lost Castle&r: one huge castle, very far from spawn (thousands of blocks). Fly there with the party."
	]
	quest.70CE010C336C4710.title: "The Lost Castle"
	quest.711DB894E567184F.quest_desc: [
		"Copper and zinc, mixed hot, make the metal of clever machines."
		""
		"Mix &e8 brass ingots&r: Mechanical Mixer over a heated Basin (Blaze Burner)."
	]
	quest.711DB894E567184F.title: "Brass and Brains"
	quest.7149908E0EBA1BF5.quest_desc: [
		"A &eCrafting CPU&r is a block of crafting units with at least one crafting storage inside. It plans and tracks every autocrafting job."
		"More storage, bigger jobs; more co-processors, faster jobs."
	]
	quest.7149908E0EBA1BF5.quest_subtitle: "Autocrafting, part 2"
	quest.7149908E0EBA1BF5.title: "The Crafting CPU"
	quest.719251AA26B4CE58.quest_desc: [
		"Far below the deepslate lie the &eAncient Cities&r, where the Warden listens for footsteps. Sneak, don't sprint, and avoid the shriekers."
		"Their chests hold rare books (mages look for Ruined Books here) and Echo Shards."
	]
	quest.719251AA26B4CE58.title: "Sculk and Silence"
	quest.71B5CB47856D252D.quest_desc: [
		"The Devourer's shadow wakes the old Cataclysm bosses. Put them down before they join it."
		""
		"Optional: Kill &eThe Harbinger&r in the Ancient Factory. Another class's chapter may already have sent you there."
	]
	quest.71B5CB47856D252D.title: "The War Machine"
	quest.71C4D45EA9A1B379.quest_desc: [
		"Build a frame of &ebrass casing&r, glass and your light's key block around the Power Core. A small battery reaches 64 blocks; medium and biggest reach two and four times as far."
		"It recharges Lanterns and rings in reach, keeps Blaze Burners lit, and turns a shaft under its core for Create (64 RPM). Your base's beating heart."
	]
	quest.71C4D45EA9A1B379.title: "A Central Power Battery"
	quest.71EA7130CD5F4489.quest_desc: [
		"Feed enchanted books into an &eEnchantment Library&r. It stores the enchantments, and you can pull out a book of any of them at any level up to the highest you put in."
		"One library for the whole party saves a lot of books."
	]
	quest.71EA7130CD5F4489.title: "The Enchantment Library"
	quest.72C848754AC07C03.quest_desc: [
		"Cut off the head of a patrol and its banner falls with it."
		""
		"Kill a &eraid captain&r (the illager carrying the banner). Careful: it gives you Bad Omen, which brings a raid to the next village you visit."
	]
	quest.72C848754AC07C03.title: "Voluntary Exile"
	quest.72CD415F4CAD128B.quest_desc: [
		"When the Devourer fell, every Lantern was still standing, because a Lightwarden stood in front of them."
		""
		"Complete the Last Light and the Green path. In brightest day, in blackest night."
	]
	quest.72CD415F4CAD128B.quest_subtitle: "After the Last Light"
	quest.72CD415F4CAD128B.title: "&aLegend of the Green Light"
	quest.72D1E9FA4974B068.quest_desc: [
		"Islands drift above the clouds. Blue wants to stand on all of them."
		""
		"Reach a &efloating island&r (Ember's Floating Islands). Look up; build a tower or use ender pearls."
	]
	quest.72D1E9FA4974B068.title: "Skyward"
	quest.731B2945236F4054.quest_desc: [
		"Every ore in the pack has passed through your hands. Not bad for someone who started with a wooden pickaxe."
		"Next: turn all that ore into machines (Create, Mekanism) or magic (Iron's Spells)."
	]
	quest.731B2945236F4054.title: "Master of the Deep"
	quest.7338EA1F65C3023C.quest_desc: [
		"The Devourer's shadow wakes the old Cataclysm bosses. Put them down before they join it."
		""
		"Optional: Kill &eIgnis&r in the Burning Arena (Nether). Another class's chapter may already have sent you there."
	]
	quest.7338EA1F65C3023C.title: "Ignis Rekindled"
	quest.73480E81040913A6.quest_desc: [
		"Snow falls around you on a clear day, and it whispers: &o\"Hope is cold, and it does not break.\"&r"
		""
		"Reach &eBlue level 10&r. Ice spells, kills in cold biomes, shared party kills and flying all count."
	]
	quest.73480E81040913A6.quest_subtitle: "Class level 10"
	quest.73480E81040913A6.title: "The Light Whispers"
	quest.739F78CBAB120968.quest_desc: [
		"Far out in the End lies &5Chaos Island&r and its Guardian: a dragon of pure chaos with a shield of thousands of points, guarded by crystals that must be broken first. Its attacks ignore armour, and it summons withers."
		"Its &eChaos Shards&r unlock the last tier. Keep a spare: the end of this story needs one."
	]
	quest.739F78CBAB120968.title: "The Chaos Guardian"
	quest.7440B96914F2E7F2.quest_desc: [
		"The &eMekaSuit&r: powered armour that absorbs huge damage, flies with its jetpack unit, feeds you, filters the air and more, all from its battery."
		"Its parts need HDPE, ultimate circuits and polonium. The Stormwright's late-game armour, and a fine one for anyone."
	]
	quest.7440B96914F2E7F2.title: "The MekaSuit"
	quest.745C6346FD93A55C.quest_desc: [
		"A &eJetpack&r burns hydrogen to fly. Fill it from a chemical tank fed by your Electrolytic Separator."
		"Hold jump to rise. Good for scouting and for reaching floating islands before you have an airship or a ring."
	]
	quest.745C6346FD93A55C.title: "Hydrogen Flight"
	quest.74934E59ECB55A19.quest_desc: [
		"Let more of the void in."
		""
		"Craft an &eEnder Upgrade Orb&r and apply it at the Arcane Anvil."
	]
	quest.74934E59ECB55A19.title: "Deeper Void"
	quest.75060753C86B9AA0.quest_desc: [
		"Spiders that spit frost, nesting in a cave of blue ice."
		""
		"Find an Iron's &eIce Spider Den&r in a snowy biome and kill an &eIce Spider&r."
	]
	quest.75060753C86B9AA0.title: "The Ice Spider Den"
	quest.750B3DD782BB8603.quest_desc: [
		"With the King gone, the swamp gives up its strange dark iron."
		""
		"Mine bog iron and craft the full &eBog Iron&r armor set."
	]
	quest.750B3DD782BB8603.title: "Bog Iron"
	quest.751C49660BC52CEE.quest_desc: [
		"The enchanting table has three stats. &aEterna&r sets the highest level you can reach, &cQuanta&r adds randomness (stronger and weaker rolls), and &5Arcana&r gives more and rarer enchantments."
		"Bookshelves raise them; hover the table's stats to read them. Enchant an item at &elevel 30&r."
	]
	quest.751C49660BC52CEE.quest_subtitle: "Apothic Enchanting"
	quest.751C49660BC52CEE.title: "Three Stats"
	quest.75C9C63F8FB2336B.quest_desc: [
		"&eCreate Aeronautics&r lets you build things that fly. The heart of every flying build is the &ePhysics Assembler&r: it turns a structure into a &eSimulated Contraption&r with real weight and momentum, and you can still walk around on it and use it."
		"Hold &eW&r over any Aeronautics block to Ponder it. Get a Physics Assembler."
	]
	quest.75C9C63F8FB2336B.quest_subtitle: "Create Aeronautics"
	quest.75C9C63F8FB2336B.title: "Physics Be Upon Ye"
	quest.75E0D67EC6120A62.quest_desc: [
		"When the old dragon falls, something tears through the sky to eat it."
		""
		"Kill the &eEnder Dragon&r (respawn it with 4 End Crystals on the exit portal if it's already dead). Watch what comes for its corpse."
	]
	quest.75E0D67EC6120A62.title: "The Devouring"
	quest.762F8B701205F098.quest_desc: [
		"The first rule of the duel: be somewhere else when the blade lands."
		""
		"Craft Iron's &eBoots of Speed&r."
	]
	quest.762F8B701205F098.title: "Boots of Speed"
	quest.765D588386DA3907.quest_desc: [
		"Bonding starts slowly. Watch a wild dragon: it will show you what it wants. Give a wild dragon what it asks for."
		"Patience, not swords. Write what you learn in the Book of Dragons."
	]
	quest.765D588386DA3907.title: "Earning Trust"
	quest.768FEF7E7CB22708.quest_desc: [
		"A ranger strikes from the treeline while the pack closes in."
		""
		"Craft an &eEpic Knights Longbow&r: slow to draw, hits hard."
	]
	quest.768FEF7E7CB22708.title: "Ranger's Bow"
	quest.769751A5B1E64722.quest_desc: [
		"&eCrafts & Additions&r links Create to electricity (FE). An &eAlternator&r on a fast, strong shaft turns rotation into energy."
		"FE powers Mekanism machines and AE2 networks. Put a steam engine on an alternator and you have a power plant."
	]
	quest.769751A5B1E64722.quest_subtitle: "Create Crafts & Additions"
	quest.769751A5B1E64722.title: "From Rotation to Power"
	quest.7701613A5730479A.quest_desc: [
		"The village's last line, if you aren't there."
		""
		"Build an &eIron Golem&r for a village you protect."
	]
	quest.7701613A5730479A.title: "Iron Guardians"
	quest.77525923C3DED724.quest_desc: [
		"Your dragon grows. One day soon it will carry you."
		""
		"Raise your ice dragon (feed it fish; Dragon Meal speeds growth) and forge it &esilver dragon armor&r (head and body). Ride it at stage 3."
	]
	quest.77525923C3DED724.title: "Wings of Winter"
	quest.775D2B038E5FA321.quest_desc: [
		"&eThe Graveyard&r spreads graveyards, crypts and haunted houses, and ghouls, revenants and wraiths with them. In a &eLich Prison&r, an altar can call up the &eCorrupted Champion&r."
		"The Voidblade's trial. Bring a full party and something holy."
	]
	quest.775D2B038E5FA321.quest_subtitle: "The Graveyard"
	quest.775D2B038E5FA321.title: "II. The Corrupted Champion"
	quest.7766E7D4C1D7CFCF.quest_desc: [
		"A tower of black brick and a mage who answers questions with fireballs."
		""
		"Find an Iron's &ePyromancer Tower&r and defeat a &ePyromancer&r. Its loot is full of fire scrolls."
	]
	quest.7766E7D4C1D7CFCF.title: "The Pyromancer's Tower"
	quest.779D4658EE0C671A.quest_desc: [
		"Storage that works while you're away:"
		"&eMagnet&r pulls in loose items nearby (3 blocks; 5 for the advanced one)."
		"&eHopper&r moves items in and out like a hopper."
		"&eSmelting&r turns the storage into a furnace that never runs out of room."
		""
		"They're tuned light, so even a big base won't lag. Make any one."
	]
	quest.779D4658EE0C671A.title: "Hands-Free"
	quest.77DC82B72036CC49.quest_desc: [
		"Your hair stands up when you walk into a room. The light is charging you."
		""
		"Craft a &eLightning Rune&r (see JEI). Look for &eLightning Bolt&r, &eElectrocute&r and &eBall Lightning&r scrolls."
	]
	quest.77DC82B72036CC49.title: "Static"
	quest.7848E4B720F4CFD0.quest_desc: [
		"&eJade&r shows a small panel at the top of the screen: the block or mob under your crosshair, its health, and which mod it comes from."
		"Use it to name a strange ore or mob, and to check a machine's progress or a crop's growth without opening anything."
	]
	quest.7848E4B720F4CFD0.title: "What Am I Looking At?"
	quest.7884271ADB33582F.quest_desc: [
		"The Harbinger's heart was a metal that eats light."
		""
		"Collect &e4 witherite ingots&r from the Harbinger and its factory."
	]
	quest.7884271ADB33582F.title: "Witherite"
	quest.788D904220317477.quest_desc: [
		"A black tower in the snow, glowing blue at the top. The cold comes from there."
		""
		"Find the &eLich Tower&r (Bosses of Mass Destruction) in frozen lands. Mark it."
	]
	quest.788D904220317477.title: "The Frozen Tower"
	quest.78A4EF0CE1FA80ED.quest_desc: [
		"A &ePattern Provider&r holds your patterns and sends ingredients out. Put a &eMolecular Assembler&r next to it for crafting-table recipes, or face it at a machine (a furnace, a Create press, a Mekanism enricher) for processing."
		"Now ask the terminal for 64 of something and watch it happen."
	]
	quest.78A4EF0CE1FA80ED.quest_subtitle: "Autocrafting, part 3"
	quest.78A4EF0CE1FA80ED.title: "Hands for the Network"
	quest.78D7034446F1BEB5.quest_desc: [
		"A ring found you. Green, White or Black, you are a &eLantern&r now: you can fly, and your will takes shape as constructs."
		""
		"This completes when this light's trial gives you your ring: its own colour, White or Black. The Green path continues; the &6Last Light&r chapter has opened."
	]
	quest.78D7034446F1BEB5.quest_subtitle: "Ring-bearer"
	quest.78D7034446F1BEB5.title: "&aRing-Bearer"
	quest.790AA4A89DDA2389.quest_desc: [
		"Death itself chose you. The Black does not shine; it swallows."
		""
		"Appears when the ring trial made you a &8Black Lantern&r."
	]
	quest.790AA4A89DDA2389.title: "The Black Lantern"
	quest.79163EC47E17A1A5.quest_desc: [
		"A &eCyclops&r guards its sheep in a cave by the hills. It grabs players and eats them. Don't get grabbed."
		"Keep your distance and hit it from range."
	]
	quest.79163EC47E17A1A5.title: "The One-Eyed Giant"
	quest.7937796856A16D9A.quest_desc: [
		"Meteorite cores hold &eInscriber Presses&r: logic, calculation, engineering and silicon. Search every meteorite you find; you need all four."
		"An Inscriber can copy a press from an iron block, so one set is enough for the whole party."
	]
	quest.7937796856A16D9A.title: "The Four Presses"
	quest.798B250CF318A486.quest_desc: [
		"A big multicoloured ram wanders the Forest's clearings. Feed it one block of wool of every colour and it rewards you."
		"Optional, and a good excuse to raise sheep."
	]
	quest.798B250CF318A486.title: "The Questing Ram"
	quest.798C7EC882531A15.quest_desc: [
		"Dungeon chests here use &eLootr&r: every player gets their own loot from every chest. Don't race your friends; everyone loots everything."
		"Open ten structure chests. Shared things (a boss drop on the floor, a feast) are yours to split fairly."
	]
	quest.798C7EC882531A15.title: "Share the Spoils"
	quest.79EC1B9BADFDD48C.quest_desc: [
		"Right-click a machine with a &eTier Installer&r and it becomes a &eFactory&r that works on several items at once (three, five, seven, nine as you upgrade)."
		"Speed and Energy Upgrades in its upgrade slot make it faster or cheaper."
	]
	quest.79EC1B9BADFDD48C.title: "Factories"
	quest.79F159C80410A9FF.quest_desc: [
		"You wake in a sun-baked village. On the ridge, a horn sounds: a pillager &cWarband&r is camped there, and the bar at the top of your screen counts down the days."
		""
		"This is your quest book. Open it from the book button in your inventory (or its keybind). Tick the checkmark to begin."
	]
	quest.79F159C80410A9FF.quest_subtitle: "Open your eyes"
	quest.79F159C80410A9FF.title: "The Seventh Dawn"
	quest.79F1CAD28503EC44.quest_desc: [
		"&eDraconium&r ore appears deep in the Overworld, in the Nether and (richest of all) in the End. It drops dust that smelts into ingots."
		"It's the first step of Draconic Evolution, the pack's most powerful tech line."
	]
	quest.79F1CAD28503EC44.title: "Draconium"
	quest.7A667AA0939251B3.quest_desc: [
		"A good adventurer reads the world before it bites."
		""
		"&eJade&r shows what you look at (block, mob, its health, which mod it's from). &eAppleSkin&r shows hunger and saturation. Press &eR/U&r on an item for JEI recipes and uses."
	]
	quest.7A667AA0939251B3.title: "Eyes of the Wise"
	quest.7A9610ECA859C485.quest_desc: [
		"The chief's mask. It lets you call a tribe of your own."
		""
		"Claim the &eSol Visage&r."
	]
	quest.7A9610ECA859C485.title: "Sol Visage"
	quest.7AA95AB5DFAD594C.quest_desc: [
		"The orange ring stayed, and it wants everything."
		""
		"Optional, Orange ring only: learn &eLodestone Pull&r and &eShatterplunder&r (Spectral Hub HUD). Your kills drop more while it's lit."
	]
	quest.7AA95AB5DFAD594C.title: "The Orange Answered"
	quest.7AD58267E56048CC.quest_desc: [
		"The next tier needs a &eDragon Heart&r, and only the Ender Dragon has one. On YUNG's Better End Island you call the dragon at the bell tower."
		"Bring the whole party, and a way back up if the dragon knocks you off the island."
	]
	quest.7AD58267E56048CC.title: "The Dragon's Heart"
	quest.7AE4547152A64F3F.quest_desc: [
		"Little magical &efamiliars&r live all over the world: archmages, clerics, druids, hunters, necromancers, scorchers and more. Right-click one with &eArcane Essence&r to tame it (each try has a 40% chance)."
		"Craft the &eFamiliar Compendium&r (a book and a rabbit's foot) to learn where each lives. Wildheart players: familiars are part of your path."
	]
	quest.7AE4547152A64F3F.quest_subtitle: "Alshanex's Familiars"
	quest.7AE4547152A64F3F.title: "A Familiar of Your Own"
	quest.7B1A78A92A9CF347.quest_desc: [
		"Old miners dug far, and they didn't come back for everything."
		""
		"Find one of the rarer &eYUNG's Better Mineshaft&r styles: dripstone, lush, mushroom, ice, jungle, mesa, red desert or overgrown. Each matches its biome or cave."
	]
	quest.7B1A78A92A9CF347.title: "Deep Veins"
	quest.7C1FF337E551EFCE.quest_desc: [
		"The night belongs to the hunters. Be the worst of them."
		""
		"Kill &e20 zombies&r, &e10 skeletons&r and &e3 phantoms&r. Night kills, sneaking kills and undead kills all give extra Violet XP."
	]
	quest.7C1FF337E551EFCE.title: "Nightwalker"
	quest.7C296E750C89C9AA.quest_desc: [
		"A &eStack Upgrade&r lets every slot hold more than a normal stack. Higher tiers multiply more, all the way to the endgame &eOmega&r tier."
		""
		"A barrel with two Stack Upgrades swallows a whole mining trip."
	]
	quest.7C296E750C89C9AA.title: "Stack It High"
	quest.7C5CF90E8522AB79.quest_desc: [
		"A dragon of pure chaos, wrapped in crystal shields. Its fire ignores armor."
		""
		"Break the &eGuardian Crystals&r first, then kill the &eChaos Guardian&r. Its damage ignores armor and Resistance and it summons withers: bring the whole party, lots of healing, and a way home. Party members nearby get the credit too."
	]
	quest.7C5CF90E8522AB79.quest_subtitle: "The gate"
	quest.7C5CF90E8522AB79.title: "The Chaos Guardian"
	quest.7C71C3F7261E2168.quest_desc: [
		"The savanna around the first village is home to &eelephants&r. Tame one (its dictionary page tells you how) and it will carry you and a chest of cargo."
		"Wildheart players: this is where your beast-taming starts."
	]
	quest.7C71C3F7261E2168.title: "A Friend in the Savanna"
	quest.7C92A749C0D1E699.quest_desc: [
		"The corruption is spreading and the Lantern Corps are watching who rises to meet it. This &aGuides&r tab helps you get ready: one chapter per big mod or system."
		"Each chapter teaches by doing. Finish a quest, claim its reward, and the next ones open. Start anywhere: the chapters run side by side."
		"&eCo-op:&r quests belong to your team, so play them together. This chapter shows how."
	]
	quest.7C92A749C0D1E699.quest_subtitle: "The Guides tab, and how to use it"
	quest.7C92A749C0D1E699.title: "Read Me First"
	quest.7C962F8196C77292.quest_desc: [
		"The yellow ring stayed. The air crackles where you walk."
		""
		"Optional, Yellow ring only: learn &eThunderclap&r and &eStorm Cage&r (Spectral Hub HUD)."
	]
	quest.7C962F8196C77292.title: "The Yellow Answered"
	quest.7CE2218CD9247712.quest_desc: [
		"A voice in the crackle of every fire: &o\"Rage is not weakness. Rage is fuel.\"&r"
		""
		"Reach &eRed level 10&r. Earn Red XP with two-hander kills, Nether kills and bosses."
	]
	quest.7CE2218CD9247712.quest_subtitle: "Class level 10"
	quest.7CE2218CD9247712.title: "The Light Whispers"
	quest.7D5C21FE1EEF54AA.quest_desc: [
		"A prison carved into a glacier, built to hold one man forever. It didn't."
		""
		"Find the &eFrosted Prison&r (L_Ender's Cataclysm) in frozen lands. An &eEye of Curse&r points the way."
	]
	quest.7D5C21FE1EEF54AA.title: "The Frosted Prison"
	quest.7D62C50B862E12BC.quest_desc: [
		"It wears your armor, swings your weapon, casts your spells. It is you, without the light."
		""
		"Optional: in &ethe End&r, place the Shadow Orb on the Shadow Altar. Whoever offers it is copied. Kill the &eDark Doppelganger&r."
	]
	quest.7D62C50B862E12BC.title: "Your Own Shadow"
	quest.7D7F5DCA07945469.quest_desc: [
		"&eDraconic Evolution&r is the pack's extreme tech line, and the Stormwright's last step. It begins with &eDraconium&r: ore deep in the Overworld, in the Nether, and richest in the End."
		"Smelt its dust into ingots. (Draconic is a beta mod here: report anything strange.)"
	]
	quest.7D7F5DCA07945469.quest_subtitle: "Draconic Evolution"
	quest.7D7F5DCA07945469.title: "Draconium"
	quest.7E17017BC2A6E2EF.quest_desc: [
		"Indigo never fights alone: there is always a beast at its side."
		""
		"Optional: tame an animal (a wolf with bones, a cat with fish, a horse by riding it)."
	]
	quest.7E17017BC2A6E2EF.title: "A Taste of Compassion"
	quest.7E90C80B6188C248.quest_desc: [
		"The light murmurs from inside the rock: &o\"All of it. It could all be yours.\"&r"
		""
		"Reach &eOrange level 10&r. Mining ores, opening loot chests and trading for emeralds all count."
	]
	quest.7E90C80B6188C248.quest_subtitle: "Class level 10"
	quest.7E90C80B6188C248.title: "The Light Whispers"
	quest.7E9953BD626315B9.quest_desc: [
		"A ring found you. Blue, White or Black, you are a &eLantern&r now: you can fly, and your will takes shape as constructs."
		""
		"This completes when this light's trial gives you your ring: its own colour, White or Black. The Blue path continues; the &6Last Light&r chapter has opened."
	]
	quest.7E9953BD626315B9.quest_subtitle: "Ring-bearer"
	quest.7E9953BD626315B9.title: "&bRing-Bearer"
	quest.7EC8E525A8B9CFE7.quest_desc: [
		"&eCataclysm&r's bosses live in huge dungeons. In the &eAncient Factory&r, the &eHarbinger&r, a wither-machine of missiles and lasers, waits to be switched on."
		"The Stormwright's trial. Strafe its lasers and shoot down its missiles."
	]
	quest.7EC8E525A8B9CFE7.quest_subtitle: "L_Ender's Cataclysm"
	quest.7EC8E525A8B9CFE7.title: "II. The Harbinger"
	quest.7ECE136659787D3C.quest_desc: [
		"Earn a ring through your class's ring trial. A lit ring lets you &efly&r (double-jump to take off, double-tap forward to shift up a gear, tap back to shift down), forms a hard-light &esuit&r that soaks hits, and keeps you breathing underwater."
		"Its &egrip&r grabs, hurls and pins things, even arrows in flight. Each light has two powers and an ultimate on the power key. Search 'Lantern' in Controls for the keys."
	]
	quest.7ECE136659787D3C.title: "The Ring Chooses"
	quest.7ED03A0759C93A83.quest_desc: [
		"Colder."
		""
		"Craft an &eIce Upgrade Orb&r and apply it at the Arcane Anvil."
	]
	quest.7ED03A0759C93A83.title: "Deep Winter"
	quest.7F0223B6771F924F.quest_desc: [
		"The &eInscriber&r presses materials between presses. It prints circuits (gold, certus, diamond) and silicon, then joins them with redstone into processors."
		"Build one."
	]
	quest.7F0223B6771F924F.title: "The Inscriber"
	quest.7F3FA4F7F33B000A.quest_desc: [
		"Dozens of mods add keys, and some clash. Open &eOptions > Controls > Key Binds&r: &eControlling&r adds a search box and marks conflicts."
		"Search a word like &espell&r, &ebackpack&r, &eroll&r or &eultimine&r to find a mod's keys. Fix the red ones now, before a boss fight finds them for you."
	]
	quest.7F3FA4F7F33B000A.quest_subtitle: "Find and fix keybind clashes"
	quest.7F3FA4F7F33B000A.title: "Too Many Keys"
	quest.7F6D88F816751E8A.quest_desc: [
		"Turn one wheel and the whole world turns with it."
		""
		"Craft &e8 cogwheels&r and &e4 andesite casings&r (Create). Hover any Create item and hold &eW&r to Ponder how it works."
	]
	quest.7F6D88F816751E8A.title: "Cog and Copper"
	quest.7F9A0B2C1844CA8F.quest_desc: [
		"Something raises the dead faster than you can put them down. Find it and break it."
		""
		"Kill the &eSupreme Bonescaller&r (Born in Chaos). It stalks dark nights and cursed ground with an army of skeletons; bring friends to deal with the minions."
	]
	quest.7F9A0B2C1844CA8F.title: "Bonecaller"
	quest.7FBF260747BE587A.quest_desc: [
		"That night a green star falls screaming over the hills and the ground shakes."
		""
		"Follow the smoke to the crashed &aLantern ship&r and reach the wreck."
	]
	quest.7FBF260747BE587A.title: "Fire in the Sky"
	quest.7FEDAD19B0F2B46F.quest_desc: [
		"&eIce and Fire&r fills the world with myths: fire, ice and lightning dragons, hippogryphs, cyclopes, gorgons, sirens, trolls, sea serpents, the Hydra."
		"Craft the &eBestiary&r (see JEI). Its pages fill in as you find manuscripts, and it explains how to fight, tame or hatch each creature."
	]
	quest.7FEDAD19B0F2B46F.quest_subtitle: "Ice and Fire"
	quest.7FEDAD19B0F2B46F.title: "The Bestiary"
}
